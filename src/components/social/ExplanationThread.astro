---
/**
 * WX-302 — hilos por explicación (capa 3 D3)
 * Muestra una explicación + sus hilos de respuesta anidados.
 * Cada hilo = { content, node_hash, vote_count, replies: ThreadNode[] }
 * Botón "Citar" inserta referencia a explicación padre, "Ampliar" añade contexto.
 */
export interface ThreadNode {
  id?: string;
  content: string;
  node_hash: string;
  vote_count: number;
  replies: ThreadNode[];
  created_at?: string;
}

export interface Explanation {
  id: string;
  content: string;
  node_hash: string;
  vote_count: number;
  question_id?: string;
  created_at?: string;
}

interface Props {
  explanation: Explanation;
  threads?: ThreadNode[];
  questionId?: string;
}

const { explanation, threads = [] } = Astro.props as Props;
const expShortHash = explanation.node_hash ? explanation.node_hash.slice(0, 8) + '…' : 'anon';
---

<div class="explanation-thread w-full space-y-4" data-explanation-thread data-explanation-id={explanation.id}>
  <!-- Explicación padre -->
  <article
    class="rounded-xl border border-emerald-500/20 bg-gradient-to-br from-emerald-500/[0.06] to-transparent p-4 space-y-3"
    data-explanation-card
    data-explanation-id={explanation.id}
  >
    <div class="flex items-center justify-between gap-2">
      <span class="inline-flex items-center gap-1.5 text-[10px] font-bold tracking-widest uppercase text-emerald-400/80">
        <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span>
        Explicación
      </span>
      <span class="text-[10px] text-white/30 font-mono" title={explanation.node_hash}>{expShortHash}</span>
    </div>

    <div class="text-sm leading-relaxed text-white/80 whitespace-pre-wrap break-words" data-role="content">{explanation.content}</div>

    <div class="flex items-center justify-between pt-2 border-t border-white/5">
      <div class="flex items-center gap-2 text-xs">
        <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full bg-white/[0.06] border border-white/10 text-white/70" data-testid="vote-count" data-vote-count>
          <span aria-hidden="true">▲</span> {explanation.vote_count}
        </span>
        {explanation.created_at && (
          <span class="text-[10px] text-white/30">{new Date(explanation.created_at).toLocaleDateString()}</span>
        )}
      </div>
      <div class="flex items-center gap-1.5">
        <button
          type="button"
          data-action="cite"
          data-cite-content={explanation.content}
          data-cite-id={explanation.id}
          class="px-3 py-1.5 rounded-lg bg-white/[0.04] hover:bg-emerald-500/20 text-[10px] font-bold uppercase tracking-widest text-white/60 hover:text-emerald-300 border border-white/10 hover:border-emerald-500/30 transition-colors"
          aria-label={`Citar explicación ${explanation.id}`}
        >
          Citar
        </button>
        <button
          type="button"
          data-action="expand"
          class="px-3 py-1.5 rounded-lg bg-white/[0.04] hover:bg-white/[0.08] text-[10px] font-bold uppercase tracking-widest text-white/60 hover:text-white/90 border border-white/10 transition-colors"
          aria-expanded="false"
        >
          Ampliar
        </button>
      </div>
    </div>

    <div class="expand-panel hidden pt-3 mt-2 border-t border-dashed border-white/10 text-xs leading-relaxed text-white/50" data-expand-panel>
      <p>Contexto adicional: esta explicación responde a la pregunta asociada. Usa <em>Citar</em> para referenciarla en tu reply o <em>Ampliar</em> para ver hilos anidados.</p>
    </div>
  </article>

  <!-- Hilos anidados -->
  {threads.length > 0 ? (
    <div class="space-y-3 pl-2 border-l-2 border-white/5 ml-2" data-testid="thread-list" data-thread-list>
      {threads.map((node, idx) => (
        <div class="thread-node space-y-2" data-thread-node data-thread-index={idx}>
          <div class="rounded-lg bg-white/[0.03] border border-white/5 p-3 space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-[10px] font-mono text-white/30" title={node.node_hash}>{node.node_hash ? node.node_hash.slice(0,8) + '…' : 'anon'}</span>
              <span class="inline-flex items-center gap-1 text-[11px] px-2 py-0.5 rounded-full bg-white/[0.06] border border-white/10 text-white/60" data-testid="node-vote">
                ▲ {node.vote_count}
              </span>
            </div>
            <div class="text-sm text-white/75 whitespace-pre-wrap break-words" data-role="node-content">{node.content}</div>
            <div class="flex items-center gap-1.5 justify-end pt-1">
              <button
                type="button"
                data-action="cite"
                data-cite-content={node.content}
                data-cite-id={node.id ?? `thread-${idx}`}
                class="px-2.5 py-1 rounded-md bg-white/[0.04] hover:bg-emerald-500/15 text-[10px] font-bold uppercase tracking-widest text-white/50 hover:text-emerald-300 border border-white/5 transition-colors"
              >
                Citar
              </button>
              <button
                type="button"
                data-action="expand"
                class="px-2.5 py-1 rounded-md bg-white/[0.04] hover:bg-white/[0.08] text-[10px] font-bold uppercase tracking-widest text-white/50 hover:text-white/80 border border-white/5 transition-colors"
                aria-expanded="false"
              >
                Ampliar
              </button>
            </div>
            <div class="expand-panel hidden pt-2 text-xs text-white/40 border-t border-dashed border-white/5" data-expand-panel>
              <p>Reply anidado. Cita para responder en contexto.</p>
            </div>
            {node.replies && node.replies.length > 0 && (
              <div class="mt-3 space-y-2 pl-3 border-l border-white/5 ml-1" data-testid="nested-replies">
                {node.replies.map((rep, rIdx) => (
                  <div class="rounded-md bg-black/20 border border-white/5 p-2.5 space-y-1.5" data-reply-node data-reply-index={rIdx}>
                    <div class="flex items-center justify-between">
                      <span class="text-[10px] font-mono text-white/25" title={rep.node_hash}>{rep.node_hash ? rep.node_hash.slice(0,8)+'…' : 'anon'}</span>
                      <span class="text-[11px] px-1.5 py-0.5 rounded-full bg-white/[0.04] border border-white/10 text-white/50">▲ {rep.vote_count}</span>
                    </div>
                    <div class="text-sm text-white/70 whitespace-pre-wrap break-words">{rep.content}</div>
                    <div class="flex justify-end gap-1">
                      <button type="button" data-action="cite" data-cite-content={rep.content} data-cite-id={rep.id ?? `reply-${rIdx}`} class="px-2 py-1 rounded bg-white/[0.03] text-[10px] uppercase tracking-widest text-white/40 hover:text-emerald-300 border border-white/5">Citar</button>
                      <button type="button" data-action="expand" class="px-2 py-1 rounded bg-white/[0.03] text-[10px] uppercase tracking-widest text-white/40 hover:text-white/70 border border-white/5" aria-expanded="false">Ampliar</button>
                    </div>
                    <div class="expand-panel hidden text-xs text-white/35 pt-1 border-t border-dashed border-white/5" data-expand-panel>Contexto de reply.</div>
                    {rep.replies && rep.replies.length > 0 && (
                      <div class="pl-2 border-l border-white/5 space-y-1 mt-2">
                        {rep.replies.map((deep) => (
                          <div class="text-xs text-white/60 p-2 rounded bg-white/[0.02] border border-white/5">{deep.content} <span class="text-[10px] text-white/20">▲ {deep.vote_count}</span></div>
                        ))}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  ) : (
    <p class="text-xs text-white/25 pl-2" data-testid="no-threads">Sin hilos aún. Sé el primero en responder.</p>
  )}
</div>

<script>
  // Client JS: Citar inserta referencia a textarea + Ampliar toggle
  const root = document.currentScript?.closest('[data-explanation-thread]') as HTMLElement | null;
  // fallback: query all threads on page
  const containers = root ? [root] : Array.from(document.querySelectorAll('[data-explanation-thread]')) as HTMLElement[];

  containers.forEach((container) => {
    container.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const citeBtn = target.closest('[data-action="cite"]') as HTMLElement | null;
      if (citeBtn) {
        const content = citeBtn.getAttribute('data-cite-content') ?? '';
        const id = citeBtn.getAttribute('data-cite-id') ?? '';
        const citeText = `> Cita de ${id.slice(0,8)}: ${content.slice(0,120)}\n\n`;
        // Dispatch global event so ThreadReplyForm can listen
        window.dispatchEvent(new CustomEvent('social:cite', { detail: { content, id, citeText } }));
        // Also try to fill nearest textarea in this thread or comment section
        const scope = container.closest('[data-comment-section]') ?? document;
        const textarea = scope.querySelector('textarea[data-reply-textarea], textarea[name="content"], textarea') as HTMLTextAreaElement | null;
        if (textarea) {
          const start = textarea.selectionStart ?? textarea.value.length;
          const before = textarea.value.slice(0, start);
          const after = textarea.value.slice(start);
          textarea.value = before + citeText + after;
          textarea.focus();
          textarea.dispatchEvent(new Event('input', { bubbles: true }));
        } else {
          // fallback: copy to clipboard
          navigator.clipboard?.writeText(citeText).catch(() => {});
        }
        return;
      }

      const expandBtn = target.closest('[data-action="expand"]') as HTMLElement | null;
      if (expandBtn) {
        const card = expandBtn.closest('[data-explanation-card], [data-thread-node], [data-reply-node], .thread-node') as HTMLElement | null;
        // find expand panel sibling
        let panel: HTMLElement | null = null;
        if (card) {
          panel = card.querySelector('[data-expand-panel]') as HTMLElement | null;
        } else {
          panel = (expandBtn.parentElement?.nextElementSibling as HTMLElement | null);
          if (!panel?.matches('[data-expand-panel]')) panel = expandBtn.closest('div')?.querySelector('[data-expand-panel]') as HTMLElement | null;
        }
        if (panel) {
          const isHidden = panel.classList.contains('hidden');
          panel.classList.toggle('hidden', !isHidden);
          expandBtn.setAttribute('aria-expanded', String(isHidden));
          expandBtn.textContent = isHidden ? 'Ocultar' : 'Ampliar';
        }
        // Also toggle context insertion
        window.dispatchEvent(new CustomEvent('social:expand', { detail: { expanded: !panel?.classList.contains('hidden') } }));
      }
    });
  });
</script>

<style>
  .explanation-thread :global(textarea) { scrollbar-width: thin; }
</style>
