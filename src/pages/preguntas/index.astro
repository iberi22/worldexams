---
export const prerender = true;
import { getCountries, canonicalFor } from './_helpers';

const siteUrl = import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || 'https://saberparatodos.space';
const canonical = canonicalFor('/preguntas/', siteUrl);
const title = 'Preguntas por País — WorldExams';
const description = 'Explora bancos de preguntas por país, asignatura y semana. Contenido alineado a currículos nacionales (DBA, SEP, BNCC, NAP) listo para práctica y simulacros.';
const ogImage = `${siteUrl.replace(/\/$/,'')}/og-image.svg`;

const countries = getCountries();

// Breadcrumbs JSON-LD
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: canonicalFor('/', siteUrl) },
    { '@type': 'ListItem', position: 2, name: 'Preguntas', item: canonical }
  ]
};

const lang = 'es';
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content="es_ES" />
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
</head>
<body class="min-h-screen bg-[#1a1a2e] text-white flex flex-col">
  <header class="border-b border-white/10 bg-[#16213e]/50 backdrop-blur">
    <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
      <a href="/" class="font-bold text-lg tracking-tight">🌎 WorldExams</a>
      <nav class="text-sm text-white/70 flex gap-4">
        <a href="/" class="hover:text-white">Inicio</a>
        <a href="/preguntas/" class="text-white font-semibold">Preguntas</a>
      </nav>
    </div>
  </header>

  <main class="flex-1 max-w-6xl mx-auto px-4 py-10 w-full">
    <!-- Breadcrumbs visible -->
    <nav aria-label="Breadcrumb" class="text-sm text-white/60 mb-6">
      <ol class="flex flex-wrap gap-1.5 items-center">
        <li><a href="/" class="hover:text-white underline-offset-4 hover:underline">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-white">Preguntas</li>
      </ol>
    </nav>

    <div class="mb-8">
      <span class="text-xs font-mono uppercase tracking-widest text-emerald-400">Explorador SEO • Indexable</span>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight mt-2">Preguntas por País</h1>
      <p class="text-white/70 mt-3 max-w-2xl leading-relaxed">{description}</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {countries.map(({ slug, display, count }) => (
        <a href={`/preguntas/${slug}/`} class="group bg-white/5 border border-white/10 hover:border-emerald-500/40 hover:bg-white/[0.07] rounded-2xl p-5 transition flex flex-col gap-3">
          <div class="flex items-center gap-3">
            <span class="text-2xl" aria-hidden="true">{display.flag}</span>
            <h2 class="font-semibold text-lg group-hover:text-emerald-300 transition">{display.name}</h2>
            <span class="ml-auto text-xs font-mono bg-white/10 px-2.5 py-1 rounded-full">{count} bundles</span>
          </div>
          <p class="text-sm text-white/60 leading-relaxed">Banco de preguntas alineado a {display.name} — {display.lang}. Explora por asignatura y semana.</p>
          <span class="text-sm font-medium text-emerald-400 group-hover:text-emerald-300 mt-auto">Ver asignaturas →</span>
        </a>
      ))}
    </div>

    {countries.length === 0 && (
      <div class="bg-amber-900/20 border border-amber-500/30 rounded-xl p-6 text-amber-200">
        No se encontraron países con contenido en <code>questions_data/</code>. Verifica que los bundles existan.
      </div>
    )}

    <section class="mt-10 bg-white/5 border border-white/10 rounded-xl p-6">
      <h2 class="font-semibold mb-2">¿Cómo funciona la jerarquía?</h2>
      <p class="text-sm text-white/70 leading-relaxed">
        Rutas jerárquicas <code class="bg-white/10 px-1.5 py-0.5 rounded text-xs">/preguntas/{'{country}'}/{'{subject}'}/{'{week}'}</code> están pensadas para indexación por motores de búsqueda.
        Cada nivel genera <code>generateStaticPaths</code> en Astro con metadata SEO completa (title, description, canonical, open-graph) y <code>BreadcrumbList</code> de schema.org.
      </p>
    </section>
  </main>

  <footer class="border-t border-white/10 py-6 text-center text-sm text-white/50">
    <div class="max-w-6xl mx-auto px-4">
      <p>© WorldExams • Contenido bajo licencia FREE • <a href="/sitemap-index.xml" class="underline hover:text-white">Sitemap</a></p>
    </div>
  </footer>
</body>
</html>
