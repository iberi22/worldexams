    {
      "id": "CO-ING-6-2026-W05-family-members-001-MASTERY-v6",
      "statement": "\"These are ___ parents: my mother and my father.\"",
      "context": "In Cartagena, a student introduces her family.",
      "options": [
        {
          "letter": "A",
          "text": "my",
          "is_correct": true,
          "feedback": "Correcto. \"My parents\" = mis padres."
        },
        {
          "letter": "B",
          "text": "me",
          "is_correct": false,
          "feedback": "Incorrecto. \"Me\" es pronombre objeto."
        },
        {
          "letter": "C",
          "text": "I",
          "is_correct": false,
          "feedback": "Incorrecto. \"I\" es pronombre sujeto."
        },
        {
          "letter": "D",
          "text": "mine",
          "is_correct": false,
          "feedback": "Incorrecto. \"Mine\" es pronombre posesivo, no adjetivo."
        }
      ],
      "correct_answer": "A",
      "explanation": "\"My\" es un adjetivo posesivo y va siempre antes del sustantivo: my parents, my family, my house. \"Mine\" es pronombre y va solo: \"This is mine.\"\r\n\r\n---",
