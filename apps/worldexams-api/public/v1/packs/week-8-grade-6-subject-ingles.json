    {
      "id": "CO-ING-6-2026-W08-family-possessives-001-MASTERY-v4",
      "statement": "\"My mother's sister is my ___. And her husband is my ___.\"",
      "context": "In Barranquilla, students practice family relationships.",
      "options": [
        {
          "letter": "A",
          "text": "aunt / uncle",
          "is_correct": true,
          "feedback": "Correcto. La hermana de mi mamá es mi tía, su esposo es mi tío."
        },
        {
          "letter": "B",
          "text": "cousin / uncle",
          "is_correct": false,
          "feedback": "Incorrecto. La hermana de mi mamá no es mi prima."
        },
        {
          "letter": "C",
          "text": "aunt / cousin",
          "is_correct": false,
          "feedback": "Incorrecto. El esposo de mi tía es mi tío, no mi primo."
        },
        {
          "letter": "D",
          "text": "grandmother / grandfather",
          "is_correct": false,
          "feedback": "Incorrecto. La hermana no es mi abuela."
        }
      ],
      "correct_answer": "A",
      "explanation": "Mother's sister = aunt, aunt's husband = uncle. In Colombia it's common to call them \"tía\" and \"tío\" even if they're not blood related.\r\n\r\n---",
      "difficulty": "2",
