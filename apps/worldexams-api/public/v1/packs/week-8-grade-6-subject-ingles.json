    {
      "id": "CO-ING-6-2026-W08-family-possessives-001-MASTERY-v2",
      "statement": "\"Your aunt's daughter is your ___.\"",
      "context": "In Medellín, students identify family words.",
      "options": [
        {
          "letter": "A",
          "text": "sister",
          "is_correct": false,
          "feedback": "Incorrecto. Tu hermana es hija de tus padres."
        },
        {
          "letter": "B",
          "text": "niece",
          "is_correct": false,
          "feedback": "Incorrecto. Sobrina es hija de tu hermano."
        },
        {
          "letter": "C",
          "text": "cousin",
          "is_correct": true,
          "feedback": "Correcto. La hija de tu tía es tu prima."
        },
        {
          "letter": "D",
          "text": "grandmother",
          "is_correct": false,
          "feedback": "Incorrecto. Eso sería la abuela."
        }
      ],
      "correct_answer": "C",
      "explanation": "\"Aunt's daughter\" = cousin (prima). \"Uncle's son\" = cousin (primo). Los hijos de los tíos son los primos.\r\n\r\n---",
