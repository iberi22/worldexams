    {
      "id": "CO-ING-6-2026-W08-family-possessives-001-MASTERY-v1",
      "statement": "\"Carlos has a book. It is ___ book.\"",
      "context": "In Bogotá, students learn the possessive 's.",
      "options": [
        {
          "letter": "A",
          "text": "Carlos's",
          "is_correct": true,
          "feedback": "Correcto. \"Carlos's book\" = el libro de Carlos."
        },
        {
          "letter": "B",
          "text": "Carlos book",
          "is_correct": false,
          "feedback": "Incorrecto. Falta el apóstrofe."
        },
        {
          "letter": "C",
          "text": "Carlos'",
          "is_correct": false,
          "feedback": "Posible en algunos estilos, pero \"Carlos's\" es más común y claro."
        },
        {
          "letter": "D",
          "text": "book Carlos",
          "is_correct": false,
          "feedback": "Incorrecto. El orden es incorrecto."
        }
      ],
      "correct_answer": "A",
      "explanation": "El posesivo 's se usa así: nombre + 's + cosa poseída. \"Carlos's book\" = el libro de Carlos. Para nombres que terminan en s, ambas formas son aceptables.\r\n\r\n---",
      "difficulty": "1",
