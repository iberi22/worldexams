        {
          "letter": "B",
          "text": "one thousand",
          "is_correct": false,
          "feedback": "Incorrecto. 1000 = one thousand."
        },
        {
          "letter": "C",
          "text": "one hundred",
          "is_correct": true,
          "feedback": "Correcto. 100 = one hundred."
        },
        {
          "letter": "D",
          "text": "one hundreds",
          "is_correct": false,
          "feedback": "Incorrecto. \"Hundred\" no se pluraliza cuando va con número."
        }
      ],
      "correct_answer": "C",
      "explanation": "100 = one hundred (un/a cien). 200 = two hundred (doscientos). En inglés, \"hundred\" no se pluraliza: two hundred, not \"two hundreds\".\r\n\r\n---",
