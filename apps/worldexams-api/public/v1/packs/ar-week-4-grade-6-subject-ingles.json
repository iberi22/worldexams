      "id": "AR-ING-06-2026-W04-daily-routines-001",
      "statement": "What time is it if the clock says 07:30?",
      "context": "Telling the time on a digital clock.",
      "options": [
        {
          "letter": "A",
          "text": "It is seven o'clock.",
          "is_correct": false,
          "feedback": "Incorrect. That would be 07:00."
        },
        {
          "letter": "B",
          "text": "It is half past seven.",
          "is_correct": true,
          "feedback": "Correct. \"Half past\" indicates 30 minutes after the hour."
        },
        {
          "letter": "C",
          "text": "It is quarter past seven.",
          "is_correct": false,
          "feedback": "Incorrect. That would be 07:15."
        },
        {
          "letter": "D",
          "text": "It is seven forty.",
          "is_correct": false,
          "feedback": "Incorrect."
        }
      ],
      "correct_answer": "B",
      "explanation": "En inglés, para indicar las \"y media\", se utiliza la expresión \"half past\" seguida de la hora.\n\n---",
