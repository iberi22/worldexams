    {
      "id": "CO-ING-6-2026-W29-passive-voice-001-MASTERY-v2",
      "statement": "When do we use passive voice?",
      "context": "In I.E. La Salle de San Andrés, passive use is explained.",
      "options": [
        {
          "letter": "A",
          "text": "To emphasize the subject.",
          "is_correct": false,
          "feedback": "La activa enfatiza el sujeto."
        },
        {
          "letter": "B",
          "text": "When the action is more important than who did it.",
          "is_correct": true,
          "feedback": "Correcto. O cuando no sabemos quién lo hizo."
        },
        {
          "letter": "C",
          "text": "Only in questions.",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "D",
          "text": "Only in present tense.",
          "is_correct": false,
          "feedback": "Incorrecto."
        }
      ],
      "correct_answer": "B",
      "explanation": "Pasiva se usa cuando: (1) el agente es obvio/desconocido: \"My phone was stolen.\" (2) queremos enfatizar el objeto.\r\n\r\n---",
      "difficulty": "3",
      "images": [],
      "tags": [],
