    {
      "id": "CO-ING-6-2026-W29-passive-voice-001-MASTERY-v1",
      "statement": "What is the structure of passive voice?",
      "context": "At Colegio Fontán de Pasto, teacher introduces passive.",
      "options": [
        {
          "letter": "A",
          "text": "subject + verb + object",
          "is_correct": false,
          "feedback": "Es activa."
        },
        {
          "letter": "B",
          "text": "subject + have + past participle",
          "is_correct": false,
          "feedback": "Es present perfect."
        },
        {
          "letter": "C",
          "text": "subject + be + past participle",
          "is_correct": true,
          "feedback": "Correcto. Pasiva = verbo to be + past participle."
        },
        {
          "letter": "D",
          "text": "subject + will + verb",
          "is_correct": false,
          "feedback": "Es futuro simple."
        }
      ],
      "correct_answer": "C",
      "explanation": "Voz pasiva: sujeto + be (conjugado) + past participle + (by + agente). \"The letter is written by Maria.\"\r\n\r\n---",
      "difficulty": "3",
      "images": [],
      "tags": [],
      "bloom": "Remember",
