    {
      "id": "AR-MAT-11-2026-W13-funciones-cuadraticas-001-MASTERY-bundle-v4",
      "statement": "Dada f(x) = x² - 3x + 2, ¿cuánto vale f(4)?",
      "context": "",
      "options": [
        {
          "letter": "A",
          "text": "4",
          "is_correct": false,
          "feedback": "Incorrecto. 4² - 3·4 + 2 = 16 - 12 + 2 = 6."
        },
        {
          "letter": "B",
          "text": "5",
          "is_correct": false,
          "feedback": "Incorrecto. 16 - 12 + 2 = 6."
        },
        {
          "letter": "C",
          "text": "6",
          "is_correct": true,
          "feedback": "Correcto. f(4) = 16 - 12 + 2 = 6."
        },
        {
          "letter": "D",
          "text": "-2",
          "is_correct": false,
          "feedback": "Incorrecto. 16 - 12 + 2 = 6, no -2."
        }
      ],
      "correct_answer": "C",
      "explanation": "Para evaluar f(4), reemplazamos x = 4 en la expresión: f(4) = (4)² - 3(4) + 2 = 16 - 12 + 2 = 6.\n\n---",
      "difficulty": "4",
      "images": [],
      "tags": [],
      "bundle_id": "AR-MAT-11-2026-W13-funciones-cuadraticas-001-MASTERY-bundle",
      "periodo": 13,
