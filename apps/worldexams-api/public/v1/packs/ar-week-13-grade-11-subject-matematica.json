      "cefr_level": null
    },
    {
      "id": "AR-MAT-11-2026-W13-funciones-cuadraticas-001-MASTERY-bundle-v5",
      "statement": "Las raíces de la ecuación x² - 5x + 6 = 0 son:",
      "context": "",
      "options": [
        {
          "letter": "A",
          "text": "x = 2 y x = 3",
          "is_correct": true,
          "feedback": "Correcto. (x - 2)(x - 3) = 0."
        },
        {
          "letter": "B",
          "text": "x = -2 y x = -3",
          "is_correct": false,
          "feedback": "Incorrecto. Si se reemplazan: 4 + 10 + 6 ≠ 0."
        },
        {
          "letter": "C",
          "text": "x = 1 y x = 6",
          "is_correct": false,
          "feedback": "Incorrecto. 1 - 5 + 6 = 2, no es cero."
        },
        {
          "letter": "D",
          "text": "x = 5 y x = -5",
          "is_correct": false,
          "feedback": "Incorrecto. No son raíces."
        }
      ],
      "correct_answer": "A",
      "explanation": "Usando la fórmula resolvente: x = [5 ± √(25 - 24)]/2 = (5 ± 1)/2. Las raíces son x = 6/2 = 3 y x = 4/2 = 2.\n\n---",
      "difficulty": "6",
      "images": [],
      "tags": [],
