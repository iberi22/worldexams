      "cefr_level": null
    },
    {
      "id": "AR-MAT-11-2026-W13-funciones-cuadraticas-001-MASTERY-bundle-v6",
      "statement": "Si el discriminante Δ = b² - 4ac de una ecuación cuadrática es NEGATIVO, la ecuación tiene:",
      "context": "",
      "options": [
        {
          "letter": "A",
          "text": "Dos raíces reales distintas",
          "is_correct": false,
          "feedback": "Incorrecto. Eso ocurre cuando Δ > 0."
        },
        {
          "letter": "B",
          "text": "Una raíz real (doble)",
          "is_correct": false,
          "feedback": "Incorrecto. Eso ocurre cuando Δ = 0."
        },
        {
          "letter": "C",
          "text": "Dos raíces complejas conjugadas",
          "is_correct": true,
          "feedback": "Correcto. Δ < 0 implica raíces complejas no reales."
        },
        {
          "letter": "D",
          "text": "Infinitas soluciones",
          "is_correct": false,
          "feedback": "Incorrecto. Una cuadrática tiene como máximo dos raíces."
        }
      ],
      "correct_answer": "C",
      "explanation": "El discriminante Δ determina la naturaleza de las raíces. Si Δ < 0, la ecuación cuadrática no tiene raíces reales, sino dos raíces complejas conjugadas (con parte imaginaria no nula).\n\n---",
      "difficulty": "6",
      "images": [],
      "tags": [],
