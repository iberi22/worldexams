    {
      "id": "CO-SOC-5-2026-W28-frente-nacional-001-MASTERY-v2",
      "statement": "Por que se creo el Frente Nacional?",
      "context": "Contexto colombiano",
      "options": [
        {
          "letter": "A",
          "text": "Para iniciar una guerra",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "B",
          "text": "Para poner fin a la violencia bipartidista y restaurar la democracia tras la dictadura de Rojas Pinilla",
          "is_correct": true,
          "feedback": "Correcto."
        },
        {
          "letter": "C",
          "text": "Para unir Colombia con Venezuela",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "D",
          "text": "Para instaurar una monarquia",
          "is_correct": false,
          "feedback": "Incorrecto."
        }
      ],
      "correct_answer": "B",
      "explanation": "Tras la dictadura militar de Gustavo Rojas Pinilla (1953-1957) y decadas de violencia, los partidos Liberal y Conservador acordaron alternarse el poder para pacificar el pais.\r\n\r\n---",
