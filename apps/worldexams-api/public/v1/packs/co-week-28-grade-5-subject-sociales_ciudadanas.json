    {
      "id": "CO-SOC-5-2026-W28-frente-nacional-001-MASTERY-v4",
      "statement": "Como funcionaba la alternacion del Frente Nacional?",
      "context": "Contexto colombiano",
      "options": [
        {
          "letter": "A",
          "text": "Cada partido gobernaba 8 anos",
          "is_correct": true,
          "feedback": "Correcto. 4 periodos de 4 anos alternados."
        },
        {
          "letter": "B",
          "text": "Gobernaba el que ganara las elecciones libremente",
          "is_correct": false,
          "feedback": "Incorrecto. Estaba pactado."
        },
        {
          "letter": "C",
          "text": "Gobernaba siempre el mismo partido",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "D",
          "text": "No habia gobierno",
          "is_correct": false,
          "feedback": "Incorrecto."
        }
      ],
      "correct_answer": "A",
      "explanation": "El Frente Nacional duro 16 anos (4 periodos): 1958-1962 Liberal (Lleras), 1962-1966 Conservador (Valencia), 1966-1970 Liberal (Lleras Restrepo), 1970-1974 Conservador (Pastrana).\r\n\r\n---",
