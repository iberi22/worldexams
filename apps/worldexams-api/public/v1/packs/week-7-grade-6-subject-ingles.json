    {
      "id": "CO-ING-6-2026-W07-describing-people-001-MASTERY-v1",
      "statement": "\"Tall\" means ___ in Spanish.",
      "context": "In Bogotá, students learn adjectives for physical description.",
      "options": [
        {
          "letter": "A",
          "text": "Bajo",
          "is_correct": false,
          "feedback": "Incorrecto. \"Bajo\" es \"short\"."
        },
        {
          "letter": "B",
          "text": "Alto",
          "is_correct": true,
          "feedback": "Correcto. \"Tall\" = alto."
        },
        {
          "letter": "C",
          "text": "Delgado",
          "is_correct": false,
          "feedback": "Incorrecto. \"Delgado\" es \"thin\" o \"slim\"."
        },
        {
          "letter": "D",
          "text": "Gordo",
          "is_correct": false,
          "feedback": "Incorrecto. \"Gordo\" es \"fat\"."
        }
      ],
      "correct_answer": "B",
      "explanation": "\"Tall\" = alto/a. Opuestos: tall (alto) ↔ short (bajo), thin/fat (delgado/gordo), young (joven) ↔ old (viejo).\r\n\r\n---",
