    {
      "id": "CO-ING-6-2026-W07-describing-people-001-MASTERY-v6",
      "statement": "\"I ___ short and I ___ curly hair.\"",
      "context": "In Cartagena, a student describes herself.",
      "options": [
        {
          "letter": "A",
          "text": "am / have",
          "is_correct": true,
          "feedback": "Correcto. \"I am short\" (ser), \"I have curly hair\" (tener)."
        },
        {
          "letter": "B",
          "text": "have / am",
          "is_correct": false,
          "feedback": "Incorrecto. Orden incorrecto de verbos."
        },
        {
          "letter": "C",
          "text": "am / am",
          "is_correct": false,
          "feedback": "Incorrecto. \"I am curly hair\" no tiene sentido."
        },
        {
