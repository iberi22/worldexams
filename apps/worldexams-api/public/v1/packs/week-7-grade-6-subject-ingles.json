    {
      "id": "CO-ING-6-2026-W07-describing-people-001-MASTERY-v5",
      "statement": "\"My eyes ___ brown.\"",
      "context": "In Bucaramanga, students use \"be\" for description.",
      "options": [
        {
          "letter": "A",
          "text": "is",
          "is_correct": false,
          "feedback": "Incorrecto. \"Eyes\" es plural."
        },
        {
          "letter": "B",
          "text": "are",
          "is_correct": true,
          "feedback": "Correcto. \"Eyes\" = plural → are."
        },
        {
          "letter": "C",
          "text": "am",
          "is_correct": false,
          "feedback": "Incorrecto. \"Am\" solo con I."
        },
        {
          "letter": "D",
          "text": "have",
          "is_correct": false,
          "feedback": "Incorrecto. \"Have\" no se usa con color de ojos de esa forma."
        }
      ],
      "correct_answer": "B",
      "explanation": "Para describir con el verbo \"to be\": \"My eyes are brown\" = Mis ojos son marrones. Para describir con \"have\": \"I have brown eyes\".\r\n\r\n---",
