    {
      "id": "CO-ING-6-2026-W07-describing-people-001-MASTERY-v3",
      "statement": "\"She ___ long, straight hair.\"",
      "context": "In Cali, students describe hair and eyes.",
      "options": [
        {
          "letter": "A",
          "text": "have",
          "is_correct": false,
          "feedback": "Incorrecto. \"Have\" con she no es correcto."
        },
        {
          "letter": "B",
          "text": "has",
          "is_correct": true,
          "feedback": "Correcto. \"She has\" = ella tiene."
        },
        {
          "letter": "C",
          "text": "is",
          "is_correct": false,
          "feedback": "Incorrecto. \"Is\" no indica posesión de cabello."
        },
        {
          "letter": "D",
          "text": "are",
          "is_correct": false,
          "feedback": "Incorrecto. No funciona aquí."
        }
      ],
      "correct_answer": "B",
      "explanation": "Para describir características físicas usamos \"have/has\": I have, you have, he/she has, we have, they have.\r\n\r\n---",
      "difficulty": "2",
