        {
          "letter": "B",
          "text": "for",
          "is_correct": false,
          "feedback": "Incorrecto. \"Look for\" = buscar."
        },
        {
          "letter": "C",
          "text": "like",
          "is_correct": true,
          "feedback": "Correcto. \"Look like\" = cómo se ve, aspecto físico."
