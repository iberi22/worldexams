    },
    {
      "id": "CO-LEN-8-2026-W36-poesia-hispanoamericana-001-MASTERY-v3",
      "statement": "Lee estos versos: *\"Hay golpes en la vida, tan fuertes... ¡Yo no sé! / Golpes como del odio de Dios\"*. ¿A qué autor pertenecen y qué sentimiento expresan?",
      "context": "",
      "options": [
        {
          "letter": "A",
          "text": "Rubén Darío - Alegría por la naturaleza.",
          "is_correct": false,
          "feedback": "El tono es de dolor y desconcierto existencial."
        },
        {
          "letter": "B",
          "text": "César Vallejo - Dolor profundo y existencialismo.",
          "is_correct": true,
          "feedback": "Correcto. Son los versos iniciales de 'Los heraldos negros'."
        },
        {
          "letter": "C",
          "text": "Pablo Neruda - Amor romántico apasionado.",
          "is_correct": false,
          "feedback": "El tema es el sufrimiento humano, no el amor romántico."
        },
        {
          "letter": "D",
          "text": "Gabriela Mistral - Maternidad y ternura.",
          "is_correct": false,
          "feedback": "Vallejo expresa una angustia humana universal en estos versos."
        }
      ],
      "correct_answer": "B",
      "explanation": "Vallejo es el poeta de la orfandad y el dolor humano, usando un lenguaje que rompe las reglas tradicionales.\n\n---",
      "difficulty": "6",
      "images": [],
      "tags": [],
