    {
      "id": "CO-LEN-8-2026-W36-poesia-hispanoamericana-001-MASTERY-v1",
      "statement": "¿Cuál es la obra fundacional del Modernismo, publicada por Rubén Darío en 1888?",
      "context": "",
      "options": [
        {
          "letter": "A",
          "text": "'Residencia en la tierra'.",
          "is_correct": false,
          "feedback": "Obra fundamental de Pablo Neruda."
        },
        {
          "letter": "B",
          "text": "'Azul...'.",
          "is_correct": true,
          "feedback": "Correcto. Libro de poemas y cuentos que inició la renovación modernista."
        },
        {
          "letter": "C",
          "text": "'Trilce'.",
          "is_correct": false,
          "feedback": "Obra vanguardista de César Vallejo."
        },
        {
          "letter": "D",
          "text": "'Los heraldos negros'.",
          "is_correct": false,
          "feedback": "Obra temprana de César Vallejo."
        }
      ],
      "correct_answer": "B",
      "explanation": "'Azul...' de Rubén Darío introdujo temas exóticos, un lenguaje musical y una nueva sensibilidad en las letras hispanas.\n\n---",
