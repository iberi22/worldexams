    {
      "id": "CO-LEN-8-2026-W36-poesia-hispanoamericana-001-MASTERY-v2",
      "statement": "¿Qué es una **metáfora** en el análisis poético?",
      "context": "",
      "options": [
        {
          "letter": "A",
          "text": "Una comparación que usa siempre la palabra \"como\".",
          "is_correct": false,
          "feedback": "Esto es un símil o comparación explícita."
        },
        {
          "letter": "B",
          "text": "Identificar un término real con uno imaginario por su semejanza, sin usar \"como\".",
          "is_correct": true,
          "feedback": "Correcto. Ej: \"Las perlas de tu boca\" por los dientes."
        },
        {
          "letter": "C",
          "text": "Repetir el mismo sonido al principio de cada verso.",
          "is_correct": false,
          "feedback": "Esto se llama aliteración."
        },
        {
          "letter": "D",
          "text": "Escribir poemas que tienen forma de dibujo.",
          "is_correct": false,
          "feedback": "Esto se conoce como caligrama."
        }
      ],
      "correct_answer": "B",
      "explanation": "La metáfora es la figura reina de la poesía, permitiendo crear nuevas realidades a través de la asociación de ideas.\n\n---",
      "difficulty": "4",
      "images": [],
      "tags": [],
      "bloom": "Understand",
      "icfes_type": "Comprensión Lectora",
      "expected_success": 0.82,
      "bundle_id": "CO-LEN-8-2026-W36-poesia-hispanoamericana-001-MASTERY-bundle",
      "periodo": 36,
      "protocol_version": "5.2",
