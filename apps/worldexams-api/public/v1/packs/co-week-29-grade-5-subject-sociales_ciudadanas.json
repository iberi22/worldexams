      "id": "CO-SOC-5-2026-W29-colombia-contemporanea-001-MASTERY-v1",
      "statement": "Que conflicto interno ha vivido Colombia desde mediados del siglo XX?",
      "context": "Contexto colombiano",
      "options": [
        {
          "letter": "A",
          "text": "Una invasion extranjera",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "B",
          "text": "Un conflicto armado interno con guerrillas, paramilitares y narcotrafico",
          "is_correct": true,
          "feedback": "Correcto."
        },
        {
          "letter": "C",
          "text": "Una guerra mundial",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "D",
          "text": "Una monarquia",
          "is_correct": false,
          "feedback": "Incorrecto."
        }
      ],
      "correct_answer": "B",
      "explanation": "Colombia ha vivido un conflicto armado interno de mas de 50 anos que ha involucrado guerrillas (FARC, ELN), paramilitares, fuerzas del Estado y el narcotrafico.\r\n\r\n---",
