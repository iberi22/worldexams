    {
      "id": "AR-ING-06-2026-W04-daily-routines-005",
      "statement": "Where does an adverb of frequency (like \"always\") go with the verb \"to be\"?",
      "context": "",
      "options": [
        {
          "letter": "A",
          "text": "Before the verb \"to be\".",
          "is_correct": false,
          "feedback": "Incorrect."
        },
        {
          "letter": "B",
          "text": "After the verb \"to be\".",
          "is_correct": true,
          "feedback": "Correct. Example: \"I am always happy.\""
        },
        {
          "letter": "C",
          "text": "At the end of the sentence.",
          "is_correct": false,
          "feedback": "Incorrect."
        },
