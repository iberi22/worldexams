      "id": "CO-SOC-5-2026-W08-climas-pisos-termicos-001-MASTERY-v2",
      "statement": "Que es un piso termico?",
      "context": "Contexto colombiano",
      "options": [
        {
          "letter": "A",
          "text": "Un tipo de clima caliente",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "B",
          "text": "Una zona climatica determinada por la altitud",
          "is_correct": true,
          "feedback": "Correcto."
        },
        {
          "letter": "C",
          "text": "Un rio caliente",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "D",
          "text": "Una montana",
          "is_correct": false,
          "feedback": "Incorrecto."
        }
      ],
      "correct_answer": "B",
      "explanation": "Los pisos termicos son franjas climaticas que cambian con la altitud. Al subir una montana, la temperatura baja. En Colombia hay 5 pisos: calido, templado, frio, paramo y nieves perpetuas.\r\n\r\n---",
