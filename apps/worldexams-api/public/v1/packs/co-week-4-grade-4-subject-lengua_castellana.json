    {
      "id": "CO-LEN-4-2026-W04-gramatica-verbos-001-MASTERY-v6",
      "statement": "\"Ayer **comí** fruta\" / \"Antes **comía** mucha fruta\". ¿Cuál es la diferencia entre los dos verbos en pasado?",
      "context": "",
      "options": [
        {
          "letter": "A",
          "text": "No hay ninguna diferencia, significan lo mismo.",
          "is_correct": false,
          "feedback": ""
        },
        {
          "letter": "B",
          "text": "\"Comí\" indica una acción terminada en un momento exacto; \"comía\" indica una acción que se repetía en el pasado.",
          "is_correct": true,
          "feedback": ""
        },
        {
          "letter": "C",
          "text": "\"Comí\" es para el futuro y \"comía\" para el presente.",
          "is_correct": false,
          "feedback": ""
        },
        {
          "letter": "D",
          "text": "\"Comí\" es más elegante que \"comía\".",
          "is_correct": false,
          "feedback": ""
        }
      ],
      "correct_answer": "B",
      "explanation": "El español tiene varios tiempos para el pasado que permiten precisar si la acción fue única o habitual.\n\n---",
      "difficulty": "6",
