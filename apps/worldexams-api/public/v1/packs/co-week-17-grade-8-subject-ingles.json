    {
      "id": "CO-ING-8-2026-W17-phrasal-verbs-001-MASTERY-v9",
      "statement": "Which sentence is correct?",
      "context": "Separable phrasal verbs.",
      "options": [
        {
          "letter": "A",
          "text": "Please turn off it.",
          "is_correct": false,
          "feedback": "Incorrect. With pronouns, they must go in the middle of separable phrasal verbs."
        },
        {
          "letter": "B",
          "text": "Please turn it off.",
          "is_correct": true,
          "feedback": "Correct! If the object is a pronoun (it, them), it must go between the verb and the particle."
        },
        {
          "letter": "C",
          "text": "Please turning off it.",
          "is_correct": false,
          "feedback": "Incorrect."
