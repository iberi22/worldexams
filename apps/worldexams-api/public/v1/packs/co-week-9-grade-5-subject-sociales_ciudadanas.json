          "text": "Las llanuras",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "B",
          "text": "Las tres cordilleras, valles interandinos y la mayoria de la poblacion",
          "is_correct": true,
          "feedback": "Correcto."
        },
        {
          "letter": "C",
          "text": "La selva amazonica",
