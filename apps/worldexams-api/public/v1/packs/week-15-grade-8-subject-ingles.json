    {
      "id": "CO-ING-8-2026-W15-review-p3-001-MASTERY-v2",
      "statement": "**Direct Speech:** \"I am working,\" said Carlos.\r\n**Reported Speech:** Carlos said that he ________ working.",
      "context": "Reviewing Reported Speech.",
      "options": [
        {
          "letter": "A",
          "text": "is",
          "is_correct": false,
          "feedback": "Incorrect."
        },
        {
          "letter": "B",
          "text": "was",
          "is_correct": true,
          "feedback": "Correct! Present continuous shifts to past continuous in reported speech."
        },
        {
          "letter": "C",
          "text": "were",
          "is_correct": false,
          "feedback": "Incorrect. \"He\" takes \"was\"."
        },
        {
          "letter": "D",
          "text": "been",
          "is_correct": false,
          "feedback": "Incorrect."
        }
      ],
      "correct_answer": "B",
      "explanation": "En el estilo indirecto, los tiempos verbales retroceden un paso. El presente continuo se convierte en pasado continuo.\r\n\r\n---",
