    },
    {
      "id": "BR-MAT-3EM-2026-W22-probabilidade-condicional-001-MASTERY-bundle-v5",
      "statement": "Qual é a probabilidade de o paciente realmente ter a doença, dado que testou positivo?",
      "context": "",
      "options": [
        {
          "letter": "A",
          "text": "95%",
          "is_correct": false,
          "feedback": "Incorreto. Esta é a sensibilidade do teste, não o valor preditivo positivo."
        },
        {
          "letter": "B",
          "text": "90%",
          "is_correct": false,
          "feedback": "Incorreto. Esta é a especificidade do teste."
        },
        {
          "letter": "C",
          "text": "Aproximadamente 19,6%",
          "is_correct": true,
          "feedback": "Correto. P(D|+) = (0,02 × 0,95) / 0,097 = 0,019/0,097 ≈ 0,196."
        },
        {
          "letter": "D",
          "text": "2%",
          "is_correct": false,
          "feedback": "Incorreto. Esta é a prevalência da doença na população."
        }
      ],
      "correct_answer": "C",
      "explanation": "Pelo Teorema de Bayes: $P(D|+) = \\frac{P(D) \\cdot P(+|D)}{P(+)} = \\frac{0,02 \\times 0,95}{0,097} = \\frac{0,019}{0,097} \\approx 0,196 = 19,6\\%$.\r\n\r\n---",
      "difficulty": "6",
