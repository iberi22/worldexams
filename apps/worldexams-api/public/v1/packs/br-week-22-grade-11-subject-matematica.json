    {
      "id": "BR-MAT-3EM-2026-W22-probabilidade-condicional-001-MASTERY-bundle-v1",
      "statement": "Qual é a probabilidade de um aluno tocar instrumento, sabendo que ele pratica esportes?",
      "context": "",
      "options": [
        {
          "letter": "A",
          "text": "25%",
          "is_correct": false,
          "feedback": "Incorreto. Este é o percentual de alunos que fazem ambas as atividades."
        },
        {
          "letter": "B",
          "text": "40%",
          "is_correct": false,
          "feedback": "Incorreto. Esta é a probabilidade incondicional de tocar instrumento."
        },
        {
          "letter": "C",
          "text": "41,67%",
          "is_correct": true,
          "feedback": "Correto. P(Instrumento | Esportes) = 25%/60% = 5/12 ≈ 41,67%."
        },
        {
          "letter": "D",
          "text": "60%",
          "is_correct": false,
          "feedback": "Incorreto. Esta seria P(Esportes), não a condicional solicitada."
        }
      ],
      "correct_answer": "C",
      "explanation": "$P(\\text{Inst} \\mid \\text{Esp}) = \\frac{P(\\text{Inst} \\cap \\text{Esp})}{P(\\text{Esp})} = \\frac{0,25}{0,60} = \\frac{5}{12} \\approx 0,4167$.\r\n\r\n---",
