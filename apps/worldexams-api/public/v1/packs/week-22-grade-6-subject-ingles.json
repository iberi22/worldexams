    {
      "id": "CO-ING-6-2026-W22-passive-voice-001-MASTERY-v1",
      "statement": "What is the structure of passive voice?",
      "context": "At I.E. La Salle de Ibagué, teacher introduces passive.",
      "options": [
        {
          "letter": "A",
          "text": "subject + verb + object",
          "is_correct": false,
          "feedback": "Es activa."
        },
        {
          "letter": "B",
          "text": "subject + have + past participle",
          "is_correct": false,
          "feedback": "Es present perfect."
        },
        {
          "letter": "C",
          "text": "subject + be + past participle",
          "is_correct": true,
          "feedback": "Correcto. Pasiva = verbo to be + past participle."
        },
