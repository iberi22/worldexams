    {
      "id": "CO-SOC-5-2026-W18-sociedad-colonial-001-MASTERY-v2",
      "statement": "Quienes eran los 'criollos' en la sociedad colonial?",
      "context": "Contexto colombiano",
      "options": [
        {
          "letter": "A",
          "text": "Espanoles nacidos en Espana",
          "is_correct": false,
          "feedback": "Incorrecto. Esos eran peninsulares."
        },
        {
          "letter": "B",
          "text": "Hijos de espanoles nacidos en America",
          "is_correct": true,
          "feedback": "Correcto."
        },
        {
          "letter": "C",
          "text": "Indigenas convertidos al cristianismo",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "D",
          "text": "Esclavos africanos",
          "is_correct": false,
          "feedback": "Incorrecto."
        }
      ],
      "correct_answer": "B",
      "explanation": "Los criollos eran descendientes de espanoles nacidos en America. Eran ricos y educados, pero no podian ocupar los altos cargos del gobierno, reservados a peninsulares.\r\n\r\n---",
