      "id": "CO-SOC-5-2026-W18-sociedad-colonial-001-MASTERY-v1",
      "statement": "Como se llamaba la mezcla de espanol e indigena?",
      "context": "Contexto colombiano",
      "options": [
        {
          "letter": "A",
          "text": "Mulato",
          "is_correct": false,
          "feedback": "Incorrecto. Mulato es espanol con africano."
        },
        {
          "letter": "B",
          "text": "Mestizo",
          "is_correct": true,
          "feedback": "Correcto. Mestizo es hijo de espanol e indigena."
        },
        {
          "letter": "C",
          "text": "Zambo",
          "is_correct": false,
          "feedback": "Incorrecto. Zambo es indigena con africano."
        },
        {
          "letter": "D",
          "text": "Criollo",
          "is_correct": false,
          "feedback": "Incorrecto. Criollo es espanol nacido en America."
        }
      ],
      "correct_answer": "B",
      "explanation": "El mestizaje fue un fenomeno central de la Colonia. Mestizo = espanol + indigena. Mulato = espanol + africano. Zambo = indigena + africano.\r\n\r\n---",
