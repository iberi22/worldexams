          "text": "subject + will + verb",
          "is_correct": false,
          "feedback": "Es futuro simple."
        }
      ],
      "correct_answer": "C",
      "explanation": "Voz pasiva: sujeto + be (conjugado) + past participle + (by + agente). \"The letter is written by Maria.\"\r\n\r\n---",
