      "id": "CO-ING-6-2026-W26-passive-voice-001-MASTERY-v1",
      "statement": "What is the structure of passive voice?",
      "context": "At Colegio Cambridge de Manizales, teacher introduces passive.",
      "options": [
        {
          "letter": "A",
          "text": "subject + verb + object",
          "is_correct": false,
          "feedback": "Es activa."
