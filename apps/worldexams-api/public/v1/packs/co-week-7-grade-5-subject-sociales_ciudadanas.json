    {
      "id": "CO-SOC-5-2026-W07-hidrografia-colombia-001-MASTERY-v5",
      "statement": "Que es una cuenca hidrografica?",
      "context": "Contexto colombiano",
      "options": [
        {
          "letter": "A",
          "text": "Un recipiente para el agua",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "B",
          "text": "El territorio drenado por un rio principal y sus afluentes",
          "is_correct": true,
          "feedback": "Correcto."
        },
        {
          "letter": "C",
          "text": "Una montana",
          "is_correct": false,
          "feedback": "Incorrecto."
