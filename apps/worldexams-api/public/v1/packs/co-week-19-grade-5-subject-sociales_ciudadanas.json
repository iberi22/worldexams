    {
      "id": "CO-SOC-5-2026-W19-economia-colonial-001-MASTERY-v1",
      "statement": "Cual fue la principal actividad economica del Virreinato de Nueva Granada?",
      "context": "Contexto colombiano",
      "options": [
        {
          "letter": "A",
          "text": "La industria textil",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "B",
          "text": "La mineria de oro",
          "is_correct": true,
          "feedback": "Correcto. La mineria fue la base de la economia colonial."
        },
        {
          "letter": "C",
          "text": "La pesca",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "D",
          "text": "La fabricacion de automoviles",
          "is_correct": false,
          "feedback": "Incorrecto."
        }
      ],
      "correct_answer": "B",
      "explanation": "La mineria de oro fue la actividad mas importante. Las minas de Antioquia, Choco, Cauca y Tolima producian oro que se enviaba a Espana.\r\n\r\n---",
