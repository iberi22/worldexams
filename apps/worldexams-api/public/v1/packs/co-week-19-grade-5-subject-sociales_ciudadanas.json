    {
      "id": "CO-SOC-5-2026-W19-economia-colonial-001-MASTERY-v3",
      "statement": "Que productos agricolas cultivaban los espanoles en el Nuevo Reino?",
      "context": "Contexto colombiano",
      "options": [
        {
          "letter": "A",
          "text": "Trigo, cebada y vid",
          "is_correct": true,
          "feedback": "Correcto. Introdujeron cultivos europeos."
        },
        {
          "letter": "B",
          "text": "Maiz, papa y yuca (cultivos nativos)",
          "is_correct": false,
          "feedback": "Incorrecto. Esos ya eran cultivados por indigenas."
        },
        {
          "letter": "C",
          "text": "Arroz y soya",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "D",
          "text": "Cafe y platano",
          "is_correct": false,
          "feedback": "Incorrecto. Se introdujeron despues."
        }
      ],
      "correct_answer": "A",
      "explanation": "Los espanoles introdujeron cultivos europeos como trigo, cebada, vid (uva), olivo, caña de azucar y frutales. Tambien trajeron animales como vacas, caballos, ovejas y cerdos.\r\n\r\n---",
