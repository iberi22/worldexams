      "id": "CO-SOC-5-2026-W19-economia-colonial-001-MASTERY-v2",
      "statement": "Que era la 'mita'?",
      "context": "Contexto colombiano",
      "options": [
        {
          "letter": "A",
          "text": "Un impuesto en moneda",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "B",
          "text": "Un sistema de trabajo obligatorio para los indigenas",
          "is_correct": true,
          "feedback": "Correcto."
        },
        {
          "letter": "C",
          "text": "Un tipo de cultivo",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "D",
          "text": "Un baile tipico",
          "is_correct": false,
          "feedback": "Incorrecto."
        }
      ],
      "correct_answer": "B",
      "explanation": "La mita era un sistema de trabajo obligatorio por turnos. Los indigenas debian trabajar temporalmente en minas, obrajes o construcciones publicas.\r\n\r\n---",
