    {
      "id": "CO-SOC-5-2026-W19-economia-colonial-001-MASTERY-v4",
      "statement": "Que era el 'comercio triangular'?",
      "context": "Contexto colombiano",
      "options": [
        {
          "letter": "A",
          "text": "Comercio entre tres ciudades colombianas",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "B",
          "text": "Ruta comercial entre Europa, Africa y America",
          "is_correct": true,
          "feedback": "Correcto. Europa enviaba mercancias a Africa por esclavos, y estos iban a America por oro y materias primas."
        },
        {
          "letter": "C",
          "text": "Comercio entre virreinatos",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "D",
          "text": "Trueque entre indigenas",
          "is_correct": false,
          "feedback": "Incorrecto."
        }
      ],
      "correct_answer": "B",
      "explanation": "El comercio triangular conectaba Europa (manufacturas), Africa (esclavos) y America (oro, plata, azucar). Fue la base del comercio colonial.\r\n\r\n---",
