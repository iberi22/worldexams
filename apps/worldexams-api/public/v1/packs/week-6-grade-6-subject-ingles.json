    {
      "id": "CO-ING-6-2026-W06-possessive-adjectives-001-MASTERY-v1",
      "statement": "\"I have a book. It is ___ book.\"",
      "context": "In Bogotá, students learn possessive words.",
      "options": [
        {
          "letter": "A",
          "text": "my",
          "is_correct": true,
          "feedback": "Correcto. \"My\" para indicar posesión de la primera persona."
        },
        {
          "letter": "B",
          "text": "your",
          "is_correct": false,
          "feedback": "Incorrecto. \"Your\" es para \"tu/su\" de usted."
        },
        {
          "letter": "C",
          "text": "his",
          "is_correct": false,
          "feedback": "Incorrecto. \"His\" es para \"de él\"."
        },
        {
          "letter": "D",
          "text": "her",
          "is_correct": false,
          "feedback": "Incorrecto. \"Her\" es para \"de ella\"."
        }
      ],
      "correct_answer": "A",
      "explanation": "\"My\" = mi/mis. Es el adjetivo posesivo para la primera persona (I). \"This is my pencil\" = Este es mi lápiz.\r\n\r\n---",
      "difficulty": "1",
