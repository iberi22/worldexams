    {
      "id": "CO-ING-6-2026-W10-present-perfect-001-MASTERY-v1",
      "statement": "What is the structure of present perfect?",
      "context": "At Colegio Cambridge de Cúcuta, students review present perfect.",
      "options": [
        {
          "letter": "A",
          "text": "subject + past tense verb",
          "is_correct": false,
          "feedback": "Pasado simple."
        },
        {
          "letter": "B",
          "text": "subject + have/has + past participle",
          "is_correct": true,
          "feedback": "Correcto."
        },
        {
          "letter": "C",
          "text": "subject + be + verb-ing",
          "is_correct": false,
          "feedback": "Presente continuo."
        },
        {
          "letter": "D",
          "text": "subject + will + verb",
          "is_correct": false,
          "feedback": "Futuro simple."
        }
      ],
      "correct_answer": "B",
      "explanation": "Present perfect: sujeto + have/has + past participle. Conecta pasado con presente.\r\n\r\n---",
