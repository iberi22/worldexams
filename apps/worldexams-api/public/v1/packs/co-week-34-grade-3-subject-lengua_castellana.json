          "letter": "A",
          "text": "En la última sílaba.",
          "is_correct": false,
          "feedback": "Esas son las agudas."
        },
        {
          "letter": "B",
          "text": "En la penúltima sílaba.",
          "is_correct": false,
          "feedback": "Esas son las graves."
        },
        {
          "letter": "C",
          "text": "En la antepenúltima sílaba.",
          "is_correct": true,
          "feedback": "¡Correcto! Las esdrújulas suenan fuerte tres sílabas antes del final."
        },
        {
          "letter": "D",
          "text": "Después de la antepenúltima.",
          "is_correct": false,
          "feedback": "Esas serían las sobresdrújulas."
        }
