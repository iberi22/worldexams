    {
      "id": "CO-SOC-5-2026-W26-hegemonia-conservadora-001-MASTERY-v2",
      "statement": "Que hecho historico ocurrio en 1903 que marco el inicio del siglo XX colombiano?",
      "context": "Contexto colombiano",
      "options": [
        {
          "letter": "A",
          "text": "La independencia",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "B",
          "text": "La separacion de Panama",
          "is_correct": true,
          "feedback": "Correcto."
        },
        {
          "letter": "C",
          "text": "La fundacion de Bogota",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "D",
          "text": "La muerte de Bolivar",
          "is_correct": false,
          "feedback": "Incorrecto."
        }
      ],
      "correct_answer": "B",
      "explanation": "El 3 de noviembre de 1903, Panama se separo de Colombia con apoyo de Estados Unidos. Esto permitio a EE.UU. construir el Canal de Panama. Fue un duro golpe para Colombia.\r\n\r\n---",
