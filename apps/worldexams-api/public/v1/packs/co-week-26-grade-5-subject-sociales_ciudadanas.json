    {
      "id": "CO-SOC-5-2026-W26-hegemonia-conservadora-001-MASTERY-v1",
      "statement": "Que fue la Hegemonia Conservadora?",
      "context": "Contexto colombiano",
      "options": [
        {
          "letter": "A",
          "text": "El dominio del Partido Liberal en el gobierno",
          "is_correct": false,
          "feedback": "Incorrecto. Era el conservador."
        },
        {
          "letter": "B",
          "text": "El periodo de gobierno del Partido Conservador de 1886 a 1930",
          "is_correct": true,
          "feedback": "Correcto."
        },
        {
          "letter": "C",
          "text": "La independencia de Colombia",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "D",
          "text": "La conquista espanola",
          "is_correct": false,
          "feedback": "Incorrecto."
        }
      ],
      "correct_answer": "B",
      "explanation": "La Hegemonia Conservadora fue el periodo de 44 anos (1886-1930) en que el Partido Conservador goberno Colombia ininterrumpidamente, bajo la Constitucion de 1886.\r\n\r\n---",
