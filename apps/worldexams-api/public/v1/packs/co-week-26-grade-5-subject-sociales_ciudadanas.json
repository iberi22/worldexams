    {
      "id": "CO-SOC-5-2026-W26-hegemonia-conservadora-001-MASTERY-v5",
      "statement": "Que recurso natural se convirtio en el principal producto de exportacion a principios del siglo XX?",
      "context": "Contexto colombiano",
      "options": [
        {
          "letter": "A",
          "text": "El oro",
          "is_correct": false,
          "feedback": "Incorrecto. Disminuyo su importancia."
        },
        {
          "letter": "B",
          "text": "El cafe",
          "is_correct": true,
          "feedback": "Correcto. El cafe se convirtio en el motor de la economia."
        },
        {
          "letter": "C",
          "text": "El petroleo",
          "is_correct": false,
          "feedback": "Incorrecto. Empezo despues."
        },
        {
          "letter": "D",
          "text": "El carbon",
          "is_correct": false,
          "feedback": "Incorrecto."
        }
      ],
      "correct_answer": "B",
      "explanation": "El cafe se convirtio en el principal producto de exportacion colombiano a partir de finales del siglo XIX. La economia cafetera impulso el desarrollo de infraestructura (ferrocarriles).\r\n\r\n---",
