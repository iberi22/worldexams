    {
      "id": "CO-SOC-5-2026-W26-hegemonia-conservadora-001-MASTERY-v4",
      "statement": "Que relacion tenia el gobierno conservador con la Iglesia Catolica?",
      "context": "Contexto colombiano",
      "options": [
        {
          "letter": "A",
          "text": "Estaban en conflicto permanente",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "B",
          "text": "Habia una alianza estrecha; la Iglesia tenia gran influencia en la educacion y el estado civil",
          "is_correct": true,
          "feedback": "Correcto."
        },
        {
          "letter": "C",
          "text": "La Iglesia no existia",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "D",
          "text": "La Iglesia gobernaba el pais",
          "is_correct": false,
          "feedback": "Incorrecto."
        }
      ],
      "correct_answer": "B",
      "explanation": "Bajo la Hegemonia Conservadora, se firmo el Concordato con la Santa Sede (1887). La Iglesia controlaba la educacion, los cementerios y el registro del estado civil.\r\n\r\n---",
