    {
      "id": "CO-SOC-5-2026-W26-hegemonia-conservadora-001-MASTERY-v3",
      "statement": "Que presidente conservador implanto la Constitucion de 1886 y empezo la Hegemonia?",
      "context": "Contexto colombiano",
      "options": [
        {
          "letter": "A",
          "text": "Simon Bolivar",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "B",
          "text": "Rafael Nunez",
          "is_correct": true,
          "feedback": "Correcto. Fue el lider de la Regeneracion."
        },
        {
          "letter": "C",
          "text": "Alfonso Lopez Pumarejo",
          "is_correct": false,
          "feedback": "Incorrecto. Era liberal."
        },
        {
          "letter": "D",
          "text": "Jorge Eliecer Gaitan",
          "is_correct": false,
          "feedback": "Incorrecto. Era liberal."
        }
      ],
      "correct_answer": "B",
      "explanation": "Rafael Nunez, lider del movimiento de la 'Regeneracion', promovio la Constitucion de 1886 que centralizo el poder y fortalecio la alianza Estado-Iglesia.\r\n\r\n---",
