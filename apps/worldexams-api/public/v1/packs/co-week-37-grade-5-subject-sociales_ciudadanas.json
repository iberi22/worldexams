      "id": "CO-SOC-5-2026-W37-derechos-humanos-ninez-001-MASTERY-v1",
      "statement": "Que son los derechos humanos?",
      "context": "Contexto colombiano",
      "options": [
        {
          "letter": "A",
          "text": "Privilegios solo para algunos",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "B",
          "text": "Derechos inherentes a toda persona por el simple hecho de ser humana",
          "is_correct": true,
          "feedback": "Correcto."
        },
        {
          "letter": "C",
          "text": "Leyes solo colombianas",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "D",
          "text": "Normas de un club",
          "is_correct": false,
          "feedback": "Incorrecto."
        }
      ],
      "correct_answer": "B",
      "explanation": "Los derechos humanos son universales, inalienables e inherentes a toda persona, sin distincion de raza, genero, religion o nacionalidad.\r\n\r\n---",
