    {
      "id": "CO-SOC-5-2026-W14-culturas-precolombinas-muiscas-001-MASTERY-v3",
      "statement": "Cual era la principal actividad economica de los Muiscas?",
      "context": "Contexto colombiano",
      "options": [
        {
          "letter": "A",
          "text": "La mineria de oro",
          "is_correct": false,
          "feedback": "Incorrecto. El oro lo obtenian por comercio."
        },
        {
          "letter": "B",
          "text": "La agricultura (maiz, papa, quinua)",
          "is_correct": true,
          "feedback": "Correcto. Cultivaban en terrazas y usaban sistemas de riego."
        },
        {
          "letter": "C",
          "text": "La pesca en el mar",
          "is_correct": false,
          "feedback": "Incorrecto. No tenian acceso al mar."
        },
        {
          "letter": "D",
          "text": "La ganaderia de llamas",
          "is_correct": false,
          "feedback": "Incorrecto. No tenian llamas."
        }
      ],
      "correct_answer": "B",
      "explanation": "Los Muiscas cultivaban maiz, papa, quinua, cubios, hibias. Construyeron terrazas de cultivo y canales de riego. Tambien comerciaban sal y esmeraldas.\r\n\r\n---",
