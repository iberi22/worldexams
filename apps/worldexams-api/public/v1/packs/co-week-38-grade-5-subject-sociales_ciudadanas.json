    {
      "id": "CO-SOC-5-2026-W38-convivencia-paz-001-MASTERY-v1",
      "statement": "Que es la convivencia pacifica?",
      "context": "Contexto colombiano",
      "options": [
        {
          "letter": "A",
          "text": "Vivir sin relacionarse con otros",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "B",
          "text": "La capacidad de vivir en armonia con los demas respetando las diferencias",
          "is_correct": true,
          "feedback": "Correcto."
        },
        {
          "letter": "C",
          "text": "Estar siempre de acuerdo",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "D",
          "text": "No hablar con nadie",
          "is_correct": false,
          "feedback": "Incorrecto."
        }
      ],
      "correct_answer": "B",
      "explanation": "La convivencia pacifica implica respetar a los demas, aceptar las diferencias (culturales, politicas, religiosas), resolver conflictos sin violencia y trabajar juntos por el bien comun.\r\n\r\n---",
