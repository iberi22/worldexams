    {
      "id": "CO-ING-8-2026-W36-modal-verbs-adv-001-MASTERY-v4",
      "statement": "You ________ studied more for the test. You failed because you were lazy.",
      "context": "Past criticism with \"should have\".",
      "options": [
        {
          "letter": "A",
          "text": "should",
          "is_correct": false,
          "feedback": "Incorrect. This is for current advice."
        },
        {
          "letter": "B",
          "text": "should have",
          "is_correct": true,
          "feedback": "Correct! \"Should have + participle\" is used for past regrets or criticism."
        },
        {
          "letter": "C",
          "text": "must have",
          "is_correct": false,
          "feedback": "Incorrect. This is for deduction, not advice."
        },
        {
