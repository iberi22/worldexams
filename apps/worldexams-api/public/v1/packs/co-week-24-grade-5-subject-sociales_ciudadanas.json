    {
      "id": "CO-SOC-5-2026-W24-republica-siglo-xix-001-MASTERY-v1",
      "statement": "Despues de la disolucion de la Gran Colombia, como se llamo el nuevo pais?",
      "context": "Contexto colombiano",
      "options": [
        {
          "letter": "A",
          "text": "Confederacion Granadina",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "B",
          "text": "Nueva Granada (1830-1858)",
          "is_correct": true,
          "feedback": "Correcto. Despues cambio varias veces de nombre."
        },
        {
          "letter": "C",
          "text": "Estados Unidos de Colombia",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "D",
          "text": "Republica de Colombia",
          "is_correct": false,
          "feedback": "Incorrecto."
        }
      ],
      "correct_answer": "B",
      "explanation": "Entre 1830 y 1858 se llamo Republica de la Nueva Granada. Luego se llamo Confederacion Granadina (1858), Estados Unidos de Colombia (1863) y finalmente Republica de Colombia (1886).\r\n\r\n---",
