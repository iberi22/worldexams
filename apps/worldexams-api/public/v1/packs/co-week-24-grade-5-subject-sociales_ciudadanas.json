      "options": [
        {
          "letter": "A",
          "text": "Ninguna",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "B",
          "text": "Mas de 8 guerras civiles",
          "is_correct": true,
          "feedback": "Correcto. Hubo numerosos conflictos armados."
