    {
      "id": "CO-SOC-5-2026-W24-republica-siglo-xix-001-MASTERY-v2",
      "statement": "Que dos partidos politicos se formaron en el siglo XIX en Colombia?",
      "context": "Contexto colombiano",
      "options": [
        {
          "letter": "A",
          "text": "Socialista y Comunista",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "B",
          "text": "Liberal y Conservador",
          "is_correct": true,
          "feedback": "Correcto. Se formaron en 1848-1849."
        },
        {
          "letter": "C",
          "text": "Democrata y Republicano",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "D",
          "text": "Verde y Azul",
          "is_correct": false,
          "feedback": "Incorrecto."
        }
      ],
      "correct_answer": "B",
      "explanation": "Los partidos Liberal (progresista, federalista, laico) y Conservador (tradicional, centralista, catolico) se fundaron a mediados del siglo XIX y protagonizaron la historia colombiana.\r\n\r\n---",
