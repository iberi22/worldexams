      "id": "CO-SOC-5-2026-W24-republica-siglo-xix-001-MASTERY-v3",
      "statement": "Que tipo de gobierno querian los federalistas en el siglo XIX?",
      "context": "Contexto colombiano",
      "options": [
        {
          "letter": "A",
          "text": "Un gobierno central fuerte en Bogota",
          "is_correct": false,
          "feedback": "Incorrecto. Eso era centralismo."
        },
        {
          "letter": "B",
          "text": "Estados autonomas con su propio gobierno",
          "is_correct": true,
          "feedback": "Correcto. Cada estado manejaria sus asuntos."
        },
        {
          "letter": "C",
          "text": "Una monarquia",
          "is_correct": false,
          "feedback": "Incorrecto."
        },
        {
          "letter": "D",
          "text": "Un imperio indigena",
          "is_correct": false,
          "feedback": "Incorrecto."
        }
      ],
      "correct_answer": "B",
      "explanation": "Los federalistas (liberales radicales) querian que cada estado (Antioquia, Boyaca, etc.) tuviera autonomia para gobernarse. Esto contrastaba con el centralismo.\r\n\r\n---",
