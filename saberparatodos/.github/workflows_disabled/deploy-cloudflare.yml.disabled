name: 🚀 Deploy to Cloudflare Pages

on:
  # Deploy automático en push a main
  push:
    branches:
      - main

  # Preview deployments en PRs
  pull_request:
    branches:
      - main

  # Permitir deploy manual desde GitHub UI
  workflow_dispatch:

# Permisos necesarios
permissions:
  contents: read
  deployments: write
  pull-requests: write

# Variables de entorno globales
env:
  NODE_VERSION: '20'
  CLOUDFLARE_PROJECT_NAME: 'saberparatodos'

jobs:
  # Job 1: Build y Test
  build:
    name: 🏗️ Build & Test
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - name: 📥 Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0  # Para git history completo

      - name: 🔧 Setup Node.js ${{ env.NODE_VERSION }}
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'npm'

      - name: 📦 Install dependencies
        run: npm ci --legacy-peer-deps

      - name: 🔍 Validate content
        run: npm run validate
        continue-on-error: true  # No bloquear deploy si hay warnings

      - name: 🏗️ Build project
        run: npm run build
        env:
          # Variables públicas (NO son secretas)
          PUBLIC_SUPABASE_URL: ${{ secrets.PUBLIC_SUPABASE_URL }}
          PUBLIC_SUPABASE_ANON_KEY: ${{ secrets.PUBLIC_SUPABASE_ANON_KEY }}
          PUBLIC_SITE_URL: https://saberparatodos.space

      - name: 📊 Build stats
        run: |
          echo "📦 Build size:"
          du -sh dist/
          echo ""
          echo "📄 Files:"
          find dist/ -type f | wc -l
          echo ""
          echo "🗂️ API files:"
          find dist/api/ -name "*.json" | wc -l

      - name: 📤 Upload build artifact
        uses: actions/upload-artifact@v4
        with:
          name: dist-${{ github.sha }}
          path: dist/
          retention-days: 7

  # Job 2: Deploy a Cloudflare Pages
  deploy:
    name: 🚀 Deploy to Cloudflare
    needs: build
    runs-on: ubuntu-latest
    timeout-minutes: 10

    # Deploy solo en push a main O PRs (no en forks)
    if: github.event_name == 'push' || (github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository)

    steps:
      - name: 📥 Checkout code
        uses: actions/checkout@v4

      - name: 📥 Download build artifact
        uses: actions/download-artifact@v4
        with:
          name: dist-${{ github.sha }}
          path: dist/

      - name: 🚀 Deploy to Cloudflare Pages
        id: deploy
        uses: cloudflare/wrangler-action@v3
        with:
          apiToken: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          accountId: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
          command: pages deploy dist --project-name=${{ env.CLOUDFLARE_PROJECT_NAME }} --branch=${{ github.head_ref || github.ref_name }}

      - name: 📝 Comment on PR (Preview URL)
        if: github.event_name == 'pull_request'
        uses: actions/github-script@v7
        with:
          script: |
            const deploymentUrl = '${{ steps.deploy.outputs.deployment-url }}';
            const comment = `
            ## 🚀 Preview Deployment Ready!

            **Preview URL:** ${deploymentUrl}

            **Commit:** \`${{ github.sha }}\`
            **Branch:** \`${{ github.head_ref }}\`

            ### Quick Links
            - 🏠 [Home](${deploymentUrl})
            - 📊 [Ranking](${deploymentUrl}/ranking)
            - 🎉 [Party Mode](${deploymentUrl}/party)
            - 📚 [API Demo](${deploymentUrl}/api/CO/icfes/11/matematicas/index.json)

            ---
            <sub>Deployment powered by Cloudflare Pages 🟠</sub>
            `;

            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: comment
            });

      - name: ✅ Deployment Summary
        run: |
          echo "🎉 Deployment successful!"
          echo ""
          echo "📍 Environment: ${{ github.ref_name == 'main' && 'Production' || 'Preview' }}"
          echo "🔗 URL: ${{ steps.deploy.outputs.deployment-url || 'https://saberparatodos.space' }}"
          echo "📦 Project: ${{ env.CLOUDFLARE_PROJECT_NAME }}"
          echo "🆔 Deployment ID: ${{ steps.deploy.outputs.deployment-id }}"
          echo ""
          echo "✅ All systems operational!"

  # Job 3: E2E Tests (solo en production)
  e2e-tests:
    name: 🧪 E2E Tests
    needs: deploy
    runs-on: ubuntu-latest
    timeout-minutes: 10

    # Solo ejecutar en push a main (production)
    if: github.ref == 'refs/heads/main' && github.event_name == 'push'

    steps:
      - name: 📥 Checkout code
        uses: actions/checkout@v4

      - name: 🔧 Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'npm'

      - name: 📦 Install dependencies
        run: npm ci --legacy-peer-deps

      - name: 🎭 Install Playwright browsers
        run: npx playwright install --with-deps chromium

      - name: 🧪 Run E2E tests
        run: npm run test:party
        env:
          BASE_URL: https://saberparatodos.space
        continue-on-error: true  # No fallar deployment si tests fallan

      - name: 📊 Upload test results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: playwright-report-${{ github.sha }}
          path: playwright-report/
          retention-days: 7

      - name: 💬 Comment test results on commit
        if: always()
        uses: actions/github-script@v7
        with:
          script: |
            const fs = require('fs');
            const testResults = fs.existsSync('test-results/.last-run.json')
              ? JSON.parse(fs.readFileSync('test-results/.last-run.json', 'utf8'))
              : { status: 'unknown' };

            const status = testResults.status === 'passed' ? '✅ PASSED' : '❌ FAILED';
            const emoji = testResults.status === 'passed' ? '🎉' : '⚠️';

            const comment = \`
            ## ${emoji} E2E Test Results

            **Status:** ${status}
            **URL Tested:** https://saberparatodos.space
            **Commit:** \\\`${{ github.sha }}\\\`

            [View full report](${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }})
            \`;

            // Crear commit status
            github.rest.repos.createCommitStatus({
              owner: context.repo.owner,
              repo: context.repo.repo,
              sha: context.sha,
              state: testResults.status === 'passed' ? 'success' : 'failure',
              context: 'E2E Tests',
              description: status,
              target_url: \`${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}\`
            });
