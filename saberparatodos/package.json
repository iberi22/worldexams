{
  "name": "saberparatodos",
  "type": "module",
  "version": "0.15.2",
  "scripts": {
    "predev": "",
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/generate-build-info.js && node scripts/generate-static-packs.js",
    "build": "astro build",
    "postbuild": "echo 'Build complete'",
    "generate:packs:weekly": "node scripts/generate-static-packs.js --all-weekly",
    "generate:packs:changed-weekly": "node scripts/generate-static-packs.js --all-weekly --changed-only",
    "preview": "astro preview",
    "sync:api": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/copy-api.ps1",
    "predeploy": "npm run lint && npm run test:unit && npm run test && npm run build && node scripts/pre-deploy-check.js",
    "deploy": "node scripts/normalize-wrangler-config.mjs --target production && npx wrangler deploy --config dist/server/wrangler.json --name=saberparatodos",
    "deploy:manual": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-manual.ps1",
    "deploy:production": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-manual.ps1 -Target production",
    "deploy:preview": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-manual.ps1 -Target preview",
    "tag:deploy": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/create-deploy-tag.ps1",
    "deploy:fast": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-manual.ps1 -Fast",
    "deploy:preview:fast": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-manual.ps1 -Target preview -Fast",
    "verify:deploy": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-deployment.ps1",
    "astro": "astro",
    "validate": "node scripts/validate_content.js",
    "validate:strict": "node scripts/validate_content.js --strict-v3 --fail-on-error",
    "audit:country-readiness": "node scripts/audit-country-readiness.js",
    "validate:g11": "node scripts/validate_content.js --grade=11 --country=colombia",
    "audit:quality": "node scripts/audit_question_quality.js --scope=colombia,ingles --grade-min=3 --grade-max=11 --write-report",
    "audit:quality:g11": "node scripts/audit_question_quality.js --scope=colombia,ingles --grade-min=11 --grade-max=11 --write-report",
    "coverage:questions": "node scripts/analyze_question_coverage.js --scope=colombia,ingles --grade-min=3 --grade-max=11",
    "verify:grade11-preicfes": "node scripts/verify-grade11-preicfes-policy.js",
    "validate:full": "node scripts/validate_content.js && astro check && astro build",
    "video:queue:v41": "node scripts/video/build-video-queue.js",
    "video:queue:v41:jobs": "node scripts/video/build-video-queue.js --emit-jobs",
    "video:queue:social": "node scripts/video/build-social-publish-queue.js",
    "video:init:period1:g11": "node scripts/video/init-period1-grade11-assets.js",
    "video:manifest:upsert": "node scripts/video/upsert-video-manifest.js",
    "video:jobs:run": "node scripts/video/run-local-video-jobs.js",
    "video:generate:fallback": "python scripts/video/generate-videos-fallback.py",
    "video:publish:sync": "node scripts/video/sync-publish-links-to-manifest.js",
    "video:social:keys:check": "node scripts/video/validate-social-keys.js",
    "video:gen:v2": "npx tsx scripts/video-generation-v2.ts",
    "video:gen:v2:all": "npx tsx scripts/video-generation-v2.ts --flow=all",
    "video:gen:v2:elevenlabs": "npx tsx scripts/video-generation-v2.ts --voice=elevenlabs",
    "video:gen:v2:xtts": "npx tsx scripts/video-generation-v2.ts --voice=xtts",
    "video:tutorials:all": "npx tsx scripts/generate-all-tutorials.ts",
    "video:tutorials:all:parallel": "npx tsx scripts/generate-all-tutorials.ts --parallel",
    "video:tutorials:re-run": "npx tsx scripts/generate-all-tutorials.ts --re-run",
    "video:capture": "node scripts/video/capture-exam-platform.js",
    "video:pipeline:auto": "node scripts/video/auto-tutorial-pipeline.js",
    "lint": "astro check && tsc --noEmit",
    "postinstall": "node scripts/install-hooks.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "test:party": "playwright test party-mode.spec.ts",
    "test:video:frames": "playwright test tests/video-frame-review.spec.ts",
    "test:party:headed": "playwright test party-mode.spec.ts --headed",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke:geo": "node ../scripts/smoke-geo-routing.mjs",
    "smoke:ai": "node scripts/smoke-ai-core.mjs",
    "metrics:generation": "node scripts/generate-generation-metrics.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.0.1",
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/svelte": "^9.0.0",
    "@cloudflare/workers-types": "^4.20240529.0",
    "@huggingface/transformers": "^3.7.2",
    "@mediapipe/face_detection": "^0.4.1646425229",
    "@mlc-ai/web-llm": "^0.2.84",
    "@remotion/cli": "^4.0.481",
    "@remotion/core": "^1.0.0-y.46",
    "@remotion/player": "^4.0.451",
    "@sentry/astro": "^10.58.0",
    "@sentry/svelte": "^10.45.0",
    "@supabase/supabase-js": "^2.99.3",
    "@tailwindcss/vite": "^4.2.2",
    "@trystero-p2p/supabase": "^0.23.1",
    "astro": "^7.2.0",
    "chart.js": "^4.5.1",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "katex": "^0.16.40",
    "lightningcss-linux-x64-gnu": "^1.32.0",
    "pdfjs-dist": "^5.4.149",
    "peerjs": "^1.5.5",
    "remotion": "^4.0.451",
    "svelte": "^5.55.9",
    "tailwindcss": "^4.2.2",
    "trystero": "^0.23.1",
    "wrangler": "^4.102.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.2",
    "@astrojs/language-server": "^2.16.11",
    "@playwright/test": "^1.57.0",
    "@supabase/mcp-server-supabase": "^0.7.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.0",
    "@types/html2canvas": "^0.5.35",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.0.16",
    "autoprefixer": "^10.4.27",
    "baseline-browser-mapping": "^2.10.10",
    "fake-indexeddb": "^6.2.5",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "js-yaml": "5.2.3",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "pagefind": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "sharp": "0.35.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.0.16"
  },
  "overrides": {
    "js-yaml": "5.2.3",
    "sharp": "0.35.3",
    "miniflare": {
      "sharp": "0.35.3"
    },
    "astro": {
      "sharp": "0.35.3"
    }
  },
  "lint-staged": {
    "*.{js,ts,astro,svelte}": [
      "npx prettier --check --write"
    ]
  }
}