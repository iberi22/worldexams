{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "svelte",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "$lib/*": ["src/lib/*"],
      "edge-mesh": ["src/lib/ai/__mocks__/edge-mesh-stub.ts"]
    }
  },
  "include": ["src/**/*", "src/env.d.ts"],
  "exclude": ["template-openicfes", "supabase", "functions", "dist", "video-pipeline", "scripts", "tests", "tools", "coverage"]
}
