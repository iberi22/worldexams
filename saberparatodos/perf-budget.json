{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "1.0.0",
  "name": "SaberParaTodos PWA Performance Budget",
  "budgets": [
    {
      "resourceType": "app-shell",
      "maximumSizeBytes": 5242880,
      "maximumSizeFormatted": "5MB",
      "description": "App shell client bundle size excluding question data packs"
    },
    {
      "resourceType": "js-chunk",
      "maximumSizeBytes": 524288,
      "maximumSizeFormatted": "500KB",
      "description": "Maximum size per JavaScript chunk"
    },
    {
      "resourceType": "css-chunk",
      "maximumSizeBytes": 153600,
      "maximumSizeFormatted": "150KB",
      "description": "Maximum size per CSS bundle"
    }
  ],
  "performanceMetrics": {
    "targetLoadTimeMs": 2000,
    "firstContentfulPaintMs": 1200,
    "largestContentfulPaintMs": 2000,
    "totalBlockingTimeMs": 200,
    "cumulativeLayoutShift": 0.1,
    "lighthouseScoreTargets": {
      "performance": 90,
      "accessibility": 90,
      "bestPractices": 90,
      "pwa": 90
    }
  },
  "cachingPolicy": {
    "questionPacksOfflineStrategy": "stale-while-revalidate",
    "staticAssetsOfflineStrategy": "cache-first",
    "dynamicPagesOfflineStrategy": "network-first"
  }
}
