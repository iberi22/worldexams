  # Cache-Control: Disable aggressive caching for HTML files
  Cache-Control: public, max-age=0, must-revalidate

# 🆕 Rotating Question Packs - immutable, long cache (7 days)
# Packs are versioned by pack-id, so they can be cached aggressively
/api/co/icfes/packs/*
  Content-Type: application/json
  Cache-Control: public, max-age=604800, immutable
  Access-Control-Allow-Origin: *

# 🆕 Current Pack Metadata - short cache, must revalidate
/api/co/icfes/current-pack.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

# API JSON files - short cache
/api/*
  Content-Type: application/json
  Cache-Control: public, max-age=300, s-maxage=300, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

# Static assets - long cache (images, fonts, etc)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# JavaScript and CSS - medium cache with versioning
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# Images
/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.jpeg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

# Fonts
/*.woff
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.ttf
  Cache-Control: public, max-age=31536000, immutable

# HTML pages - no cache to ensure fresh content
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Root HTML
/
  Cache-Control: public, max-age=0, must-revalidate
