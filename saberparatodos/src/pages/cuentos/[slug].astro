---
import Layout from '../../layouts/Layout.astro';
import PuertaLibro from '../../components/cuentos/PuertaLibro.svelte';
import { getAllCuentosCatalog, getCuentoBySlug } from '../../lib/cuentos/cuentos-catalog';

export const prerender = true;

export async function getStaticPaths() {
  const catalog = await getAllCuentosCatalog();
  return catalog.map((c) => ({
    params: { slug: c.slug },
  }));
}

const { slug } = Astro.params;
const cuento = await getCuentoBySlug(slug || '');

if (!cuento) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400'
);

const siteUrl = (import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || 'https://saberparatodos.space').replace(/\/$/, '');
const canonicalURL = `${siteUrl}/cuentos/${cuento.slug}/`;
const pageTitle = `${cuento.titulo} | Cuentos SaberParaTodos`;

const rawDescription = cuento.valor
  ? `Cuento infantil ilustrado sobre ${cuento.valor}. Edad recomendada: ${cuento.edad} años. Incluye preguntas de comprensión lectora.`
  : `Cuento infantil ilustrado para niños de ${cuento.edad} años. Historia con valores y comprensión lectora.`;

const pageDescription = rawDescription.length > 160 ? `${rawDescription.slice(0, 159)}…` : rawDescription;

// Schema.org Structured Data
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Inicio',
      item: `${siteUrl}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Cuentos',
      item: `${siteUrl}/cuentos/`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: cuento.titulo,
      item: canonicalURL,
    },
  ],
};

const bookSchema = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: cuento.titulo,
  description: pageDescription,
  inLanguage: 'es',
  bookFormat: 'https://schema.org/EBook',
  typicalAgeRange: cuento.edad,
  teaches: cuento.valor,
  about: [cuento.eje, cuento.habitat].filter(Boolean),
  publisher: {
    '@type': 'Organization',
    name: 'SaberParaTodos / WorldExams',
  },
  copyrightHolder: {
    '@type': 'Organization',
    name: 'SaberParaTodos / WorldExams',
  },
  copyrightYear: 2026,
  isAccessibleForFree: true,
  license: 'PROPRIETARY-FREE-READ: Lectura gratuita, prohibida su reproducción sin autorización.',
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={cuento.coverEscena || '/og-image.svg'}
  type="article"
  noindex={true}
>
  <link slot="head" rel="canonical" href={canonicalURL} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(bookSchema)} />

  <div class="min-h-screen bg-[#FDF6EC] text-[#3A2E2A] font-sans antialiased pb-12 flex flex-col justify-between">
    <!-- Top Navigation Header -->
    <header class="border-b border-[#3A2E2A]/10 bg-[#FDF6EC]/80 backdrop-blur-sm sticky top-0 z-10">
      <div class="max-w-4xl mx-auto px-4 py-3 flex items-center justify-between text-sm">
        <nav aria-label="Breadcrumb" class="text-[#3A2E2A]/70">
          <ol class="flex items-center gap-2 flex-wrap">
            <li><a href="/" class="hover:underline font-medium">Inicio</a></li>
            <li>/</li>
            <li><a href="/cuentos/" class="hover:underline font-medium">Cuentos</a></li>
            <li>/</li>
            <li class="font-bold text-[#FF9F43] truncate max-w-[200px] sm:max-w-xs" aria-current="page">
              {cuento.titulo}
            </li>
          </ol>
        </nav>
        <a
          href="/cuentos/"
          class="text-xs bg-[#3A2E2A]/10 hover:bg-[#3A2E2A]/20 text-[#3A2E2A] px-3 py-1 rounded-full font-bold transition"
        >
          ← Catálogo
        </a>
      </div>
    </header>

    <!-- Main PuertaLibro Container -->
    <main class="flex-1 flex items-center justify-center py-6 px-4">
      <PuertaLibro cuento={cuento} client:load />
    </main>

    <!-- Footer Copyright Notice -->
    <footer class="py-6 border-t border-[#3A2E2A]/10 text-center text-xs text-[#3A2E2A]/70 space-y-1">
      <p>© 2026 SaberParaTodos / WorldExams. Todos los derechos reservados.</p>
      <p>Lectura gratuita, prohibida su reproducción sin autorización previa.</p>
    </footer>
  </div>

  <script is:inline>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker
          .register('/cuentos/sw-cuentos.js', { scope: '/cuentos/' })
          .then((reg) => console.log('[SW-Cuentos] Registrado en scope:', reg.scope))
          .catch((err) => console.error('[SW-Cuentos] Error al registrar:', err));
      });

      navigator.serviceWorker.ready
        .then(() => {
          fetch(window.location.pathname, { credentials: 'same-origin' }).catch(() => {});
          const slug = window.location.pathname.split('/').filter(Boolean).pop();
          if (slug && slug !== 'cuentos') {
            fetch('/v1/cuentos/' + slug + '.json').catch(() => {});
          }
        })
        .catch(() => {});
    }
  </script>
</Layout>
