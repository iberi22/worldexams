---
import Layout from '../../layouts/Layout.astro';
import { getAllCuentosCatalog, getCuentoBySlug } from '../../lib/cuentos/cuentos-catalog';

export const prerender = true;

export async function getStaticPaths() {
  const catalog = await getAllCuentosCatalog();
  console.log('📖 getStaticPaths catalog length:', catalog.length, catalog);
  return catalog.map((c) => ({
    params: { slug: c.slug },
  }));
}

const { slug } = Astro.params;
const cuento = await getCuentoBySlug(slug || '');

if (!cuento) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400'
);

const siteUrl = (import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || 'https://saberparatodos.space').replace(/\/$/, '');
const canonicalURL = `${siteUrl}/cuentos/${cuento.slug}/`;
const pageTitle = `${cuento.titulo} — Cuentos Infantiles | SaberParaTodos`;
const pageDescription = `Cuento infantil: ${cuento.titulo}. Recomendado para niños de ${cuento.edad} años. Historia con valores y comprensión lectora.`;

// Schema.org Structured Data
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Inicio',
      item: `${siteUrl}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Cuentos',
      item: `${siteUrl}/cuentos/`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: cuento.titulo,
      item: canonicalURL,
    },
  ],
};

const bookSchema = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: cuento.titulo,
  description: pageDescription,
  inLanguage: cuento.idioma,
  bookFormat: 'https://schema.org/EBook',
  typicalAgeRange: cuento.edad,
  about: [cuento.valor, cuento.eje, cuento.habitat].filter(Boolean),
  publisher: {
    '@type': 'Organization',
    name: 'SaberParaTodos / WorldExams',
  },
  copyrightHolder: {
    '@type': 'Organization',
    name: 'SaberParaTodos / WorldExams',
  },
  copyrightYear: 2026,
  isAccessibleForFree: true,
};
---

<Layout title={pageTitle} description={pageDescription} noindex={true}>
  <link slot="head" rel="canonical" href={canonicalURL} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(bookSchema)} />

  <div class="min-h-screen bg-[#FDF6EC] text-[#3A2E2A] font-sans antialiased pb-16">
    <!-- Breadcrumb Header -->
    <header class="border-b border-[#3A2E2A]/10 bg-[#FDF6EC]/80 backdrop-blur-sm sticky top-0 z-10">
      <div class="max-w-4xl mx-auto px-4 py-3 flex items-center justify-between text-sm">
        <nav aria-label="Breadcrumb" class="text-[#3A2E2A]/70">
          <ol class="flex items-center gap-2 flex-wrap">
            <li><a href="/" class="hover:underline font-medium">Inicio</a></li>
            <li>/</li>
            <li><a href="/cuentos/" class="hover:underline font-medium">Cuentos</a></li>
            <li>/</li>
            <li class="font-bold text-[#FF9F43] truncate max-w-[200px] sm:max-w-xs" aria-current="page">
              {cuento.titulo}
            </li>
          </ol>
        </nav>
        <a
          href="/cuentos/"
          class="text-xs bg-[#3A2E2A]/10 hover:bg-[#3A2E2A]/20 text-[#3A2E2A] px-3 py-1 rounded-full font-bold transition"
        >
          ← Catálogo
        </a>
      </div>
    </header>

    <main class="max-w-3xl mx-auto px-4 pt-8">
      <!-- Cuento Header -->
      <header class="text-center mb-10">
        <div class="flex flex-wrap justify-center items-center gap-2 mb-3 text-xs font-semibold">
          <span class="bg-[#FF9F43]/20 text-[#3A2E2A] px-3 py-1 rounded-full font-bold">
            Edad: {cuento.edad} años
          </span>
          {cuento.valor && (
            <span class="bg-[#4FB6A3]/20 text-[#3A2E2A] px-3 py-1 rounded-full">
              Valor: {cuento.valor}
            </span>
          )}
          {cuento.habitat && (
            <span class="bg-[#5B6FD6]/15 text-[#3A2E2A] px-3 py-1 rounded-full">
              Hábitat: {cuento.habitat}
            </span>
          )}
        </div>

        <h1 class="text-3xl sm:text-4xl font-extrabold text-[#3A2E2A] tracking-tight mb-3">
          {cuento.titulo}
        </h1>

        {cuento.personajes.length > 0 && (
          <p class="text-xs text-[#3A2E2A]/70">
            Personajes: <strong class="text-[#3A2E2A] font-bold">{cuento.personajes.join(', ')}</strong>
          </p>
        )}
      </header>

      <!-- Pages Sequence (Semantic Article) -->
      <article class="space-y-12 mb-16">
        {cuento.paginasList.map((pagina) => (
          <section class="bg-white border border-[#3A2E2A]/10 rounded-2xl overflow-hidden shadow-sm p-6 sm:p-8">
            <!-- Page Header / Number Badge -->
            <div class="flex items-center justify-between border-b border-[#3A2E2A]/10 pb-3 mb-6 text-xs text-[#3A2E2A]/60">
              <span class="font-bold uppercase tracking-wider text-[#FF9F43]">
                Página {pagina.numero} de {cuento.paginas}
              </span>
              <span>SaberParaTodos</span>
            </div>

            <!-- Page Scene Illustration -->
            {pagina.escena && (
              <div class="mb-6 bg-[#FDF6EC] p-4 rounded-xl border border-[#3A2E2A]/5 text-center">
                <img
                  src={pagina.escena}
                  alt={pagina.alt || `Ilustración de la página ${pagina.numero}`}
                  class="max-h-64 sm:max-h-80 mx-auto object-contain"
                  loading={pagina.numero === 1 ? 'eager' : 'lazy'}
                />
              </div>
            )}

            <!-- Page Paragraph Text -->
            <p class="text-lg sm:text-xl text-[#3A2E2A] leading-relaxed font-normal">
              {pagina.texto}
            </p>
          </section>
        ))}
      </article>

      <!-- Quiz & Activity Section -->
      {cuento.quiz && cuento.quiz.preguntas.length > 0 && (
        <section class="bg-white border-2 border-[#FF9F43]/40 rounded-2xl p-6 sm:p-8 mb-12 shadow-sm">
          <div class="flex items-center gap-3 mb-6">
            <span class="text-3xl">🧩</span>
            <div>
              <h2 class="text-2xl font-extrabold text-[#3A2E2A]">
                Actividad de Comprensión
              </h2>
              <p class="text-xs text-[#3A2E2A]/70">
                Responde las preguntas en familia para conversar sobre la historia.
              </p>
            </div>
          </div>

          <!-- Questions List -->
          <ol class="space-y-8 list-none p-0 m-0">
            {cuento.quiz.preguntas.map((q) => (
              <li class="border-b border-[#3A2E2A]/10 pb-6 last:border-0 last:pb-0">
                <h3 class="text-lg font-bold text-[#3A2E2A] mb-4 flex items-start gap-2">
                  <span class="bg-[#FF9F43] text-[#3A2E2A] px-2 py-0.5 rounded-md text-xs font-black">
                    #{q.id}
                  </span>
                  <span>{q.pregunta}</span>
                </h3>

                <!-- Options -->
                <div class="grid gap-2 mb-4">
                  {q.opciones.map((opt) => (
                    <div
                      class={`p-3.5 rounded-xl border text-sm flex items-center justify-between ${
                        opt.esCorrecta
                          ? 'bg-[#4FB6A3]/10 border-[#4FB6A3]/40 text-[#3A2E2A]'
                          : 'bg-[#FDF6EC]/50 border-[#3A2E2A]/10 text-[#3A2E2A]'
                      }`}
                    >
                      <span class="font-medium">
                        <strong class="font-bold mr-1">{opt.id})</strong> {opt.texto}
                      </span>
                    </div>
                  ))}
                </div>

                <!-- Static Details Disclosure for Answer & Feedback -->
                <details class="mt-3 bg-[#FDF6EC] border border-[#3A2E2A]/10 rounded-xl p-3 text-xs">
                  <summary class="cursor-pointer font-bold text-[#FF9F43] hover:underline flex items-center gap-1.5">
                    <span>💡</span> Ver respuesta correcta y explicación
                  </summary>
                  <div class="mt-2.5 pt-2.5 border-t border-[#3A2E2A]/10 space-y-2">
                    {q.opciones.map((opt) => (
                      <p class="text-[#3A2E2A]/80">
                        <strong class="font-bold text-[#3A2E2A]">Opción {opt.id}:</strong> {opt.feedback}
                      </p>
                    ))}
                  </div>
                </details>
              </li>
            ))}
          </ol>

          <!-- Explanation / Moraleja -->
          {cuento.quiz.explicacion && (
            <div class="mt-8 pt-6 border-t border-[#3A2E2A]/10 bg-[#FF9F43]/10 p-5 rounded-xl">
              <h4 class="text-sm font-extrabold text-[#3A2E2A] mb-2 flex items-center gap-2">
                <span>🌟</span> Para Reflexionar en Familia
              </h4>
              <p class="text-sm text-[#3A2E2A]/90 leading-relaxed font-medium">
                {cuento.quiz.explicacion}
              </p>
            </div>
          )}
        </section>
      )}

      <!-- Footer Copyright Notice -->
      <footer class="pt-6 border-t border-[#3A2E2A]/10 text-center text-xs text-[#3A2E2A]/70 space-y-1">
        <p>© 2026 SaberParaTodos / WorldExams. Todos los derechos reservados.</p>
        <p>Lectura gratuita, prohibida su reproducción sin autorización previa.</p>
      </footer>
    </main>
  </div>
</Layout>
