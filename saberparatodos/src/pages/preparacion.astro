---
import Layout from '../layouts/Layout.astro';
import TenantRouteNotice from '../components/TenantRouteNotice.astro';
import { resolveRuntimeCountryConfig } from '../config';
import { getTenantRouteAvailability } from '../config/tenant-experience';
import { getSiteShellContent } from '../config/site-shell-content';

const country = resolveRuntimeCountryConfig(Astro.locals.country);
const availability = getTenantRouteAvailability(country, 'preparacion');
const siteContent = getSiteShellContent(country);
const content = siteContent.preparacion;
---

<Layout
  title={`Preparacion ${country.examName} | ${country.product.siteName}`}
  description={`Ruta de preparacion e informacion operativa para ${country.examFullName}.`}
>
  <div class="min-h-screen bg-[#121212] py-16 px-4">
    <div class="max-w-5xl mx-auto">
      {availability.isAvailable ? (
        <div class="space-y-16">
          <section class="mb-8 pt-8 pb-4 text-center">
            <span class="inline-block px-3 py-1 text-[10px] font-mono tracking-widest uppercase bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 rounded-full mb-6">
              Ruta de preparacion
            </span>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-[#F5F5DC] mb-8 pb-2">
              Preparacion e inscripcion para {country.examName}
            </h1>
            <p class="text-lg md:text-xl text-white/70 max-w-3xl mx-auto leading-relaxed">
              {content.heroIntro}
            </p>
          </section>

          <div class="grid gap-6 md:grid-cols-3">
            <article class="rounded-3xl border border-white/10 bg-white/[0.03] p-6">
              <p class="text-xs font-bold uppercase tracking-[0.25em] text-emerald-300">1. Convocatoria</p>
              <h2 class="mt-3 text-2xl font-black text-[#F5F5DC]">{content.step1Title}</h2>
              <p class="mt-3 text-sm leading-6 text-white/65">
                {content.step1Description}
              </p>
            </article>

            <article class="rounded-3xl border border-white/10 bg-white/[0.03] p-6">
              <p class="text-xs font-bold uppercase tracking-[0.25em] text-amber-300">2. Registro</p>
              <h2 class="mt-3 text-2xl font-black text-[#F5F5DC]">{content.step2Title}</h2>
              <p class="mt-3 text-sm leading-6 text-white/65">
                {content.step2Description}
              </p>
            </article>

            <article class="rounded-3xl border border-white/10 bg-white/[0.03] p-6">
              <p class="text-xs font-bold uppercase tracking-[0.25em] text-sky-300">3. Practica</p>
              <h2 class="mt-3 text-2xl font-black text-[#F5F5DC]">Abre tu ruta en {country.product.siteName}</h2>
              <p class="mt-3 text-sm leading-6 text-white/65">
                Empieza con simulacros cortos, mide tus areas mas debiles y usa la guia del tenant para entender la estructura visible de {country.examName}.
              </p>
            </article>
          </div>

          <section class="rounded-[2rem] border border-white/10 bg-[#0f1115] p-8">
            <h2 class="text-3xl font-black text-[#F5F5DC]">Plan recomendado</h2>
            <ul class="mt-6 space-y-4 text-white/75">
              <li>Inicia con una sesion diagnostica corta para detectar brechas por area.</li>
              <li>Programa dos bloques semanales de practica cronometrada y una revision de errores.</li>
              <li>Usa la guia oficial visible del tenant antes de asumir cambios en estructura, sedes o reporte de resultados.</li>
              {content.planOfficialNote && <li>{content.planOfficialNote}</li>}
            </ul>

            <div class="mt-8 flex flex-wrap gap-3">
              <a href="/" class="rounded-xl bg-emerald-500 px-5 py-3 font-bold text-black transition hover:bg-emerald-400">
                Ir a la practica
              </a>
              <a href="/guia-examen" class="rounded-xl border border-white/15 px-5 py-3 font-bold text-white/85 transition hover:border-emerald-500/40 hover:text-white">
                Ver guia completa
              </a>
            </div>
          </section>
        </div>
      ) : (
        <TenantRouteNotice country={country} availability={availability} />
      )}
    </div>
  </div>
</Layout>
