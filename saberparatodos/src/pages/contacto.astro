---
import Layout from '../layouts/Layout.astro';
import { countryConfig } from '../config';
import { getSiteShellContent } from '../config/site-shell-content';

const shellContent = getSiteShellContent(countryConfig);
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : countryConfig.product.siteUrl.replace(/\/$/, '');

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Contacto ${countryConfig.product.siteName}`,
  description: shellContent.contact.description,
  url: `${siteUrl}/contacto`,
  mainEntity: {
    '@type': 'Organization',
    name: countryConfig.product.siteName,
    url: siteUrl,
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      email: countryConfig.product.contactEmail,
      availableLanguage: countryConfig.language
    }
  }
};
---

<Layout
  title={`Contacto | ${countryConfig.product.siteName}`}
  description={shellContent.contact.description}
>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(contactSchema)} />

  <main
    class="min-h-screen py-16 px-4"
    style={`--contact-primary: ${countryConfig.theme.primary}; --contact-secondary: ${countryConfig.theme.secondary}; --contact-accent: ${countryConfig.theme.accent};`}
  >
    <div class="container mx-auto max-w-4xl">
      <div class="text-center mb-12">
        <div class="flex items-center justify-center gap-2 mb-4">
          <div class="w-8 h-1 rounded-full" style={`background: linear-gradient(to right, ${countryConfig.theme.primary}, ${countryConfig.theme.secondary}, ${countryConfig.theme.accent});`}></div>
          <span class="text-xs uppercase tracking-[0.3em] text-white/40">Contacto</span>
          <div class="w-8 h-1 rounded-full" style={`background: linear-gradient(to right, ${countryConfig.theme.accent}, ${countryConfig.theme.secondary}, ${countryConfig.theme.primary});`}></div>
        </div>
        <h1 class="text-4xl md:text-5xl font-bold mb-4">{shellContent.contact.title}</h1>
        <p class="text-white/60 max-w-lg mx-auto">
          {shellContent.contact.description}
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 mb-12">
        <a
          href="https://github.com/world-exams"
          target="_blank"
          rel="noopener noreferrer"
          class="contact-card group"
        >
          <div class="icon-wrapper text-[#F5F5DC] group-hover:text-[#FCD116] transition-colors">
            <svg class="w-12 h-12" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2">{shellContent.contact.github.title}</h3>
          <p class="text-sm text-white/50 mb-4">{shellContent.contact.github.description}</p>
          <span class="text-xs text-[#FCD116] uppercase tracking-wider group-hover:underline">
            {shellContent.contact.github.cta} →
          </span>
        </a>

        <a href={`mailto:${countryConfig.product.contactEmail}`} class="contact-card group">
          <div class="icon-wrapper text-[#F5F5DC] group-hover:text-[#CE1126] transition-colors">
            <svg class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2">{shellContent.contact.email.title}</h3>
          <p class="text-sm text-white/50 mb-4">{shellContent.contact.email.description}</p>
          <span class="text-xs text-[#CE1126] uppercase tracking-wider group-hover:underline">
            {shellContent.contact.email.cta} →
          </span>
        </a>
      </div>

      <div class="bg-[#1a1a1a] border border-white/10 rounded-lg p-8">
        <h2 class="text-2xl font-bold mb-6 text-center">{shellContent.contact.faqTitle}</h2>
        <div class="space-y-4">
          {shellContent.contact.faq.map((item) => (
            <details class="faq-item group">
              <summary class="flex items-center justify-between cursor-pointer p-4 bg-white/5 rounded-lg hover:bg-white/10 transition-colors">
                <span class="font-medium">{item.question}</span>
                <svg class="w-5 h-5 text-[#FCD116] transform group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="p-4 text-white/60 text-sm">{item.answer}</div>
            </details>
          ))}
        </div>
      </div>

      <div class="text-center mt-12">
        <p class="text-white/40 text-sm mb-4">{shellContent.contact.ctaLabel}</p>
        <a
          href="/practica"
          class="inline-flex items-center gap-2 px-6 py-3 bg-[#F5F5DC] text-[#121212] font-bold uppercase tracking-wider rounded hover:bg-[#FCD116] transition-colors"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {shellContent.contact.ctaButton}
        </a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .contact-card {
    background-color: #1a1a1a;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.5rem;
    padding: 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }

  .contact-card:hover {
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-4px);
  }

  .contact-card::before {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--contact-primary), var(--contact-secondary), var(--contact-accent));
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .contact-card:hover::before {
    opacity: 1;
  }

  .icon-wrapper {
    margin-bottom: 1rem;
    padding: 1rem;
    border-radius: 9999px;
    background-color: rgba(255, 255, 255, 0.05);
  }

  .faq-item[open] summary {
    background-color: rgba(255, 255, 255, 0.1);
  }
</style>
