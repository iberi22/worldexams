---
import Layout from '../../layouts/Layout.astro';
import TenantRouteNotice from '../../components/TenantRouteNotice.astro';
import { getCollection } from 'astro:content';
import { resolveRuntimeCountryConfig } from '../../config';
import { getTenantRouteAvailability } from '../../config/tenant-experience';

const country = resolveRuntimeCountryConfig(Astro.locals.country);
const availability = getTenantRouteAvailability(country, 'novedades');
const isCO = country.code === 'CO';

const posts = isCO ? await getCollection('changelog') : [];
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featuredPosts = posts.slice(0, 3);
const latestPost = posts[0];
---

<Layout title={`Novedades | ${country.product.siteName}`} description={`Novedades del producto para ${country.name}.`}>
  <div class="min-h-screen bg-[#121212] py-16 px-4">
    <div class="max-w-4xl mx-auto">
      {isCO ? (
        <>
          <section class="mb-16 pt-8 pb-4 text-center">
            <span class="inline-block rounded-full border border-[#FCD116]/20 bg-[#FCD116]/10 px-3 py-1 text-[11px] font-mono uppercase tracking-[0.28em] text-[#FCD116]">
              Centro de producto
            </span>
            <h1 class="text-4xl md:text-5xl font-bold text-[#F5F5DC] mb-4">Novedades y actualizaciones</h1>
            <p class="text-xl text-white/60">Lo ultimo en plataforma, preguntas y guias de estudio.</p>
          </section>

          {latestPost && (
            <section class="mb-12 rounded-3xl border border-[#FCD116]/15 bg-[linear-gradient(135deg,rgba(252,209,22,0.08),rgba(255,255,255,0.03))] p-6 sm:p-8">
              <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
                <div class="max-w-2xl">
                  <p class="text-xs font-mono uppercase tracking-[0.3em] text-[#FCD116]">Ultimo release</p>
                  <h2 class="mt-3 text-3xl font-black text-[#F5F5DC]">{latestPost.data.title}</h2>
                  {latestPost.data.description && <p class="mt-3 text-white/75 leading-relaxed">{latestPost.data.description}</p>}
                </div>
                <a href={`/novedades/${latestPost.id}`} class="rounded-xl bg-[#FCD116] px-5 py-3 text-sm font-bold text-black transition hover:bg-yellow-400">
                  Leer novedad
                </a>
              </div>
            </section>
          )}

          <div class="space-y-8">
            {featuredPosts.map((post, index) => (
              <article class="bg-white/5 border border-white/10 rounded-2xl p-6 sm:p-8 hover:bg-white/10 transition-colors" data-sr="fade-up" data-sr-delay={index * 100}>
                <div class="flex items-center gap-4 text-sm text-white/50 mb-3 font-mono">
                  <time datetime={post.data.date.toISOString()}>
                    {post.data.date.toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                  <span>•</span>
                  <span>{post.data.author}</span>
                </div>
                <h2 class="text-2xl font-bold text-[#F5F5DC] mb-3">
                  <a href={`/novedades/${post.id}`} class="hover:underline">{post.data.title}</a>
                </h2>
                {post.data.description && <p class="text-white/80 mb-6 leading-relaxed">{post.data.description}</p>}
              </article>
            ))}
          </div>
        </>
      ) : (
        <TenantRouteNotice country={country} availability={availability} ctaHref="/changelog" ctaLabel="Ver estado del producto" />
      )}
    </div>
  </div>
</Layout>
