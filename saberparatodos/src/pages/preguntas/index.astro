---
import Layout from '../../layouts/Layout.astro';
import BundleList from '../../components/preguntas/BundleList.svelte';
import BundleSearchBar from '../../components/preguntas/BundleSearchBar.svelte';
import {
  getAllBundles,
  bundleUrl,
  getCountryDisplay,
  type BundleEntry,
} from '../../lib/preguntas/bundle-fetcher';
import { t } from '../../lib/i18n';

const entries: BundleEntry[] = await getAllBundles();

const countrySlugs = [...new Set(entries.map((e) => e.country))].sort();
const countries = countrySlugs.map((slug) => {
  const display = getCountryDisplay(slug);
  return { slug, name: display.name, flag: display.flag };
});

const gradeSets = new Map<string, Set<string>>();
const subjectSets = new Map<string, Set<string>>();
for (const e of entries) {
  if (!gradeSets.has(e.country)) gradeSets.set(e.country, new Set());
  gradeSets.get(e.country)!.add(e.gradeSlug);
  const subjKey = `${e.country}/${e.gradeSlug}`;
  if (!subjectSets.has(subjKey)) subjectSets.set(subjKey, new Set());
  subjectSets.get(subjKey)!.add(e.subject);
}
const gradesByCountry: Record<string, string[]> = Object.fromEntries(
  [...gradeSets].map(([k, v]) => [
    k,
    [...v].sort((a, b) => (Number(a.match(/\d+/)?.[0] ?? 0) || 99) - (Number(b.match(/\d+/)?.[0] ?? 0) || 99)),
  ])
);
const subjectsByKey: Record<string, string[]> = Object.fromEntries(
  [...subjectSets].map(([k, v]) => [k, [...v].sort()])
);

const query = (Astro.url.searchParams.get('q') ?? '').trim().toLowerCase();
const matched = query
  ? entries.filter(
      (e) =>
        e.tema.toLowerCase().includes(query) ||
        e.subject.toLowerCase().includes(query) ||
        e.id.toLowerCase().includes(query)
    )
  : entries.slice(0, 60);

const toListItem = (e: BundleEntry) => {
  const display = getCountryDisplay(e.country);
  return {
    id: e.id,
    country: e.country,
    countryName: display.name,
    flag: display.flag,
    subject: e.subject,
    gradeSlug: e.gradeSlug,
    grade: e.grade,
    week: e.week,
    tema: e.tema,
    total: e.total,
    url: bundleUrl(e),
  };
};

const listItems = matched.map(toListItem);

const siteUrl = String(Astro.site ?? 'https://saberparatodos.space').replace(/\/+$/, '');
const canonical = `${siteUrl}/preguntas/`;
const pageTitle = query
  ? `${t('preguntas.search.submit')}: “${query}” — ${t('preguntas.title')}`
  : t('preguntas.title');
---

<Layout title={pageTitle} description={t('preguntas.description')}>
  <link slot="head" rel="canonical" href={canonical} />
  <div class="min-h-screen bg-[#0f172a] text-white">
    <main class="max-w-6xl mx-auto px-4 py-10">
      <header class="text-center max-w-3xl mx-auto mb-10">
        <span class="inline-block px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono uppercase tracking-wider mb-3">
          {t('preguntas.breadcrumb.preguntas')} · WorldExams
        </span>
        <h1 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight">{t('preguntas.title')}</h1>
        <p class="text-slate-300 mt-3 text-base">{t('preguntas.description')}</p>
      </header>

      <div class="mb-10">
        <BundleSearchBar
          client:load
          countries={countries}
          gradesByCountry={gradesByCountry}
          subjectsByKey={subjectsByKey}
          initialQuery={query}
        />
      </div>

      <section class="mb-10">
        <h2 class="text-xl font-bold text-white mb-4">{t('preguntas.search.country')} ({countries.length})</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
          {countries.map((c) => (
            <a
              href={`/preguntas/${c.slug}/`}
              class="group bg-slate-800/60 hover:bg-slate-800 border border-slate-700/60 hover:border-emerald-500/50 px-4 py-3 rounded-xl transition flex items-center gap-2 text-sm font-semibold text-white"
            >
              <span class="text-xl">{c.flag}</span>
              <span class="group-hover:text-emerald-300 transition">{c.name}</span>
            </a>
          ))}
        </div>
      </section>

      <BundleList
        client:load
        bundles={listItems}
        showCountry={!query}
        label={query ? `${t('preguntas.results')}: ${query}` : t('preguntas.bundles')}
      />

      <p class="text-xs text-slate-500 mt-8 text-center">
        {entries.length} {t('preguntas.bundles')} · 2026 weekly · protocolo v5.2
      </p>
    </main>
  </div>
</Layout>
