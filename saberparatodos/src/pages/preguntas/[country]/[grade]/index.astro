---
import Layout from '../../../../layouts/Layout.astro';
import BundleList from '../../../../components/preguntas/BundleList.svelte';
import {
  getAllBundles,
  findCountryBundles,
  findGradeBundles,
  gradeBundlesToGradeSlugs,
  bundleUrl,
  getCountryDisplay,
  normalizeGradeSlug,
  findBundleById,
  toTitleCase,
  type BundleEntry,
} from '../../../../lib/preguntas/bundle-fetcher';
import { t } from '../../../../lib/i18n';

export const getStaticPaths = async () => {
  const entries = await getAllBundles();
  const pairs = new Set<string>();
  for (const e of entries) pairs.add(`${e.country}/${e.gradeSlug}`);
  return [...pairs].map((key) => {
    const [country, grade] = key.split('/');
    return { params: { country, grade } };
  });
};

export const fallback = true;

const { country, grade } = Astro.params;
const entries = await getAllBundles();
const countryBundles = findCountryBundles(entries, country ?? '');

if (!countryBundles.length) {
  const asBundle = country ? await findBundleById(entries, country) : undefined;
  if (asBundle) return Astro.redirect(bundleUrl(asBundle), 301);
  return Astro.redirect('/preguntas/', 302);
}

let bundles = findGradeBundles(entries, country!, grade!);

// Compatibilidad con URLs legacy /preguntas/{pais}/{materia}/ (sin grado)
if (!bundles.length && grade) {
  const legacySubject = countryBundles.find((e) => e.subject === grade.toLowerCase());
  if (legacySubject) {
    const firstGrade = gradeBundlesToGradeSlugs(
      countryBundles.filter((e) => e.subject === grade.toLowerCase())
    )[0];
    return Astro.redirect(`/preguntas/${country}/${firstGrade}/${grade.toLowerCase()}/`, 301);
  }
  return Astro.redirect(`/preguntas/${country}/`, 302);
}

const display = getCountryDisplay(country!);
const gradeNum = normalizeGradeSlug(grade ?? '')?.match(/(\d+)/)?.[1] ?? grade;
const gradeName = bundles[0]?.grade != null ? `Grado ${bundles[0].grade}` : toTitleCase(grade ?? '');
const subjects = [...new Set(bundles.map((b) => b.subject))].sort();
const totalQuestions = bundles.reduce((acc, b) => acc + (b.total || 0), 0);

const toListItem = (e: BundleEntry) => ({
  id: e.id,
  country: e.country,
  subject: e.subject,
  gradeSlug: e.gradeSlug,
  grade: e.grade,
  week: e.week,
  tema: e.tema,
  total: e.total,
  url: bundleUrl(e),
});

const siteUrl = String(Astro.site ?? 'https://saberparatodos.space').replace(/\/+$/, '');
const canonical = `${siteUrl}/preguntas/${country}/${grade}/`;
const pageTitle = `${display.name} ${gradeName} (${gradeNum}) — Preguntas por Materia | WorldExams`;
const pageDescription = `${bundles.length} bundles (${totalQuestions} preguntas) de ${display.name} en ${gradeName}, organizados por materia${display.examName ? ` y alineados al ${display.examName}` : ''}.`;

Astro.response.headers.set('Cache-Control', 'public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400');
---

<Layout title={pageTitle} description={pageDescription}>
  <link slot="head" rel="canonical" href={canonical} />
  <meta slot="head" property="og:title" content={pageTitle} />
  <meta slot="head" property="og:description" content={pageDescription} />

  <div class="min-h-screen bg-[#0f172a] text-white">
    <nav aria-label="breadcrumb" class="border-b border-white/10 bg-slate-900/50">
      <ol class="max-w-6xl mx-auto px-4 py-3 flex flex-wrap gap-2 text-sm text-white/60">
        <li><a href="/" class="hover:text-white transition">{t('preguntas.breadcrumb.home')}</a></li>
        <li>/</li>
        <li><a href="/preguntas/" class="hover:text-white transition">{t('preguntas.breadcrumb.preguntas')}</a></li>
        <li>/</li>
        <li><a href={`/preguntas/${country}/`} class="hover:text-white transition">{display.flag} {display.name}</a></li>
        <li>/</li>
        <li class="text-emerald-400 font-semibold" aria-current="page">{gradeName}</li>
      </ol>
    </nav>

    <main class="max-w-6xl mx-auto px-4 py-8">
      <header class="mb-8">
        <h1 class="text-3xl font-extrabold text-white">{display.name} — {gradeName}</h1>
        <p class="text-slate-300 text-sm mt-2">{pageDescription}</p>
      </header>

      <section class="mb-8">
        <h2 class="text-lg font-bold text-white mb-3">{t('preguntas.subject')} ({subjects.length})</h2>
        <ul class="flex flex-wrap gap-2 list-none p-0 m-0">
          {subjects.map((s) => (
            <li>
              <a
                href={`/preguntas/${country}/${grade}/${s}/`}
                class="inline-block bg-slate-800/70 hover:bg-slate-800 border border-slate-700 hover:border-emerald-500/50 px-4 py-2 rounded-xl text-sm font-semibold text-white transition"
              >{toTitleCase(s)}</a>
            </li>
          ))}
        </ul>
      </section>

      <BundleList client:load bundles={bundles.map(toListItem)} label={`${t('preguntas.bundles')} — ${gradeName}`} />
    </main>
  </div>
</Layout>
