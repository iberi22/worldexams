---
import Layout from '../layouts/Layout.astro';
import TenantRouteNotice from '../components/TenantRouteNotice.astro';
import { resolveRuntimeCountryConfig } from '../config';
import { getTenantRouteAvailability } from '../config/tenant-experience';

const country = resolveRuntimeCountryConfig(Astro.locals.country);
const availability = getTenantRouteAvailability(country, 'changelog');

const releases = [
  {
    version: 'v0.14.x',
    date: '2026-05-09',
    status: 'Multi-country hotfix',
    summary: 'Aislamiento editorial por tenant, endurecimiento del runtime y validacion multi-pais.'
  },
  {
    version: 'v0.13.1',
    date: '2026-04-15',
    status: 'MEN Release',
    summary: 'Lineamientos MEN y mejoras de lectura para Colombia.'
  },
  {
    version: 'v0.10.0',
    date: '2026-03-10',
    status: 'Protocol Update',
    summary: 'Base de release del monorepo privado y tracking formal de features.'
  }
];
---

<Layout title={`Changelog | ${country.product.siteName}`} description={`Historial de versiones para ${country.product.siteName}.`}>
  <div class="min-h-screen bg-[#121212] py-16 px-4">
    <div class="max-w-4xl mx-auto">
      {country.code === 'CO' ? (
        <>
          <section class="mb-16 pt-8 pb-4 text-center">
            <span class="inline-block px-3 py-1 text-xs font-mono tracking-widest uppercase bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 rounded-full mb-6">
              Historial de versiones
            </span>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-[#F5F5DC] mb-6">Changelog</h1>
            <p class="text-xl text-white/60 max-w-2xl mx-auto">
              Registro ordenado de las actualizaciones de producto.
            </p>
          </section>

          <div class="space-y-6">
            {releases.map((release) => (
              <article class="rounded-2xl border border-white/10 bg-white/5 p-6">
                <div class="flex flex-wrap items-center gap-3">
                  <h2 class="text-2xl font-bold text-[#F5F5DC] font-mono tracking-tight">{release.version}</h2>
                  <span class="px-2 py-0.5 rounded text-xs font-semibold border uppercase tracking-wider bg-emerald-500/10 text-emerald-300 border-emerald-500/20">
                    {release.status}
                  </span>
                  <time class="text-sm text-white/40 font-mono ml-auto">
                    {new Date(release.date + 'T00:00:00').toLocaleDateString('es-CO', { year: 'numeric', month: 'short', day: 'numeric' })}
                  </time>
                </div>
                <p class="mt-4 text-white/75 leading-relaxed">{release.summary}</p>
              </article>
            ))}
          </div>
        </>
      ) : (
        <TenantRouteNotice country={country} availability={availability} ctaHref="/guia-examen" />
      )}
    </div>
  </div>
</Layout>
