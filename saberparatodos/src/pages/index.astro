---
import Layout from '../layouts/Layout.astro';
import App from '../components/App.svelte';
import { resolveRuntimeCountryConfig } from '../config';
import { getTenantExperience } from '../config/tenant-experience';

const runtimeCountry = resolveRuntimeCountryConfig(Astro.locals.country);
const tenantExperience = getTenantExperience(runtimeCountry);
---

<Layout
  title={`Zona de Practica ${runtimeCountry.examName} | ${runtimeCountry.product.siteName}`}
  description={`Accede a la app de practica de ${runtimeCountry.product.siteName} para crear simulacros, entrenar por areas y revisar resultados para ${runtimeCountry.examFullName}.`}
  keywords={`practicar examenes, simulacros gratis, preguntas ${runtimeCountry.examName.toLowerCase()}, ${runtimeCountry.examAuthority.toLowerCase()}, ${runtimeCountry.name.toLowerCase()}`}
  showNavbar={false}
  showFooter={false}
>
  <div id="mobile-hero" class="static-content group/hero fixed inset-0 z-[100] bg-[#0A0A0B]/95 backdrop-blur-md flex flex-col justify-center items-center transition-opacity duration-1000">
    <button id="hero-close-btn" class="absolute top-6 right-6 w-10 h-10 flex items-center justify-center bg-white/10 rounded-full text-white/70 hover:text-white transition-colors border border-white/20 shadow-lg z-50">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <section class="min-h-[70vh] flex flex-col items-center justify-center px-4 relative overflow-hidden w-full">
      <div class="absolute inset-0 bg-[#0A0A0B] -z-10 md:hidden"></div>
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-6xl h-full bg-emerald-500/5 blur-[120px] rounded-full -z-10"></div>

      <div class="w-full max-w-4xl mx-auto flex flex-col items-center text-center mt-0 md:mt-0 relative z-10 transition-transform duration-700 translate-y-4 opacity-0 animate-[fade-in-up_0.8s_ease-out_forwards]">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-mono mb-8 uppercase tracking-widest">
          {runtimeCountry.examAuthority} 2026 • {tenantExperience.freeAccessLabel.toLowerCase()}
        </div>

        <h1 class="text-4xl md:text-7xl font-black text-[#F5F5DC] mb-6 tracking-tight drop-shadow-md text-center w-full">
          Domina {runtimeCountry.examName} con <br class="md:hidden" /><span class="text-emerald-500">Inteligencia</span>
        </h1>

        <p class="text-lg md:text-xl text-white/60 mb-12 max-w-2xl text-center leading-relaxed px-4 md:px-0">
          {tenantExperience.landingDescription} Crea simulacros personalizados, entrena por areas y preparate para {runtimeCountry.examFullName}.
        </p>

        <div class="flex flex-col items-center justify-center gap-4 mt-8">
          <div class="flex items-center justify-center gap-2 text-xs font-mono text-emerald-500/50 uppercase tracking-widest animate-pulse">
            <span>Iniciando plataforma</span>
            <span id="countdown-timer" class="text-white font-bold ml-1">4s</span>
            <span class="flex space-x-1 ml-1">
              <span class="w-1 h-1 bg-emerald-500 rounded-full animate-bounce" style="animation-delay: 0ms"></span>
              <span class="w-1 h-1 bg-emerald-500 rounded-full animate-bounce" style="animation-delay: 150ms"></span>
              <span class="w-1 h-1 bg-emerald-500 rounded-full animate-bounce" style="animation-delay: 300ms"></span>
            </span>
          </div>

          <label class="flex items-center gap-2 text-xs text-white/40 hover:text-white/80 cursor-pointer transition-colors mt-2 bg-white/5 px-3 py-1.5 rounded-full border border-white/10">
            <input type="checkbox" id="dont-show-hero" class="rounded bg-black/50 border-white/20 text-emerald-500 focus:ring-emerald-500/30">
            <span>No volver a mostrar</span>
          </label>
        </div>
      </div>
    </section>

    <noscript>
      <div class="p-8 text-center bg-red-500/10 border border-red-500/20 rounded-xl my-4 mx-auto max-w-xl text-red-400">
        Esta aplicacion requiere JavaScript para funcionar. Por favor, activalo en tu navegador para realizar tus simulacros.
      </div>
    </noscript>
  </div>

  <style>
    @keyframes fade-in-up {
      0% {
        opacity: 0;
        transform: translateY(20px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const hero = document.getElementById("mobile-hero");
      const countdownEl = document.getElementById("countdown-timer");
      const dontShowCheckbox = document.getElementById("dont-show-hero");

      if (!hero) return;

      if (localStorage.getItem("spt_hide_hero") === "true") {
        hero.style.display = "none";
        return;
      }

      let timeLeft = 4;
      let timerId: ReturnType<typeof setInterval> | undefined;

      const hideHero = () => {
        if (dontShowCheckbox && (dontShowCheckbox as HTMLInputElement).checked) {
          localStorage.setItem("spt_hide_hero", "true");
        }
        if (timerId) clearInterval(timerId);
        hero.style.opacity = "0";
        hero.style.pointerEvents = "none";
        setTimeout(() => {
          hero.style.display = "none";
        }, 1000);
      };

      const closeBtn = document.getElementById("hero-close-btn");
      if (closeBtn) closeBtn.addEventListener("click", hideHero);

      timerId = setInterval(() => {
        timeLeft -= 1;
        if (countdownEl) {
          countdownEl.textContent = timeLeft + "s";
        }
        if (timeLeft <= 0) {
          hideHero();
        }
      }, 1000);
    });
  </script>

  <App
    client:only="svelte"
    questions={[]}
    universalPool={null}
    countryCode={runtimeCountry.code}
    runtimeCountry={runtimeCountry}
  />
</Layout>
