---
import Layout from '../layouts/Layout.astro';

const title = 'Simulacro ICFES y Pruebas Saber Gratis en Colombia | SaberParaTodos';
const description = 'Practica preguntas ICFES, simulacros Pruebas Saber 11 y preparación gratuita para Colombia. Entrena por áreas, revisa explicaciones y mejora tu nivel.';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '¿SaberParaTodos sirve para practicar ICFES y Pruebas Saber gratis?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Sí. SaberParaTodos ofrece práctica gratuita con preguntas por áreas, simulacros y guías para estudiantes de Colombia.'
      }
    },
    {
      '@type': 'Question',
      name: '¿Qué puedo practicar en SaberParaTodos?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Puedes practicar lectura crítica, matemáticas, ciencias naturales, sociales y ciudadanas e inglés con sesiones de estudio y simulacros.'
      }
    },
    {
      '@type': 'Question',
      name: '¿SaberParaTodos está afiliado al ICFES?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Es una plataforma independiente de práctica educativa basada en información pública y diseñada para ayudar a estudiantes de Colombia.'
      }
    }
  ]
};

const highlights = [
  'Simulacro ICFES gratis con práctica por áreas',
  'Preguntas tipo Pruebas Saber con explicación',
  'Guías de preparación y rutas de estudio',
  'Acceso gratuito desde celular o computador'
];

const featuredLinks = [
  {
    href: '/simulacro-icfes',
    title: 'Simulacro ICFES Gratis',
    description: 'Landing enfocada en práctica, FAQs y sesión de simulacro para Saber 11.',
    icon: '🎯'
  },
  {
    href: '/practica',
    title: 'Banco de Preguntas',
    description: 'Práctica por área para reforzar lectura crítica, matemáticas, ciencias y más.',
    icon: '📚'
  },
  {
    href: '/preuniversitario',
    title: 'Preuniversitario',
    description: 'Ruta para estudiantes que también buscan simulacros de admisión universitaria.',
    icon: '🏛️'
  },
  {
    href: '/guia-examen',
    title: 'Guía Orientación 2026',
    description: 'Conoce la estructura oficial, competencias evaluadas y cronograma 2025-2026.',
    icon: '🧭'
  }
];
---

<Layout title={title} description={description} keywords="simulacro icfes gratis, pruebas saber gratis, preguntas icfes, preicfes gratis, examenes gratis colombia">
  <div class="min-h-screen background text-foreground relative overflow-hidden flex flex-col">
    <div class="hero-gradient"></div>

    <!-- Particles -->
    <div class="particles h-full">
      <div class="particle particle-1"></div>
      <div class="particle particle-2"></div>
      <div class="particle particle-3"></div>
    </div>

    <!-- Hero Section -->
    <section class="relative pt-24 pb-16 px-4 z-10">
      <div class="container max-w-5xl">
        <div class="flex flex-col items-center text-center">
          <span class="inline-block px-3 py-1 text-[10px] font-mono tracking-widest uppercase bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 rounded-full mb-8 animate-fade-in-up">
            🇨🇴 Plataforma Open Source para Colombia
          </span>

          <h1 class="text-4xl md:text-7xl font-black mb-8 animate-fade-in-up animate-fade-in-up-delay-1 tracking-tighter leading-[0.9]">
            Simulacro ICFES <br/>
            <span class="text-white/40">SaberParaTodos</span>
          </h1>

          <p class="text-lg md:text-xl text-white/60 max-w-2xl mx-auto animate-fade-in-up animate-fade-in-up-delay-2 leading-relaxed mb-10">
            La plataforma de práctica gratuita para estudiantes colombianos que buscan
            <span class="text-emerald-400/80 font-bold">mejores resultados</span> en las Pruebas Saber 11.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-4 animate-fade-in-up animate-fade-in-up-delay-3">
            <a href="/practica" class="px-8 py-4 bg-emerald-500 text-black font-black uppercase tracking-widest text-sm rounded-xl hover:bg-emerald-400 hover:scale-105 transition-all shadow-xl shadow-emerald-500/20">
              Empezar Práctica →
            </a>
            <a href="/guia-examen" class="px-8 py-4 glass text-white/80 font-bold uppercase tracking-widest text-sm rounded-xl hover:bg-white/5 transition-all">
              Guía de Examen
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Highlights Row -->
    <section class="relative py-12 px-4 z-10 border-y border-white/5 bg-white/[0.01]">
      <div class="container max-w-6xl">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {highlights.map((highlight, i) => (
            <div class="flex items-center gap-3" data-sr="fade-up" data-sr-delay={i * 100}>
              <div class="w-2 h-2 rounded-full bg-emerald-500 shadow-[0_0_8px_#10b981]"></div>
              <span class="text-xs font-bold uppercase tracking-wider text-white/40 leading-tight">
                {highlight}
              </span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Key Routes Grid -->
    <section class="relative py-20 px-4 z-10">
      <div class="container max-w-6xl">
        <div class="text-center mb-16" data-sr="fade-up">
          <p class="text-[10px] font-mono tracking-[0.2em] text-emerald-400 uppercase mb-4">Explora la plataforma</p>
          <h2 class="text-3xl md:text-4xl font-black tracking-tight">Recursos Gratuitos Disponibles</h2>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {featuredLinks.map((link, i) => (
            <a href={link.href} class="group block p-8 glass rounded-3xl border-transparent hover:border-emerald-500/30 transition-all hover:-translate-y-2" data-sr="fade-up" data-sr-delay={i * 100}>
              <div class="text-3xl mb-6 group-hover:scale-110 transition-transform inline-block">
                {link.icon}
              </div>
              <h3 class="text-xl font-bold mb-3 group-hover:text-emerald-400 transition-colors">{link.title}</h3>
              <p class="text-sm text-white/50 leading-relaxed">
                {link.description}
              </p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Info Section -->
    <section class="relative py-24 px-4 z-10 border-t border-white/5 overflow-hidden">
      <div class="container max-w-6xl">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div data-sr="fade-right">
            <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest mb-6 block font-mono">
              Independencia & Calidad
            </span>
            <h2 class="text-3xl md:text-4xl font-black mb-8 tracking-tight">
              Diseñado para el estudiante <br/>
              <span class="text-white/40 uppercase text-2xl md:text-3xl">Del siglo XXI</span>
            </h2>
            <p class="text-white/60 text-lg leading-relaxed mb-6">
              Si estás buscando <strong>ICFES gratis</strong>, <strong>pruebas Saber gratis</strong>,
              <strong>preguntas ICFES</strong> o <strong>preicfes</strong>, esta plataforma reúne una experiencia
              simple: practicar, revisar errores y volver a intentar con mejor criterio.
            </p>
            <p class="text-white/60 text-lg leading-relaxed">
              El enfoque principal es Colombia. Por eso priorizamos contenidos y rutas de práctica para
              Saber 11, junto con herramientas modernas de análisis de rendimiento.
            </p>
          </div>

          <div class="relative" data-sr="fade-left">
            <div class="absolute -inset-1 bg-gradient-to-r from-emerald-500/20 to-blue-500/20 rounded-[2.5rem] blur-2xl"></div>
            <div class="glass p-10 rounded-[2rem] relative border-emerald-500/20">
              <p class="text-xs font-bold text-white/30 uppercase tracking-[0.2em] mb-8 font-mono">
                Áreas de Evaluación
              </p>
              <div class="space-y-4">
                {[
                  { name: 'Lectura Crítica', color: 'bg-emerald-500' },
                  { name: 'Matemáticas', color: 'bg-blue-500' },
                  { name: 'Sociales y Ciudadanas', color: 'bg-amber-500' },
                  { name: 'Ciencias Naturales', color: 'bg-indigo-500' },
                  { name: 'Inglés', color: 'bg-rose-500' }
                ].map((area) => (
                  <div class="flex items-center gap-4 group cursor-default">
                    <div class={`w-3 h-3 rounded-full ${area.color} shadow-lg opacity-60 group-hover:opacity-100 transition-opacity`}></div>
                    <span class="text-lg font-bold text-white/80 group-hover:text-white transition-colors">{area.name}</span>
                  </div>
                ))}
              </div>
              <div class="mt-10 pt-8 border-t border-white/5">
                <p class="text-[10px] text-white/30 leading-relaxed italic">
                  * SaberParaTodos es una plataforma independiente. No está afiliada oficialmente al ICFES.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="relative py-24 px-4 z-10 border-t border-white/5 bg-gradient-to-b from-transparent to-emerald-500/[0.02]">
      <div class="container max-w-3xl">
        <div class="text-center mb-16" data-sr="fade-up">
          <h2 class="text-3xl font-black tracking-tight">Preguntas Frecuentes</h2>
        </div>

        <div class="space-y-4">
          {[
            {
              q: '¿Aquí puedo hacer un simulacro ICFES gratis?',
              a: 'Sí. Puedes entrar a la zona de práctica y empezar una sesión gratuita desde la sección de simulacro.'
            },
            {
              q: '¿Sirve para estudiantes de Grado 11?',
              a: 'Sí. La plataforma está optimizada para el examen Nacional Saber 11, con preguntas adaptadas a la estructura oficial.'
            },
            {
              q: '¿Tienen material para preuniversitario?',
              a: 'Sí. El módulo Preuniversitario Colombia organiza la investigación y simulación de exámenes de admisión universitaria.'
            }
          ].map((faq, i) => (
            <details class="group glass rounded-2xl border-white/5 hover:border-emerald-500/30 transition-all" data-sr="fade-up" data-sr-delay={i * 100}>
              <summary class="p-6 cursor-pointer font-bold text-white/80 group-open:text-emerald-400 transition-colors list-none flex justify-between items-center">
                {faq.q}
                <span class="transition-transform group-open:rotate-180">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <div class="px-6 pb-6 text-white/60 leading-relaxed text-sm">
                {faq.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="relative py-32 px-4 z-10 border-t border-white/5">
      <div class="container max-w-4xl text-center" data-sr="zoom-in">
        <h2 class="text-4xl md:text-5xl font-black mb-8 tracking-tighter leading-none">
          Únete a miles de <br/>
          estudiantes colombianos
        </h2>
        <p class="text-white/60 mb-12 text-lg">
          Sin registros complejos, sin costos ocultos. Solo práctica real.
        </p>
        <a href="/practica" class="inline-block px-12 py-5 bg-emerald-500 text-black font-black uppercase tracking-widest text-sm rounded-2xl hover:bg-emerald-400 hover:scale-105 transition-all shadow-2xl shadow-emerald-500/20">
          Comenzar ahora →
        </a>
      </div>
    </section>
  </div>
</Layout>

<script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

<style>
  /* Base background that complements hero-gradient */
  .background {
    background: #0a0a0f;
  }

  /* Custom detail summary hiding arrow */
  details summary::-webkit-details-marker {
    display: none;
  }
</style>
