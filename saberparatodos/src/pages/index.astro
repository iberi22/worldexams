---
import Layout from '../layouts/Layout.astro';
import App from '../components/App.svelte';

const API_BASE_URL = '/api';
---

<Layout
  title="Zona de Práctica ICFES | SaberParaTodos"
  description="Accede a la app de práctica de SaberParaTodos para crear simulacros, entrenar por áreas y revisar resultados."
  keywords="practicar icfes, app icfes, simulacro saber 11, preguntas icfes"
  showNavbar={false}
  showFooter={false}
>
  <script is:inline type="application/json" id="api-config" set:html={JSON.stringify({ apiBaseUrl: API_BASE_URL })} />

  <!-- 🚀 SSR Static Hero (Visible to bots and while Svelte loads) -->
  <div id="mobile-hero" class="static-content group/hero fixed inset-0 z-[100] bg-[#0A0A0B]/95 backdrop-blur-md flex flex-col justify-center items-center transition-opacity duration-1000 md:static md:bg-transparent md:block md:z-auto">
    <!-- Botón Cerrar (Solo en móvil) -->
    <button id="close-hero" class="md:hidden absolute top-6 right-6 w-10 h-10 flex items-center justify-center bg-white/10 rounded-full text-white/70 hover:text-white transition-colors border border-white/20 shadow-lg z-50">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    
    <section class="min-h-[70vh] flex flex-col items-center justify-center px-4 relative overflow-hidden w-full">
      <!-- Background elements similar to the app for visual continuity -->
      <div class="absolute inset-0 bg-[#0A0A0B] -z-10 md:hidden"></div>
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-6xl h-full bg-emerald-500/5 blur-[120px] rounded-full -z-10"></div>

      <div class="max-w-4xl mx-auto text-center mt-12 md:mt-0 relative z-10 transition-transform duration-700 translate-y-4 opacity-0 animate-[fade-in-up_0.8s_ease-out_forwards]">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-mono mb-8 uppercase tracking-widest">
          Simulacros 2026 • gratis
        </div>

        <h1 class="text-4xl md:text-7xl font-black text-[#F5F5DC] mb-6 tracking-tight drop-shadow-md">
          Domina el ICFES con <br class="md:hidden" /><span class="text-emerald-500">Inteligencia</span>
        </h1>

        <p class="text-lg md:text-xl text-white/60 mb-12 max-w-2xl mx-auto leading-relaxed px-4 md:px-0">
          La plataforma gratuita y de código abierto para estudiantes de Colombia. Crea simulacros personalizados, entrena por áreas y prepárate para los mejores resultados.
        </p>

        <!-- Indicador de tiempo para móvil -->
        <div class="md:hidden flex items-center justify-center gap-2 text-xs font-mono text-emerald-500/50 uppercase tracking-widest mt-8 animate-pulse">
          <span>Iniciando plataforma</span>
          <span class="flex space-x-1">
            <span class="w-1 h-1 bg-emerald-500 rounded-full animate-bounce" style="animation-delay: 0ms"></span>
            <span class="w-1 h-1 bg-emerald-500 rounded-full animate-bounce" style="animation-delay: 150ms"></span>
            <span class="w-1 h-1 bg-emerald-500 rounded-full animate-bounce" style="animation-delay: 300ms"></span>
          </span>
        </div>
      </div>
    </section>

    <!-- Noscript fallback for AdSense compliance -->
    <noscript>
      <div class="p-8 text-center bg-red-500/10 border border-red-500/20 rounded-xl my-4 mx-auto max-w-xl text-red-400">
        Esta aplicación requiere JavaScript para funcionar. Por favor, actívalo en tu navegador para realizar tus simulacros.
      </div>
    </noscript>
  </div>

  <style>
    @keyframes fade-in-up {
      0% {
        opacity: 0;
        transform: translateY(20px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const hero = document.getElementById("mobile-hero");
      const closeBtn = document.getElementById("close-hero");
      
      if (!hero) return;

      const isMobile = window.innerWidth < 768; // `md` breakpoint en Tailwind
      
      const hideHero = () => {
        hero.style.opacity = "0";
        setTimeout(() => {
          hero.style.display = "none";
        }, 1000); // 1s wait para la transición css
      };

      if (isMobile) {
        // En móvil, desaparece auto después de 4s o con botón
        if (closeBtn) closeBtn.addEventListener("click", hideHero);
        setTimeout(hideHero, 4000); // 4 segundos
      }
    });
  </script>

  <App
    client:only="svelte"
    questions={[]}
    universalPool={null}
  />
</Layout>
