---
import Layout from '../../layouts/Layout.astro';
import NeuroGymApp from '../../components/neurogym/NeuroGymApp.svelte';

const title = "NeuroGym - Entrenamiento de atención y memoria de trabajo";
const description = "Entrenamiento de atención, memoria de trabajo y velocidad de procesamiento con juegos adaptativos, práctica guiada e historial guardado en tu dispositivo.";
---

<Layout title={title} description={description}>
  <main class="min-h-screen bg-[#070707] text-white pt-8 pb-20 px-4 sm:px-6">
    <NeuroGymApp client:load />
  </main>
</Layout>
