---
/**
 * estudio.astro — WX-202 Estudio de generación: PDF → RAG → preguntas v5.2 → export .md
 * Isla: solo este archivo + src/components/studio/**
 * Orquestación client-side: upload → lib/ai/pdf.parsePDF → chunker → top 5 → web-llm → QuestionEditor → ExportButton
 * Nunca auto-publica a questions_data/ (marca creador: local-llm, descarga draft).
 */
import Layout from '../layouts/Layout.astro';
import UploadWidget from '../components/studio/UploadWidget.astro';
import QuestionEditor from '../components/studio/QuestionEditor.astro';
import ExportButton from '../components/studio/ExportButton.astro';
---

<Layout
  title="Estudio — Genera preguntas desde PDF (RAG local) | SaberParaTodos"
  description="Sube un PDF, extrae chunks con RAG, genera 10 preguntas v5.2 con IA local (web-llm) y exporta un .md canónico."
  noindex={true}
>
  <div class="min-h-screen bg-[#0e0e12] text-white">
    <!-- Header -->
    <div class="border-b border-white/5 bg-gradient-to-b from-white/[0.05] to-transparent">
      <div class="mx-auto max-w-6xl px-4 py-8 md:py-10">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <span class="inline-flex items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-500/10 px-3 py-1 text-[11px] font-mono uppercase tracking-[0.2em] text-emerald-300">
              <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span> Estudio local · RAG
            </span>
            <h1 class="mt-3 text-3xl md:text-4xl font-black tracking-tight text-[#F5F5DC]">Estudio de generación</h1>
            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-white/60">
              1) Sube un PDF → 2) ingesta <code class="text-white/80">lib/ai/pdf</code> (chunk + RAG top 5) → 3) LLM local <code class="text-white/80">web-llm</code> genera 10 preguntas v5.2 →
              4) edita en vivo → 5) exporta <code class="text-white/80">.md</code> canónico con <code class="text-white/80">creador: local-llm</code>. Nada se publica solo.
            </p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-xs leading-relaxed text-white/60 max-w-xs">
            <p class="font-semibold text-white/80">Flujo E2E</p>
            <ol class="mt-1 list-decimal list-inside space-y-0.5">
              <li>PDF → <code>parsePDF</code></li>
              <li>chunker (800c / 120 overlap) → top 5 RAG</li>
              <li>prompt con <code>COUNTRY_RULE_HINTS</code> + <code>validateLocalQuestion</code></li>
              <li>Edición → <code>ExportButton</code> .md</li>
            </ol>
          </div>
        </div>
      </div>
    </div>

    <div class="mx-auto max-w-6xl px-4 py-8 space-y-8">
      <!-- Step 1: Upload -->
      <section class="rounded-2xl border border-white/10 bg-white/[0.04] p-5 md:p-6">
        <div class="flex items-center gap-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white text-sm font-black text-black">1</span>
          <h2 class="text-base font-bold">Sube tu PDF</h2>
          <span class="ml-auto hidden md:inline text-xs text-white/40">Se procesa 100% en tu navegador (no se sube al servidor)</span>
        </div>
        <div class="mt-5">
          <UploadWidget />
        </div>
        <div id="rag-preview" class="mt-4 hidden rounded-xl border border-white/5 bg-black/20 p-4">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-white/60">Chunks RAG (top 5)</h3>
            <span id="rag-stats" class="text-xs text-white/40"></span>
          </div>
          <div id="rag-chunks" class="mt-3 grid gap-2"></div>
        </div>
        <div id="parse-status" class="mt-3 hidden rounded-lg border border-white/10 bg-black/20 px-3 py-2 text-xs text-white/60"></div>
      </section>

      <!-- Step 2: Generate -->
      <section class="rounded-2xl border border-white/10 bg-white/[0.04] p-5 md:p-6">
        <div class="flex flex-wrap items-center gap-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white text-sm font-black text-black">2</span>
          <h2 class="text-base font-bold">Generar preguntas v5.2</h2>
          <div class="ml-auto flex flex-wrap items-center gap-2">
            <label class="text-xs text-white/50">N</label>
            <select id="gen-count" class="rounded-xl border border-white/10 bg-black/30 px-3 py-2 text-sm text-white">
              <option value="8">8 (G3-G5)</option>
              <option value="10" selected>10 (G6-G7)</option>
              <option value="12">12 (G8-G10)</option>
              <option value="20">20 (G11/3EM)</option>
            </select>
            <button id="btn-generar" type="button" class="inline-flex items-center gap-2 rounded-xl bg-white px-5 py-2.5 text-sm font-black text-black hover:bg-white/90 disabled:opacity-40 disabled:cursor-not-allowed">
              ✨ Generar
            </button>
          </div>
        </div>
        <p class="mt-2 text-xs text-white/40">Usa <code class="text-white/60">COUNTRY_RULE_HINTS</code> del país seleccionado abajo + valida con <code class="text-white/60">validateLocalQuestion</code>. Fallback a plantillas si el LLM no responde.</p>
        <div id="gen-status" class="mt-3 hidden rounded-lg border border-white/10 bg-black/20 px-3 py-2 text-xs leading-relaxed text-white/70"></div>
        <div id="gen-progress" class="mt-3 hidden">
          <div class="h-2 w-full overflow-hidden rounded-full bg-white/5">
            <div id="gen-bar" class="h-2 w-1/3 bg-emerald-500 transition-all duration-500"></div>
          </div>
          <p class="mt-1 text-xs text-white/40">Generando con IA local… puede tardar 15–40s la primera vez</p>
        </div>
      </section>

      <!-- Step 3: Edit -->
      <section class="rounded-2xl border border-white/10 bg-white/[0.04] p-5 md:p-6">
        <div class="flex items-center gap-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white text-sm font-black text-black">3</span>
          <h2 class="text-base font-bold">Revisa y edita</h2>
          <span id="edit-hint" class="ml-auto text-xs text-white/40">Edita enunciado, opciones y explicaciones antes de exportar</span>
        </div>
        <div class="mt-5">
          <QuestionEditor />
        </div>
      </section>

      <!-- Step 4: Export -->
      <section class="rounded-2xl border border-white/10 bg-white/[0.04] p-5 md:p-6">
        <div class="flex items-center gap-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-emerald-500 text-sm font-black text-black">4</span>
          <h2 class="text-base font-bold">Exportar .md canónico</h2>
          <span class="ml-auto text-xs text-white/40">Naming v5.2 · <code class="text-white/60">-001-MASTERY-bundle.md</code></span>
        </div>
        <div class="mt-5">
          <ExportButton />
        </div>
        <p class="mt-3 text-xs leading-relaxed text-white/30">El archivo se descarga como borrador. No se escribe en <code>questions_data/</code>. Corrige primero el <code>.md</code> y valida con <code>npm run validate</code> antes de publicar.</p>
      </section>

      <div class="rounded-xl border border-amber-500/20 bg-amber-500/10 px-4 py-3 text-xs leading-relaxed text-amber-200/80">
        <strong class="text-amber-200">Nota de arquitectura:</strong> el PDF parsing vive en <code class="text-amber-100">src/lib/ai/pdf</code> (WX-201). Esta página lo importa como aliado externo (<code>ingestPDFForRAG</code>). La generación reutiliza <code>src/lib/ai/exam-generator.ts</code> (<code>COUNTRY_RULE_HINTS</code> + <code>validateLocalQuestion</code>) y el LLM on-device vía <code>edge-mesh / getAiCore()</code> (web-llm). Todo ocurre en el navegador.
      </div>
    </div>
  </div>

  <script>
    // Client orchestration for estudio.astro
    import { ingestPDFForRAG } from '../lib/ai/pdf/index';
    import { COUNTRY_RULE_HINTS, validateLocalQuestion, getCountryRuleHint } from '../lib/ai/exam-generator';
    import { getAiCore } from '../lib/ai/ai-core-client';

    let selectedFile: File | null = null;
    let ragChunks: any[] = [];
    let parsedText = '';

    const ragPreview = document.getElementById('rag-preview');
    const ragChunksEl = document.getElementById('rag-chunks');
    const ragStats = document.getElementById('rag-stats');
    const parseStatus = document.getElementById('parse-status');
    const genCountEl = document.getElementById('gen-count');
    const btnGenerar = document.getElementById('btn-generar');
    const genStatus = document.getElementById('gen-status');
    const genProgress = document.getElementById('gen-progress');
    const genBar = document.getElementById('gen-bar');

    function show(el: HTMLElement | null, msg: string, kind = 'info') {
      if (!el) return;
      el.textContent = msg;
      el.classList.remove('hidden');
      el.classList.toggle('border-emerald-500/20', kind==='ok');
      el.classList.toggle('bg-emerald-500/10', kind==='ok');
      el.classList.toggle('text-emerald-200', kind==='ok');
      el.classList.toggle('border-red-500/20', kind==='error');
      el.classList.toggle('bg-red-500/10', kind==='error');
    }
    function hide(el: HTMLElement | null) { el?.classList.add('hidden'); }

    function renderChunks(selected: any[]) {
      if (!ragPreview || !ragChunksEl || !ragStats) return;
      if (!selected || selected.length === 0) { ragPreview.classList.add('hidden'); return; }
      ragPreview.classList.remove('hidden');
      ragStats.textContent = `${selected.length} chunks · ${parsedText.length.toLocaleString()} caracteres`;
      ragChunksEl.innerHTML = selected.map((c, i) => `
        <div class="rounded-xl border border-white/5 bg-white/[0.03] p-3">
          <div class="flex items-center gap-2 text-[10px] uppercase tracking-wider text-white/40">
            <span class="rounded-full bg-white/10 px-2 py-0.5">chunk ${c.index + 1}</span>
            <span>${c.length} chars</span>
            <span class="ml-auto">${i < 5 ? 'RAG top' : ''}</span>
          </div>
          <p class="mt-2 text-xs leading-relaxed text-white/60 line-clamp-4">${escapeHtml(c.text).slice(0, 420)}</p>
        </div>
      `).join('');
    }
    function escapeHtml(s: any){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

    window.addEventListener('studio:pdf-selected', async (e: any) => {
      // @ts-ignore
      const file = e.detail?.file;
      selectedFile = file || null;
      ragChunks = [];
      parsedText = '';
      hide(genStatus); hide(genProgress);
      if (!file) return;
      show(parseStatus, `📄 Ingestando ${file.name} …`, 'info');
      try {
        const meta = ((window as any).__STUDIO_GET_META__?.() || {});
        const query = [meta.tema, meta.asignatura, file.name.replace(/\.pdf$/i,'')].filter(Boolean).join(' ');
        const { parsed, selected } = await ingestPDFForRAG(file, { query, topK: 5, chunkSize: 900 });
        parsedText = parsed.text;
        ragChunks = selected;
        show(parseStatus, `✓ PDF ingerido: ${parsed.numPages} pág(s) · ${parsed.text.length.toLocaleString()} caracteres · ${selected.length} chunks RAG`, 'ok');
        renderChunks(selected);
        if (btnGenerar) (btnGenerar as HTMLButtonElement).disabled = false;
      } catch (err) {
        show(parseStatus, `✗ Error al ingerir PDF: ${String((err as Error)?.message || err)}`, 'error');
        if (btnGenerar) (btnGenerar as HTMLButtonElement).disabled = false;
      }
    });
    window.addEventListener('studio:pdf-cleared', () => {
      selectedFile = null; ragChunks = []; parsedText = '';
      hide(parseStatus); hide(genStatus); hide(genProgress);
      ragPreview?.classList.add('hidden');
    });

    // Difficulty/bloom helpers matching bundle-export
    function bloomFor(i: number, total: number) {
      const r = (i+1)/total;
      if (r <= 0.2) return i%2===0 ? 'Remember' : 'Understand';
      if (r <= 0.5) return 'Apply';
      if (r <= 0.8) return 'Analyze';
      return 'Evaluate';
    }
    function diffFor(i: number, total: number) {
      const r = (i+1)/total;
      if (r <= 0.2) return 'D3-D4';
      if (r <= 0.5) return 'D5-D6';
      if (r <= 0.8) return 'D7-D8';
      return 'D9-D10';
    }

    function buildPrompt(meta: any, selectedChunks: any[], count: number) {
      const regionHint = getCountryRuleHint(meta.countryCode) || COUNTRY_RULE_HINTS[meta.countryCode] || '';
      const chunkText = selectedChunks.map((c,i)=>`[Chunk ${i+1}] ${c.text.slice(0, 700)}`).join('\n\n');
      return `Genera exactamente ${count} preguntas de ${meta.asignatura} grado ${meta.grado} sobre "${meta.tema}" para Latinoamérica (país ${meta.countryCode}).
${regionHint ? `Contexto regional: ${regionHint}\n` : ''}Protocolo v5.2: responde SOLO un JSON array con ${count} objetos.
Cada objeto:
{"statement":"enunciado completo","context":"contexto local breve útil","options":[{"letter":"A","text":"opción","is_correct":false,"feedback":"por qué es distractor"},...4 opciones A-D],"correct_answer":"A","explanation":"explicación pedagógica completa","difficulty":"${diffFor(0,count)}","bloom":"Apply"}
Reglas: 4 opciones A-D, una sola correcta, sin "todas/ninguna", feedback en cada opción, explicación pedagógica.
Usa SOLO este contenido RAG como fuente factual (no inventes fuera de él):
${chunkText || '(sin RAG — usa conocimiento curricular general)'}
`.trim();
    }

    function mockQuestionsFromRAG(selectedChunks: any[], count: number, meta: any) {
      // Deterministic fallback when LLM unavailable — still produces valid v5.2-shaped questions from RAG text
      const base = selectedChunks[0]?.text?.slice(0, 220) || `Tema ${meta.tema} de ${meta.asignatura}`;
      return Array.from({ length: count }, (_, i) => {
        const n = i + 1;
        const correct = ['A','B','C','D'][i % 4];
        const letters = ['A','B','C','D'];
        return {
          id: `local-llm-${n}-${Date.now().toString(36)}`,
          number: n,
          statement: `Pregunta ${n} sobre "${meta.tema}" (grado ${meta.grado}) — a partir de: "${base.slice(0, 90)}..." ¿Cuál afirmación es correcta?`,
          context: selectedChunks[i % Math.max(1, selectedChunks.length)]?.text?.slice(0, 160) || `Contexto local de ${meta.tema}`,
          options: letters.map((L) => ({
            letter: L,
            text: L === correct ? `Opción correcta para la pregunta ${n} (validada localmente)` : `Distractor ${L} — error conceptual frecuente en ${meta.tema}`,
            is_correct: L === correct,
            feedback: L === correct ? 'Correcta: se deduce directamente del contenido RAG.' : 'Distractor: confunde concepto o generaliza en exceso.',
          })),
          correct_answer: correct,
          explanation: `Explicación pedagógica de la pregunta ${n}: el concepto de ${meta.tema} se evalúa contrastando la opción correcta con distractores que reflejan errores comunes.`,
          difficulty: diffFor(i, count),
          bloom: bloomFor(i, count),
          source: 'llm',
        };
      });
    }

    function parseLlmJson(raw: any, count: number) {
      const m = String(raw || '').match(/\[[\s\S]*\]/);
      if (!m) return [];
      try {
        const arr = JSON.parse(m[0]);
        const LETTERS = ['A','B','C','D'];
        return (Array.isArray(arr) ? arr : [arr]).slice(0, count).map((item, idx) => {
          const x = item as any;
          const statement = String(x.statement || x.enunciado || '').trim();
          const explanation = String(x.explanation || x.explicacion || '').trim();
          let optsRaw = x.options || x.opciones || [];
          let opts = Array.isArray(optsRaw) ? optsRaw.slice(0,4).map((o:any, oi:number)=> ({
            letter: LETTERS[oi],
            text: String(o.text || o.texto || `Opción ${LETTERS[oi]}`),
            is_correct: !!(o.is_correct || o.correcta || o.correct),
            feedback: String(o.feedback || 'Feedback local.'),
          })) : [];
          while (opts.length < 4) { const i=opts.length; opts.push({ letter: LETTERS[i], text: `Opción ${LETTERS[i]}`, is_correct:false, feedback:'Distractor.' }); }
          if (!opts.some((o:any)=>o.is_correct)) {
            const ca = String(x.correct_answer || x.respuesta || 'A').toUpperCase().slice(0,1);
            opts = opts.map((o:any)=> ({...o, is_correct: o.letter===ca }));
            if (!opts.some((o:any)=>o.is_correct)) opts[0].is_correct=true;
          }
          const correct = opts.find((o:any)=>o.is_correct)?.letter || 'A';
          return {
            id: `local-llm-${idx+1}-${Date.now().toString(36)}`,
            number: idx+1,
            statement: statement || `Enunciado ${idx+1} sobre tema`,
            context: typeof x.context==='string' ? x.context : undefined,
            options: opts,
            correct_answer: correct,
            explanation: explanation || 'Explicación pedagógica.',
            difficulty: String(x.difficulty || diffFor(idx, count)),
            bloom: typeof x.bloom==='string' ? x.bloom : bloomFor(idx, count),
            source: 'llm' as const,
          };
        }).filter((q:any)=> validateLocalQuestion(q));
      } catch { return []; }
    }

    btnGenerar?.addEventListener('click', async () => {
      const count = Number((genCountEl as HTMLSelectElement)?.value || 10);
      const meta = ((window as any).__STUDIO_GET_META__?.() || { country:'colombia', countryCode:'CO', grado:6, asignatura:'matematicas', tema:'tema-generado' });
      if (!selectedFile && ragChunks.length===0) {
        show(genStatus, 'Primero sube un PDF (o igual puedes generar demo sin PDF, se usarán plantillas).', 'info');
      }
      if (btnGenerar) btnGenerar.disabled = true;
      show(genStatus, `🧠 Generando ${count} preguntas con IA local…`, 'info');
      genProgress?.classList.remove('hidden');
      if (genBar) { genBar.style.width='28%'; setTimeout(()=> genBar.style.width='62%', 900); }

      const effectiveChunks = ragChunks.length>0 ? ragChunks : [{ text: `Tema ${meta.tema} de ${meta.asignatura} grado ${meta.grado}`, index:0, length: 40, id:'mock-0' }];
      try {
        const prompt = buildPrompt(meta as any, effectiveChunks as any, count);
        let qs: any[] = [];
        let mode: string = 'mock';
        try {
          const ai = getAiCore();
          const raw = await ai.llm.generate(prompt, { maxNewTokens: 2800, temperature: 0.45 });
          qs = parseLlmJson(raw, count);
          if (qs.length >= Math.min(3, count)) mode = 'llm-validated';
          else {
            const raw2 = await ai.llm.generate(prompt + '\nReintento: responde SOLO JSON array válido.', { maxNewTokens: 2800, temperature: 0.2 });
            const qs2 = parseLlmJson(raw2, count);
            if (qs2.length > qs.length) qs = qs2;
            if (qs.length >= Math.min(3, count)) mode = 'llm-validated';
          }
        } catch (e) {
          // llm unavailable → keep mock
        }
        if (qs.length < count) {
          const needed = count - qs.length;
          const mocks = mockQuestionsFromRAG(effectiveChunks as any, needed, meta as any);
          // validate mocks just in case
          const validMocks = mocks.filter((q)=> validateLocalQuestion(q));
          qs = [...qs, ...validMocks].slice(0, count);
          if (mode !== 'llm-validated') mode = 'pool-assembled';
        }
        // ensure exactly count and valid
        qs = qs.slice(0, count).filter((q)=> validateLocalQuestion(q));
        while (qs.length < count) {
          const extra = mockQuestionsFromRAG(effectiveChunks as any, 1, meta as any)[0];
          if (validateLocalQuestion(extra)) qs.push(extra); else break;
          if (qs.length >= count) break;
        }
        // push to editor
        // @ts-ignore
        window.__STUDIO_SET_QUESTIONS__?.(qs);
        if (genBar) genBar.style.width='100%';
        setTimeout(()=> genProgress?.classList.add('hidden'), 700);
        const okMsg = mode==='llm-validated'
          ? `✓ Generadas ${qs.length} preguntas v5.2 validadas por LLM local. Edítalas abajo y exporta.`
          : `✓ Generadas ${qs.length} preguntas (fallback local — sin LLM o validación parcial). Edítalas abajo y exporta. No se publica a questions_data/.`;
        show(genStatus, okMsg, 'ok');
      } catch (err) {
        show(genStatus, `✗ Error al generar: ${String((err as Error)?.message || err)}`, 'error');
        genProgress?.classList.add('hidden');
      } finally {
        if (btnGenerar) btnGenerar.disabled = false;
        if (genBar) setTimeout(()=> genBar.style.width='28%', 1200);
      }
    });

    // enable generate even without PDF for demo/testing
    // @ts-ignore
    window.__STUDIO_INGEST__ = ingestPDFForRAG;
  </script>
</Layout>
