---
import Layout from '../../layouts/Layout.astro';
import CommunityExplanations from '../../components/community/CommunityExplanations.svelte';
---

<Layout title="Explicaciones de la Comunidad | SaberParaTodos">
  <main class="min-h-screen bg-slate-950 py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto space-y-6">
      <nav class="flex items-center gap-2 text-xs text-slate-400">
        <a href="/" class="hover:text-emerald-400 transition-colors">Inicio</a>
        <span>/</span>
        <a href="/explorar" class="hover:text-emerald-400 transition-colors">Comunidad</a>
        <span>/</span>
        <span class="text-slate-200">Explicaciones</span>
      </nav>

      <CommunityExplanations client:load />
    </div>
  </main>
</Layout>
