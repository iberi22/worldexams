---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Registro - SaberParaTodos">
  <main class="min-h-screen bg-gradient-to-br from-[#003893] to-[#FCD116] flex items-center justify-center p-4">
    <div class="bg-white/95 backdrop-blur-sm rounded-2xl shadow-2xl max-w-lg w-full p-8">
      <div class="text-center mb-6">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">🎓 Únete a SaberParaTodos</h1>
        <p class="text-gray-600">Crea tu cuenta sin contraseña</p>
        <div class="mt-4 p-3 bg-emerald-50 border border-emerald-200 rounded-lg">
          <p class="text-sm text-emerald-800">
            🔒 <strong>100% seguro:</strong> Usamos enlaces mágicos. Sin contraseñas, sin preocupaciones.
          </p>
        </div>
        <div class="mt-3 p-3 bg-blue-50 border border-blue-200 rounded-lg">
          <p class="text-sm text-blue-800">
            💡 Después de registrarte, puedes vincular Telegram en <a href="/vincular-telegram" class="underline font-semibold">/vincular-telegram</a>
          </p>
        </div>
      </div>

      <div id="auth-container">
        <form id="register-form" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Correo Electrónico</label>
            <input
              type="email"
              id="email"
              required
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-transparent"
              placeholder="estudiante@ejemplo.com"
            />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Nombre completo</label>
            <input
              type="text"
              id="fullName"
              required
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-transparent"
              placeholder="Tu nombre"
            />
          </div>

          <div id="college-section">
            <label class="block text-sm font-medium text-gray-700 mb-2">🏫 Colegio (opcional)</label>
            <div class="relative">
              <input
                type="text"
                id="collegeSearch"
                autocomplete="off"
                placeholder="Buscar colegio por nombre o código DANE..."
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-transparent"
              />
              <button type="button" id="clearCollege" class="absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 text-sm hidden">
                ✕
              </button>
              <div id="collegeDropdown" class="hidden absolute z-10 w-full mt-1 bg-white border border-gray-200 rounded-lg shadow-lg max-h-60 overflow-y-auto">
                <div id="collegeDropdownContent"></div>
              </div>
            </div>
            <p class="text-xs text-gray-500 mt-1">Vincula tu colegio para competir con tu institución</p>
          </div>

          <div id="gradeSection" class="hidden grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">📚 Grado</label>
              <select
                id="grade"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-transparent"
              >
                <option value="">Seleccionar...</option>
                <option value="6°">6°</option>
                <option value="7°">7°</option>
                <option value="8°">8°</option>
                <option value="9°">9°</option>
                <option value="10°">10°</option>
                <option value="11°">11°</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">👥 Sección</label>
              <select
                id="section"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-transparent"
              >
                <option value="">Seleccionar...</option>
                <option value="A">A</option>
                <option value="B">B</option>
                <option value="C">C</option>
                <option value="D">D</option>
                <option value="E">E</option>
                <option value="F">F</option>
                <option value="G">G</option>
                <option value="H">H</option>
              </select>
            </div>
          </div>

          <div id="success-message" class="hidden p-3 bg-emerald-50 border border-emerald-200 rounded-lg text-sm text-emerald-800"></div>
          <div id="error-message" class="hidden p-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-800"></div>
          <button
            type="submit"
            id="submit-btn"
            class="w-full bg-gradient-to-r from-emerald-600 to-emerald-700 text-white font-semibold py-3 rounded-lg hover:from-emerald-700 hover:to-emerald-800 transition-all shadow-md"
          >
            Enviar Enlace Mágico 🔐
          </button>
          <p class="text-xs text-gray-500 text-center mt-2">
            Te enviaremos un enlace seguro a tu correo. Sin contraseñas.
          </p>
        </form>
      </div>

      <div class="mt-6 text-center">
        <p class="text-sm text-gray-600">
          ¿Ya tienes cuenta? <a href="/login" class="text-blue-600 hover:underline font-semibold">Inicia sesión</a>
        </p>
      </div>

      <div class="mt-8 pt-6 border-t border-gray-200">
        <h3 class="font-semibold text-gray-900 mb-3">Con tu cuenta puedes:</h3>
        <ul class="space-y-2 text-sm text-gray-700">
          <li class="flex items-start gap-2">
            <span class="text-green-500 mt-0.5">✓</span>
            <span>Practicar con miles de preguntas tipo Pruebas de Estado</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-green-500 mt-0.5">✓</span>
            <span>Tutor IA personal (SaberBot) 24/7</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-green-500 mt-0.5">✓</span>
            <span>Seguimiento de progreso y estadísticas</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-green-500 mt-0.5">✓</span>
            <span>Acceso desde web y Telegram</span>
          </li>
        </ul>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase';


  // College search state
  let selectedCollegeId = '';
  let selectedCollegeName = '';

  const form = document.getElementById('register-form') as HTMLFormElement | null;

  // College search functionality
  const collegeSearchInput = document.getElementById('collegeSearch');
  const collegeDropdown = document.getElementById('collegeDropdown');
  const collegeDropdownContent = document.getElementById('collegeDropdownContent');
  const gradeSection = document.getElementById('gradeSection');
  const clearCollegeBtn = document.getElementById('clearCollege');

  let searchTimeout: ReturnType<typeof setTimeout> | null = null;

  collegeSearchInput?.addEventListener('input', async (e) => {
    const target = e.target as HTMLInputElement;
    const query = target.value;

    if (query.length < 2) {
      collegeDropdown?.classList.add('hidden');
      return;
    }

    if (searchTimeout) clearTimeout(searchTimeout);
    searchTimeout = setTimeout(async () => {
      try {
        const { data, error } = await supabase
          .from('colleges')
          .select('id, cod_dane, name, department, municipality')
          .or(`name.ilike.%${query}%,cod_dane.ilike.%${query}%`)
          .order('name')
          .limit(20);

        if (error) throw error;
        const results = data || [];

        if (results.length > 0 && collegeDropdownContent) {
          collegeDropdownContent.innerHTML = (results as any[]).map(college => `
            <button type="button" class="college-option w-full text-left px-4 py-2 hover:bg-emerald-50 border-b border-gray-100 last:border-0" data-id="${college.id}" data-name="${college.name}">
              <div class="font-medium text-gray-900">${college.name}</div>
              <div class="text-xs text-gray-500">📍 ${college.municipality}, ${college.department} • Código: ${college.cod_dane}</div>
            </button>
          `).join('');
          collegeDropdown?.classList.remove('hidden');
        } else if (collegeDropdownContent) {
          collegeDropdownContent.innerHTML = '<div class="p-3 text-center text-gray-500">No se encontraron colegios</div>';
          collegeDropdown?.classList.remove('hidden');
        }
      } catch (err) {
        console.error('Error searching colleges:', err);
      }
    }, 300);
  });

  // Handle college selection
  collegeDropdownContent?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const option = target.closest('.college-option') as HTMLElement | null;
    if (option) {
      selectedCollegeId = option.dataset.id || '';
      selectedCollegeName = option.dataset.name || '';

      if (collegeSearchInput) {
        const input = collegeSearchInput as HTMLInputElement;
        input.value = `${option.dataset.name || ''} (${option.querySelector('div:last-child')?.textContent?.replace('📍 ', '') || ''})`;
      }
      collegeDropdown?.classList.add('hidden');
      gradeSection?.classList.remove('hidden');

      // Add clear button
      const clearBtn = document.getElementById('clearCollege');
      if (clearBtn) {
        clearBtn.classList.remove('hidden');
        clearBtn.addEventListener('click', clearCollegeSelection);
      }
    }
  });

  function clearCollegeSelection() {
    selectedCollegeId = '';
    selectedCollegeName = '';
    (collegeSearchInput as HTMLInputElement).value = '';
    gradeSection?.classList.add('hidden');
    const clearBtn = document.getElementById('clearCollege');
    clearBtn?.classList.add('hidden');
  }

  clearCollegeBtn?.addEventListener('click', clearCollegeSelection);

  // Close dropdown when clicking outside
  document.addEventListener('click', (e) => {
    if (!collegeSearchInput?.contains(e.target as Node) && !collegeDropdown?.contains(e.target as Node)) {
      collegeDropdown?.classList.add('hidden');
    }
  });

  // Form submission
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

    const email = (document.getElementById('email') as HTMLInputElement).value;
    const fullName = (document.getElementById('fullName') as HTMLInputElement).value;
    const grade = (document.getElementById('grade') as HTMLSelectElement).value;
    const section = (document.getElementById('section') as HTMLSelectElement).value;
    const errorDiv = document.getElementById('error-message');
    const successDiv = document.getElementById('success-message');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Enviando enlace mágico...';
    errorDiv?.classList.add('hidden');
    successDiv?.classList.add('hidden');

    try {
      // Prepare metadata with college info
      const userData: any = {
        full_name: fullName
      };

      if (selectedCollegeId) {
        userData.school_id = selectedCollegeId;
        userData.college_name = selectedCollegeName;
        if (grade) userData.grade = grade;
        if (section) userData.section = section;
      }

      // Store in localStorage as backup (for when metadata doesn't get processed)
      if (selectedCollegeId) {
        localStorage.setItem('pending_college_data', JSON.stringify({
          school_id: selectedCollegeId,
          college_name: selectedCollegeName,
          grade,
          section
        }));
      }

      // Send Magic Link (passwordless signup)
      const { error } = await supabase.auth.signInWithOtp({
        email,
        options: {
          emailRedirectTo: window.location.origin + '/?onboarding=complete',
          data: userData
        }
      });

      if (error) throw error;

      // Success - Show message
      successDiv!.innerHTML = '✅ ¡Enlace mágico enviado! Revisa tu correo (incluso en spam) y haz clic en el enlace para acceder.' +
        (selectedCollegeId ? '<br><span class="text-xs">🎓 Tu colegio ha sido registrado: ' + selectedCollegeName + '</span>' : '');
      successDiv?.classList.remove('hidden');
      submitBtn.textContent = '✓ Enviado';

      // Clear form
      (document.getElementById('email') as HTMLInputElement).value = '';
      (document.getElementById('fullName') as HTMLInputElement).value = '';
      clearCollegeSelection();

    } catch (error: any) {
      errorDiv!.textContent = error.message || 'Error al enviar el enlace mágico';
      errorDiv?.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Enviar Enlace Mágico 🔐';
    }
  });
  }
</script>
