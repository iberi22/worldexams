---
import Layout from '../layouts/Layout.astro';
import TenantRouteNotice from '../components/TenantRouteNotice.astro';
import { resolveRuntimeCountryConfig } from '../config';
import { getTenantRouteAvailability } from '../config/tenant-experience';

const country = resolveRuntimeCountryConfig(Astro.locals.country);
const availability = getTenantRouteAvailability(country, 'notebooklm');
const isCO = country.code === 'CO';
const isMX = country.code === 'MX';
---

<Layout
  title={`Fuente de estudio NotebookLM | ${country.product.siteName}`}
  description={`Fuente editorial para cuadernos NotebookLM sobre ${country.examName}.`}
>
  <main class="min-h-screen bg-[#121212] px-4 py-16 text-[#F5F5DC]">
    <div class="mx-auto max-w-5xl">
      {isCO || isMX ? (
        <div class="space-y-10">
          <section class="rounded-[2rem] border border-white/10 bg-[#101115]/90 p-8 text-center shadow-2xl">
            <span class="inline-flex rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.25em] text-emerald-400">
              Fuente NotebookLM
            </span>
            <h1 class="mt-6 text-4xl font-black tracking-tight md:text-6xl">
              Base de estudio para {country.examName}
            </h1>
            <p class="mt-6 mx-auto max-w-3xl text-lg leading-relaxed text-white/65">
              Usa esta pagina como referencia de estudio para crear un cuaderno en NotebookLM sin mezclar fuentes de otros paises.
            </p>
          </section>

          <section class="grid gap-6 md:grid-cols-2">
            <article class="rounded-3xl border border-white/10 bg-white/[0.03] p-6">
              <h2 class="text-2xl font-black">Como usarla</h2>
              <ol class="mt-4 space-y-3 text-white/70">
                <li>Crea un cuaderno en NotebookLM con el nombre del tenant activo.</li>
                <li>Agrega esta ruta y la guia del examen como fuentes iniciales.</li>
                <li>Completa simulacros en la plataforma y luego genera un prompt de estudio con tu progreso local.</li>
              </ol>
            </article>

            <article class="rounded-3xl border border-white/10 bg-white/[0.03] p-6">
              <h2 class="text-2xl font-black">Cobertura editorial</h2>
              <p class="mt-4 text-white/70 leading-7">
                Incluye estructura {country.examName}, autoridad {country.examAuthority} y una ruta de estudio basada en la cobertura activa del producto para {country.name}.
              </p>
              <p class="mt-4 text-white/55 text-sm">
                Si una convocatoria externa cambia, la fuente oficial de {country.examAuthority} prevalece sobre este resumen editorial.
              </p>
            </article>
          </section>

          <section class="rounded-3xl border border-white/10 bg-[#0f1115] p-8">
            <h2 class="text-3xl font-black">Fuentes recomendadas</h2>
            <ul class="mt-6 space-y-3 text-white/75">
              <li><a href="/guia-examen" class="text-emerald-400 underline">/guia-examen</a> para estructura y autoridad.</li>
              <li><a href="/api/notebooklm-source.json" class="text-emerald-400 underline">/api/notebooklm-source.json</a> para el resumen de fuentes tecnicas.</li>
              <li><a href="/" class="text-emerald-400 underline">/</a> para generar progreso local y luego exportar prompts de estudio.</li>
            </ul>
          </section>
        </div>
      ) : (
        <TenantRouteNotice country={country} availability={availability} />
      )}
    </div>
  </main>
</Layout>
