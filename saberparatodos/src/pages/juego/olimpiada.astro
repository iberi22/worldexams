---
/**
 * /juego/olimpiada — Olimpiada trimestral + GOAT (F9). Async 72h, anónimo.
 */
import Layout from '../../layouts/Layout.astro';
import OlimpiadaPanel from '../../components/juego/OlimpiadaPanel.svelte';
---

<Layout
  title="Olimpiada trimestral | Juego SaberParaTodos"
  description="Clasifica por ligas + simulacro oficial y compite en la ventana de 72h. Anónimo y revocable."
>
  <div class="min-h-screen bg-[#121212]" data-testid="juego-olimpiada-page">
    <div class="max-w-4xl mx-auto px-4 pt-6">
      <a href="/juego" class="inline-flex items-center gap-2 text-white/40 hover:text-white/80 transition-colors text-sm mb-4">
        ← Volver al juego
      </a>
      <h1 class="text-2xl sm:text-3xl font-bold text-[#F5F5DC] tracking-tight">Olimpiada</h1>
      <p class="text-sm text-white/60 mt-2">
        Trimestral · hispanohablante · camino al GOAT of Season.
      </p>
    </div>

    <div class="max-w-4xl mx-auto px-4 py-6">
      <OlimpiadaPanel client:load />
    </div>
  </div>
</Layout>
