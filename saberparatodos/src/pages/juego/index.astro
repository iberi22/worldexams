---
import Layout from '../../layouts/Layout.astro';
import ProgresoJuego from '../../components/juego/ProgresoJuego.svelte';
---

<Layout title="Juego | SaberParaTodos" description="Hub principal de Juego, Ligas y Olimpiadas">
  <div data-testid="juego-hub" class="min-h-screen bg-[#121212] text-[#F5F5DC] p-4 sm:p-8">
    <div class="max-w-4xl mx-auto space-y-6">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">Juego</h1>
      <p class="text-sm text-white/60">
        Compite y aprende en la plataforma de entrenamiento interactivo.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href="/juego/liga"
          class="px-6 py-4 bg-emerald-500/10 border border-emerald-500/30 rounded-xl hover:bg-emerald-500/20 text-emerald-400 font-semibold text-center transition-colors"
        >
          Mi liga
        </a>
        <a
          href="/juego/olimpiada"
          class="px-6 py-4 bg-amber-500/10 border border-amber-500/30 rounded-xl hover:bg-amber-500/20 text-amber-300 font-semibold text-center transition-colors"
        >
          Olimpiada
        </a>
      </div>
      <ProgresoJuego client:load />
    </div>
  </div>
</Layout>
