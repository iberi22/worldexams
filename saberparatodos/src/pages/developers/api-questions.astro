---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="API de Preguntas | World Exams">
  <div class="min-h-screen bg-[#0a0a0f] text-gray-200">
    <!-- Hero Section -->
    <div class="relative overflow-hidden bg-gradient-to-br from-[#1a1a2e] via-[#16213e] to-[#0f0f23] py-20">
      <div class="absolute inset-0 opacity-20">
        <div class="absolute top-20 left-10 w-72 h-72 bg-[#FCD116] rounded-full blur-3xl"></div>
        <div class="absolute bottom-20 right-10 w-96 h-96 bg-[#003893] rounded-full blur-3xl"></div>
      </div>

      <div class="max-w-6xl mx-auto px-6 relative z-10">
        <div class="text-center mb-12">
          <span class="inline-block px-4 py-2 bg-[#FCD116]/20 text-[#FCD116] rounded-full text-sm font-bold mb-4">
            🚀 EL MAYOR BANCO DE PREGUNTAS DE LATINOAMÉRICA
          </span>
          <h1 class="text-5xl md:text-6xl font-black text-white mb-6">
            API de <span class="text-[#FCD116]">Generación</span> de Preguntas
          </h1>
          <p class="text-xl text-gray-400 max-w-3xl mx-auto">
            Genera preguntas de forma automática con nuestro protocolo propietario en constante evolución.
            <span class="text-[#FCD116] font-bold">+1,000,000 de preguntas</span> en roadmap.
          </p>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-12">
          <div class="bg-[#1a1a2e]/80 backdrop-blur p-6 rounded-xl border border-[#333]">
            <div class="text-4xl font-black text-[#FCD116]">50K+</div>
            <div class="text-gray-400 mt-2">Preguntas Actuales</div>
          </div>
          <div class="bg-[#1a1a2e]/80 backdrop-blur p-6 rounded-xl border border-[#333]">
            <div class="text-4xl font-black text-[#003893]">9</div>
            <div class="text-gray-400 mt-2">Países</div>
          </div>
          <div class="bg-[#1a1a2e]/80 backdrop-blur p-6 rounded-xl border border-[#333]">
            <div class="text-4xl font-black text-[#CE1126]">7</div>
            <div class="text-gray-400 mt-2">Idiomas</div>
          </div>
          <div class="bg-[#1a1a2e]/80 backdrop-blur p-6 rounded-xl border border-[#333]">
            <div class="text-4xl font-black text-green-500">99.2%</div>
            <div class="text-gray-400 mt-2">Precisión</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Protocol Section -->
    <div class="max-w-6xl mx-auto px-6 py-16">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-black text-white mb-4">
          Protocolo Propietario <span class="text-[#FCD116]">WorldExams v3.0</span>
        </h2>
        <p class="text-xl text-gray-400 max-w-2xl mx-auto">
          Un protocolo en constante evolución que garantiza la máxima calidad educativa
          mediante IA + revisión humana + retroalimentación continua.
        </p>
      </div>

      <!-- Protocol Evolution -->
      <div class="bg-[#1a1a2e] rounded-2xl border border-[#333] p-8 mb-12">
        <h3 class="text-2xl font-bold text-white mb-8 flex items-center gap-3">
          <span class="text-3xl">🔄</span> Evolución del Protocolo
        </h3>

        <div class="grid md:grid-cols-3 gap-6">
          <!-- v1.0 -->
          <div class="bg-[#0f0f1a] p-6 rounded-xl border border-[#333]">
            <div class="flex items-center justify-between mb-4">
              <span class="text-sm font-bold text-gray-400">Enero 2025</span>
              <span class="px-3 py-1 bg-gray-600/30 text-gray-400 rounded-full text-xs font-bold">LEGACY</span>
            </div>
            <h4 class="text-xl font-bold text-white mb-3">Protocolo v1.0</h4>
            <ul class="space-y-2 text-gray-400 text-sm">
              <li class="flex items-start gap-2">
                <span class="text-red-500">•</span>
                <span>1 pregunta por archivo</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-red-500">•</span>
                <span>Sin contexto cultural</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-red-500">•</span>
                <span>Explicaciones básicas</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-red-500">•</span>
                <span>Formato no estructurado</span>
              </li>
            </ul>
          </div>

          <!-- v2.0 -->
          <div class="bg-[#0f0f1a] p-6 rounded-xl border border-[#003893]/50">
            <div class="flex items-center justify-between mb-4">
              <span class="text-sm font-bold text-[#003893]">Diciembre 2025</span>
              <span class="px-3 py-1 bg-[#003893]/30 text-[#003893] rounded-full text-xs font-bold">ACTUAL</span>
            </div>
            <h4 class="text-xl font-bold text-white mb-3">Protocolo v2.1</h4>
            <ul class="space-y-2 text-gray-400 text-sm">
              <li class="flex items-start gap-2">
                <span class="text-green-500">✓</span>
                <span>7 variantes por pregunta</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-green-500">✓</span>
                <span>Contexto cultural obligatorio</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-green-500">✓</span>
                <span>Licencias duales (BY-SA / BY-NC-SA)</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-green-500">✓</span>
                <span>Metadata estructurada</span>
              </li>
            </ul>
          </div>

          <!-- v3.0 -->
          <div class="bg-[#0f0f1a] p-6 rounded-xl border border-[#FCD116]/50 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-20 h-20 bg-[#FCD116] opacity-10 rounded-bl-full"></div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-sm font-bold text-[#FCD116]">Q2 2026</span>
              <span class="px-3 py-1 bg-[#FCD116]/30 text-[#FCD116] rounded-full text-xs font-bold">PRÓXIMO</span>
            </div>
            <h4 class="text-xl font-bold text-white mb-3">Protocolo v3.0</h4>
            <ul class="space-y-2 text-gray-400 text-sm">
              <li class="flex items-start gap-2">
                <span class="text-[#FCD116]">★</span>
                <span>IA adaptativa por estudiante</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#FCD116]">★</span>
                <span>Generación en tiempo real</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#FCD116]">★</span>
                <span>Multimodal (texto + imagen)</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#FCD116]">★</span>
                <span>Validación automática con LLMs</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- How It Works -->
      <div class="bg-[#1a1a2e] rounded-2xl border border-[#333] p-8">
        <h3 class="text-2xl font-bold text-white mb-8 flex items-center gap-3">
          <span class="text-3xl">⚙️</span> Cómo Funciona el Motor de Generación
        </h3>

        <div class="grid md:grid-cols-5 gap-4">
          <div class="text-center">
            <div class="w-16 h-16 bg-[#003893] rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">🔍</div>
            <h4 class="font-bold text-white mb-2">1. Investigación</h4>
            <p class="text-gray-400 text-sm">Búsqueda automática en fuentes oficiales (ICFES, EXANI, ENEM)</p>
          </div>

          <div class="text-center">
            <div class="w-16 h-16 bg-[#CE1126] rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">🤖</div>
            <h4 class="font-bold text-white mb-2">2. Generación IA</h4>
            <p class="text-gray-400 text-sm">Creación de 7 variantes con contextos culturales locales</p>
          </div>

          <div class="text-center">
            <div class="w-16 h-16 bg-[#FCD116] text-[#1a1a2e] rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">✓</div>
            <h4 class="font-bold text-white mb-2">3. Validación</h4>
            <p class="text-gray-400 text-sm">Revisión automática + validación humana de pedagógos</p>
          </div>

          <div class="text-center">
            <div class="w-16 h-16 bg-green-600 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">📊</div>
            <h4 class="font-bold text-white mb-2">4. Análisis</h4>
            <p class="text-gray-400 text-sm">Métricas de dificultad, discriminación y precisión</p>
          </div>

          <div class="text-center">
            <div class="w-16 h-16 bg-purple-600 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">🚀</div>
            <h4 class="font-bold text-white mb-2">5. Publicación</h4>
            <p class="text-gray-400 text-sm">Deploy automático a API + dashboard de analytics</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Pricing Section -->
    <div class="bg-[#0f0f1a] py-16">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-black text-white mb-4">
            Planes de <span class="text-[#FCD116]">API</span>
          </h2>
          <p class="text-xl text-gray-400">
            Precios en <span class="font-bold text-[#FCD116]">Pesos Colombianos (COP)</span>. Paga en pesos, facturado en USD.
          </p>
        </div>

        <!-- Cost Analysis Section -->
        <div class="bg-[#1a1a2e] rounded-2xl border border-[#333] p-8 mb-12">
          <h3 class="text-2xl font-bold text-white mb-6 flex items-center gap-3">
            <span class="text-3xl">💰</span> Análisis de Costos y Rentabilidad
          </h3>

          <div class="grid md:grid-cols-2 gap-8">
            <!-- Costos de Generación por IA -->
            <div class="bg-[#0f0f1a] p-6 rounded-xl border border-[#333]">
              <h4 class="text-lg font-bold text-white mb-4">🤖 Costo de Generar Preguntas con IA</h4>
              <div class="space-y-3 text-sm">
                <div class="flex justify-between items-center py-2 border-b border-[#333]">
                  <span class="text-gray-400">OpenAI GPT-4o (por pregunta)</span>
                  <span class="font-bold text-red-400">~$0.01 USD</span>
                </div>
                <div class="flex justify-between items-center py-2 border-b border-[#333]">
                  <span class="text-gray-400">Claude Sonnet 4 (por pregunta)</span>
                  <span class="font-bold text-red-400">~$0.015 USD</span>
                </div>
                <div class="flex justify-between items-center py-2 border-b border-[#333]">
                  <span class="text-gray-400">Generar 10K preguntas (manual)</span>
                  <span class="font-bold text-red-400">~$100-500 USD</span>
                </div>
                <div class="bg-[#CE1126]/20 p-3 rounded-lg mt-4">
                  <p class="text-white font-bold text-sm">
                    ⚠️ <strong>Nuestro diferencial:</strong> Con nuestro banco ya generado,
                    el costo marginal por pregunta es <span class="text-green-400">casi $0</span>
                  </p>
                </div>
              </div>
            </div>

            <!-- Costos de Pasarela -->
            <div class="bg-[#0f0f1a] p-6 rounded-xl border border-[#333]">
              <h4 class="text-lg font-bold text-white mb-4">💳 Comisiones de Pasarela (Colombia)</h4>
              <div class="space-y-3 text-sm">
                <div class="flex justify-between items-center py-2 border-b border-[#333]">
                  <span class="text-gray-400">Wompi (BBVA)</span>
                  <span class="font-bold text-yellow-400">2.9% + $100 COP</span>
                </div>
                <div class="flex justify-between items-center py-2 border-b border-[#333]">
                  <span class="text-gray-400">MercadoPago</span>
                  <span class="font-bold text-yellow-400">4.99% + $500 COP</span>
                </div>
                <div class="flex justify-between items-center py-2 border-b border-[#333]">
                  <span class="text-gray-400">PayU</span>
                  <span class="font-bold text-yellow-400">3.5% + $200 COP</span>
                </div>
                <div class="flex justify-between items-center py-2 border-b border-[#333]">
                  <span class="text-gray-400">Stripe (USD)</span>
                  <span class="font-bold text-yellow-400">2.9% + $0.30 USD</span>
                </div>
                <div class="bg-[#003893]/20 p-3 rounded-lg mt-4">
                  <p class="text-white font-bold text-sm">
                    📌 <strong>Selected:</strong> Wompi - Mejor tasa para Colombia,
                    integrado con bancos locales
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Rentabilidad por Plan -->
          <div class="mt-8">
            <h4 class="text-lg font-bold text-white mb-4">📊 Margen de Ganancia por Plan (con Wompi 3%)</h4>
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead>
                  <tr class="border-b border-[#333]">
                    <th class="text-left py-3 px-4 text-gray-400">Plan</th>
                    <th class="text-right py-3 px-4 text-gray-400">Ingreso</th>
                    <th class="text-right py-3 px-4 text-gray-400">-Pasarela (3%)</th>
                    <th class="text-right py-3 px-4 text-gray-400">-Costos Variables</th>
                    <th class="text-right py-3 px-4 text-gray-400">=Margen</th>
                    <th class="text-right py-3 px-4 text-gray-400">% Margen</th>
                  </tr>
                </thead>
                <tbody class="text-gray-300">
                  <tr class="border-b border-[#333]">
                    <td class="py-3 px-4">Starter ($79.000)</td>
                    <td class="text-right py-3 px-4">$79.000</td>
                    <td class="text-right py-3 px-4 text-red-400">-$2.370</td>
                    <td class="text-right py-3 px-4 text-red-400">~$500</td>
                    <td class="text-right py-3 px-4 font-bold text-green-400">$76.130</td>
                    <td class="text-right py-3 px-4 font-bold text-green-400">96%</td>
                  </tr>
                  <tr class="border-b border-[#333]">
                    <td class="py-3 px-4">Pro ($199.000)</td>
                    <td class="text-right py-3 px-4">$199.000</td>
                    <td class="text-right py-3 px-4 text-red-400">-$5.970</td>
                    <td class="text-right py-3 px-4 text-red-400">~$2.000</td>
                    <td class="text-right py-3 px-4 font-bold text-green-400">$191.030</td>
                    <td class="text-right py-3 px-4 font-bold text-green-400">96%</td>
                  </tr>
                  <tr>
                    <td class="py-3 px-4">Enterprise ($499.000)</td>
                    <td class="text-right py-3 px-4">$499.000</td>
                    <td class="text-right py-3 px-4 text-red-400">-$14.970</td>
                    <td class="text-right py-3 px-4 text-red-400">~$5.000</td>
                    <td class="text-right py-3 px-4 font-bold text-green-400">$479.030</td>
                    <td class="text-right py-3 px-4 font-bold text-green-400">96%</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Pricing Comparison Table -->
        <div class="overflow-x-auto mb-16">
          <table class="w-full min-w-[800px]">
            <thead>
              <tr class="border-b border-[#333]">
                <th class="text-left py-4 px-6 text-gray-400 font-bold">Característica</th>
                <th class="text-center py-4 px-6 text-[#FCD116] font-bold text-xl">
                  🆓 Free<br><span class="text-sm font-normal text-gray-400">Desarrollo</span>
                </th>
                <th class="text-center py-4 px-6 bg-[#003893]/20 border-2 border-[#003893] rounded-t-xl text-white font-bold text-xl">
                  🚀 Starter<br><span class="text-sm font-normal text-gray-400">$79.000/mes</span>
                </th>
                <th class="text-center py-4 px-6 text-[#CE1126] font-bold text-xl">
                  ⚡ Pro<br><span class="text-sm font-normal text-gray-400">$199.000/mes</span>
                </th>
                <th class="text-center py-4 px-6 text-[#FCD116] font-bold text-xl">
                  👑 Enterprise<br><span class="text-sm font-normal text-gray-400">$499.000/mes</span>
                </th>
              </tr>
            </thead>
            <tbody class="text-gray-300">
              <tr class="border-b border-[#333]">
                <td class="py-4 px-6">Requests/mes</td>
                <td class="text-center py-4 px-6">100/hora</td>
                <td class="text-center py-4 px-6 bg-[#003893]/10 font-bold">5,000</td>
                <td class="text-center py-4 px-6">25,000</td>
                <td class="text-center py-4 px-6">100,000</td>
              </tr>
              <tr class="border-b border-[#333]">
                <td class="py-4 px-6">Países disponibles</td>
                <td class="text-center py-4 px-6">1 (Colombia)</td>
                <td class="text-center py-4 px-6 bg-[#003893]/10">3</td>
                <td class="text-center py-4 px-6">9</td>
                <td class="text-center py-4 px-6">Todos</td>
              </tr>
              <tr class="border-b border-[#333]">
                <td class="py-4 px-6">Variantes por pregunta</td>
                <td class="text-center py-4 px-6">1 (v1 legacy)</td>
                <td class="text-center py-4 px-6 bg-[#003893]/10">3</td>
                <td class="text-center py-4 px-6">7 (todas)</td>
                <td class="text-center py-4 px-6">7 + custom</td>
              </tr>
              <tr class="border-b border-[#333]">
                <td class="py-4 px-6">Acceso legacy</td>
                <td class="text-center py-4 px-6">✓</td>
                <td class="text-center py-4 px-6 bg-[#003893]/10">✓</td>
                <td class="text-center py-4 px-6">✓</td>
                <td class="text-center py-4 px-6">✓</td>
              </tr>
              <tr class="border-b border-[#333]">
                <td class="py-4 px-6">Generación en tiempo real</td>
                <td class="text-center py-4 px-6">❌</td>
                <td class="text-center py-4 px-6 bg-[#003893]/10">❌</td>
                <td class="text-center py-4 px-6">✓</td>
                <td class="text-center py-4 px-6">✓</td>
              </tr>
              <tr class="border-b border-[#333]">
                <td class="py-4 px-6">API key</td>
                <td class="text-center py-4 px-6">❌</td>
                <td class="text-center py-4 px-6 bg-[#003893]/10">✓</td>
                <td class="text-center py-4 px-6">✓</td>
                <td class="text-center py-4 px-6">✓</td>
              </tr>
              <tr class="border-b border-[#333]">
                <td class="py-4 px-6">Soporte</td>
                <td class="text-center py-4 px-6">Comunidad</td>
                <td class="text-center py-4 px-6 bg-[#003893]/10">Email</td>
                <td class="text-center py-4 px-6">Email prioritario</td>
                <td class="text-center py-4 px-6">24/7 dedicado</td>
              </tr>
              <tr>
                <td class="py-4 px-6">SLA</td>
                <td class="text-center py-4 px-6">❌</td>
                <td class="text-center py-4 px-6 bg-[#003893]/10">99%</td>
                <td class="text-center py-4 px-6">99.5%</td>
                <td class="text-center py-4 px-6">99.9%</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Competitor Comparison -->
        <div class="bg-[#1a1a2e] rounded-2xl border border-[#333] p-8 mb-12">
          <h3 class="text-2xl font-bold text-white mb-8 flex items-center gap-3">
            <span class="text-3xl">📊</span> Comparación de Precios
          </h3>

          <!-- ROI Calculator -->
          <div class="bg-gradient-to-r from-green-900/30 to-[#003893]/30 p-6 rounded-xl border border-green-500/30 mb-8">
            <h4 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
              <span class="text-2xl">🧮</span> Calculadora de Ahorro
            </h4>
            <div class="grid md:grid-cols-3 gap-6">
              <div class="text-center">
                <div class="text-3xl font-black text-red-400 line-through">$40.000</div>
                <div class="text-gray-400 text-sm">Costo de generar 1K preguntas con ChatGPT</div>
              </div>
              <div class="text-center">
                <div class="text-3xl font-black text-white">$16</div>
                <div class="text-gray-400 text-sm">Costo con nuestra API</div>
              </div>
              <div class="text-center">
                <div class="text-4xl font-black text-green-400">99.96%</div>
                <div class="text-gray-400 text-sm">Ahorro vs generar con IA</div>
              </div>
            </div>
            <p class="text-center text-gray-300 mt-4 text-sm">
              <strong>Nota:</strong> Generar 1,000 preguntas con IA costing ~$10 USD (~$40,000 COP),
              incluyendo revisión humana. Nuestra API sirve preguntas pre-generadas a costo marginal ~$0.
            </p>
          </div>

          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- WorldExams (Our Product) -->
            <div class="bg-gradient-to-br from-[#003893] to-[#1a1a2e] p-6 rounded-xl border-2 border-[#FCD116] relative">
              <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-4 py-1 bg-[#FCD116] text-black font-bold text-sm rounded-full">
                NUESTRO PRODUCTO
              </div>
              <h4 class="text-2xl font-black text-white mb-2">WorldExams API</h4>
              <p class="text-gray-300 mb-4">El más económico para LATAM</p>

              <div class="space-y-3 mb-6">
                <div class="flex justify-between text-sm">
                  <span class="text-gray-400">Precio Starter</span>
                  <span class="font-bold text-green-400">$79.000 COP</span>
                </div>
                <div class="flex justify-between text-sm">
                  <span class="text-gray-400">Precio Pro</span>
                  <span class="font-bold text-green-400">$199.000 COP</span>
                </div>
                <div class="flex justify-between text-sm">
                  <span class="text-gray-400">Costo por 1K preguntas</span>
                  <span class="font-bold text-green-400">~$16 COP</span>
                </div>
                <div class="flex justify-between text-sm">
                  <span class="text-gray-400">Preguntas países</span>
                  <span class="font-bold text-white">9</span>
