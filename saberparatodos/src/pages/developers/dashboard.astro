---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Dashboard | Developer Portal">
  <div class="min-h-screen bg-[#121212] text-[#F5F5DC] p-8">
    <div class="max-w-4xl mx-auto">
      <header class="mb-8 flex justify-between items-center border-b border-[#333] pb-4">
        <h1 class="text-3xl font-bold font-mono text-[#FCD116]">Developer Dashboard</h1>
        <button id="logout-btn" class="text-sm text-[#A0A0A0] hover:text-white underline">
          Sign Out
        </button>
      </header>

      <!-- Auth State: Loading -->
      <div id="loading-state" class="text-center py-12">
        <p class="text-[#A0A0A0]">Loading account details...</p>
      </div>

      <!-- Auth State: Not Logged In -->
      <div id="login-state" class="hidden text-center py-12 bg-[#1A1A1A] rounded-lg border border-[#333]">
        <h2 class="text-2xl font-bold mb-4">Sign In Required</h2>
        <p class="text-[#A0A0A0] mb-6">Please sign in to manage your API keys.</p>
        <button
          id="login-btn"
          class="bg-[#003893] hover:bg-[#002776] text-white px-6 py-3 rounded-lg font-bold transition-colors"
        >
          Sign In with GitHub
        </button>
      </div>

      <!-- Auth State: Logged In -->
      <div id="dashboard-content" class="hidden space-y-8">

        <!-- User Info -->
        <div class="flex items-center gap-4 mb-8">
          <div class="w-12 h-12 rounded-full bg-[#333] flex items-center justify-center text-xl">
            👤
          </div>
          <div>
            <p id="user-email" class="font-bold text-lg"></p>
            <p class="text-sm text-[#A0A0A0]">Free Plan</p>
          </div>
        </div>

        <!-- API Keys List -->
        <div class="bg-[#1A1A1A] rounded-lg border border-[#333] overflow-hidden">
          <div class="p-6 border-b border-[#333] flex justify-between items-center">
            <h2 class="text-xl font-bold">Your API Keys</h2>
            <button
              id="create-key-btn"
              class="bg-[#006847] hover:bg-[#005036] text-white px-4 py-2 rounded text-sm font-bold transition-colors"
            >
              + Create New Key
            </button>
          </div>

          <div id="keys-list" class="p-6 space-y-4">
            <!-- Keys will be injected here -->
            <p class="text-[#A0A0A0] text-center italic">No API keys found.</p>
          </div>
        </div>

        <!-- Usage Stats -->
        <div class="bg-[#1A1A1A] rounded-lg border border-[#333] p-6">
          <h2 class="text-xl font-bold mb-4 text-[#FCD116]">API Usage Statistics</h2>
          <div class="grid grid-cols-3 gap-4 text-center">
            <div class="bg-[#121212] p-4 rounded border border-[#333]">
              <p class="text-[#A0A0A0] text-sm mb-1">Requests / Day</p>
              <p class="text-2xl font-mono font-bold" id="requests-count">0</p>
            </div>
            <div class="bg-[#121212] p-4 rounded border border-[#333]">
              <p class="text-[#A0A0A0] text-sm mb-1">Monthly Limit</p>
              <p class="text-2xl font-mono font-bold" id="monthly-limit">1,000</p>
            </div>
            <div class="bg-[#121212] p-4 rounded border border-[#333]">
              <p class="text-[#A0A0A0] text-sm mb-1">Status</p>
              <p class="text-2xl font-mono font-bold text-green-500">Active</p>
            </div>
          </div>
        </div>

        <!-- Billing & Upgrade Section -->
        <div class="bg-[#1A1A1A] rounded-lg border border-[#333] p-6 mt-8">
          <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
            <span class="text-[#CE1126]">💳</span> Billing & Upgrade
          </h2>
          <div class="flex flex-col md:flex-row justify-between items-center bg-[#121212] p-6 rounded border border-yellow-500/20">
            <div class="mb-4 md:mb-0">
              <h3 class="text-[#FCD116] font-bold text-lg mb-1">Go Pro - Higher Limits</h3>
              <p class="text-[#A0A0A0] text-sm">Get up to 10k requests/day and commercial usage rights.</p>
            </div>
            <div class="text-right">
              <p class="text-2xl font-bold mb-2">$19<span class="text-sm font-normal text-[#A0A0A0]">/mo</span></p>
              <button class="bg-[#FCD116] text-black px-6 py-2 rounded font-bold hover:bg-yellow-400 transition-colors">
                Upgrade to Pro
              </button>
            </div>
          </div>
          
          <div class="mt-4 p-4 border-t border-[#333]">
            <p class="text-sm text-[#A0A0A0]">
              Institutional pricing available for schools and universities. 
              <a href="/contacto" class="text-[#003893] hover:underline">Contact sales</a>.
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>

  <script>
    // @ts-nocheck - Supabase types need to be generated
    import { supabase } from '../../lib/supabase';

    const loadingState = document.getElementById('loading-state');
    const loginState = document.getElementById('login-state');
    const dashboardContent = document.getElementById('dashboard-content');
    const userEmail = document.getElementById('user-email');
    const keysList = document.getElementById('keys-list');

    // Auth Logic
    supabase.auth.onAuthStateChange((_event, session) => {
      if (loadingState) loadingState.classList.add('hidden');
      if (session) {
        if (loginState) loginState.classList.add('hidden');
        if (dashboardContent) dashboardContent.classList.remove('hidden');
        if (userEmail && session.user.email) userEmail.textContent = session.user.email;
        fetchApiKeys(session.user.id);
      } else {
        if (loginState) loginState.classList.remove('hidden');
        if (dashboardContent) dashboardContent.classList.add('hidden');
      }
    });

    const loginBtn = document.getElementById('login-btn');
    if (loginBtn) {
      loginBtn.addEventListener('click', async () => {
        await supabase.auth.signInWithOAuth({ provider: 'github' });
      });
    }

    const logoutBtn = document.getElementById('logout-btn');
    if (logoutBtn) {
      logoutBtn.addEventListener('click', async () => {
        await supabase.auth.signOut();
      });
    }

    // API Keys Logic
    async function fetchApiKeys(userId: string) {
      const { data, error } = await supabase
        .from('api_keys')
        .select('*, organizations(name)')
        .order('created_at', { ascending: false });

      if (error) {
        console.error('Error fetching keys:', error);
        return;
      }

      renderKeys(data);
      updateStats(data);
    }

    function updateStats(keys: any[]) {
      const totalUsage = keys.reduce((acc, k) => acc + (k.current_usage || 0), 0);
      const totalLimit = keys.reduce((acc, k) => acc + (k.monthly_limit || 100), 0);
      
      const countEl = document.getElementById('requests-count');
      const limitEl = document.getElementById('monthly-limit');
      
      if (countEl) countEl.textContent = totalUsage.toLocaleString();
      if (limitEl) limitEl.textContent = totalLimit.toLocaleString();
    }

    function renderKeys(keys: any[]) {
      if (!keysList) return;

      if (!keys || keys.length === 0) {
        keysList.innerHTML = '<p class="text-[#A0A0A0] text-center italic">No API keys found.</p>';
        return;
      }

      keysList.innerHTML = keys.map((key: any) => `
        <div class="flex flex-col md:flex-row items-center justify-between bg-[#121212] p-4 rounded border border-[#333] mb-3">
          <div class="mb-3 md:mb-0 w-full">
            <p class="font-mono text-[#FCD116] mb-1 font-bold">${key.name || 'Unnamed Key'}</p>
            <div class="flex items-center gap-2">
              <span class="text-xs bg-[#333] px-2 py-0.5 rounded text-[#A0A0A0]">${key.organizations?.name || 'Org'}</span>
              <p class="font-mono text-sm text-[#A0A0A0]">${key.key_prefix}****</p>
            </div>
          </div>
          <div class="text-right w-full md:w-auto border-t md:border-t-0 border-[#333] pt-3 md:pt-0">
            <p class="text-xs text-[#A0A0A0] mb-1">Quota: ${key.current_usage || 0} / ${key.monthly_limit || 100}</p>
            <span class="inline-block px-2 py-1 rounded text-xs font-bold ${key.is_active ? 'bg-green-900 text-green-300' : 'bg-red-900 text-red-300'}">
              ${key.is_active ? 'ACTIVE' : 'INACTIVE'}
            </span>
          </div>
        </div>
      `).join('');
    }

    const createKeyBtn = document.getElementById('create-key-btn');
    if (createKeyBtn) {
      createKeyBtn.addEventListener('click', async () => {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) return;

        // Try to get user organization (for MVP using a default/mock shared one or just user id)
        // In a full implementation, we'd fetch the organization where the user is admin/owner
        const { data: membership } = await supabase
          .from('organization_members')
          .select('organization_id')
          .eq('user_id', session.user.id)
          .maybeSingle();
        
        if (!membership) {
          alert('You must be part of an organization to create API keys. Please contact support.');
          return;
        }

        try {
          // Use our new Edge Function for secure generation
          const response = await fetch(`${supabaseUrl}/functions/v1/generate-key`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${session.access_token}`
            },
            body: JSON.stringify({ 
              organization_id: membership.organization_id,
              name: 'My API Key'
            })
          });

          const result = await response.json();
          
          if (!response.ok) throw new Error(result.error);

          fetchApiKeys(session.user.id);
          alert(`New Key Created: ${result.apiKey}\n\nSAVE THIS KEY! It will never be shown again.\nPrefix: ${result.prefix}`);
          
        } catch (error) {
          alert('Error creating key: ' + error.message);
        }
      });
    }
  </script>
</Layout>
