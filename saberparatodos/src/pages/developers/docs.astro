---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="API Documentation | World Exams">
  <div class="min-h-screen bg-[#121212]">
    <section class="border-b border-white/10 bg-[#0f0f12] px-6 py-10 text-[#F5F5DC]">
      <div class="mx-auto max-w-6xl">
        <p class="text-xs font-bold uppercase tracking-[0.35em] text-[#FCD116]">API docs</p>
        <h1 class="mt-3 text-4xl font-black">SaberParaTodos API</h1>
        <p class="mt-4 max-w-3xl text-white/65">
          Referencia técnica del endpoint actual de preguntas. Genera tu key en <a href="/developers/dashboard" class="text-[#FCD116] underline">/developers/dashboard</a> y úsala en el header <code>Authorization: Bearer YOUR_API_KEY</code>.
        </p>
        <div class="mt-6 flex flex-wrap gap-3 text-sm">
          <a href="/developers/dashboard" class="rounded-lg bg-[#003893] px-4 py-2 font-bold text-white transition hover:bg-[#002776]">Abrir dashboard</a>
          <a href="/manual-plataforma" class="rounded-lg border border-white/15 px-4 py-2 font-bold text-white/80 transition hover:border-[#FCD116]/40 hover:text-white">Manual de uso</a>
        </div>
      </div>
    </section>
    <div id="swagger-ui"></div>
  </div>

  <link rel="stylesheet" href="https://unpkg.com/swagger-ui-dist@5.11.0/swagger-ui.css" />

  <script is:inline src="https://unpkg.com/swagger-ui-dist@5.11.0/swagger-ui-bundle.js"></script>
  <script is:inline>
    window.onload = () => {
      window.ui = SwaggerUIBundle({
        url: '/openapi.yaml',
        dom_id: '#swagger-ui',
        presets: [
          SwaggerUIBundle.presets.apis,
          SwaggerUIBundle.SwaggerUIStandalonePreset
        ],
        layout: "BaseLayout",
        theme: {
          "swagger-ui": {
            "bg": "#121212",
            "text": "#F5F5DC"
          }
        }
      });
    };
  </script>

  <style is:global>
    /* Dark Mode Overrides for Swagger UI */
    .swagger-ui {
      background-color: #121212;
      color: #F5F5DC;
      padding: 2rem;
    }
    .swagger-ui .info .title, .swagger-ui .info h1, .swagger-ui .info h2, .swagger-ui .info h3, .swagger-ui .info h4, .swagger-ui .info h5 {
      color: #F5F5DC;
      font-family: monospace;
    }
    .swagger-ui .scheme-container {
      background-color: #1A1A1A;
      box-shadow: none;
    }
    .swagger-ui .opblock .opblock-summary-operation-id, .swagger-ui .opblock .opblock-summary-path, .swagger-ui .opblock .opblock-summary-path__deprecated {
      color: #F5F5DC;
    }
    .swagger-ui .opblock-description-wrapper p, .swagger-ui .opblock-external-docs-wrapper p, .swagger-ui .opblock-title_normal p {
      color: #A0A0A0;
    }
    .swagger-ui table thead tr td, .swagger-ui table thead tr th {
      color: #F5F5DC;
    }
    .swagger-ui .response-col_status {
      color: #A0A0A0;
    }
    .swagger-ui .opblock .opblock-section-header h4 {
      color: #F5F5DC;
    }
    .swagger-ui label {
      color: #F5F5DC;
    }
    .swagger-ui .btn {
      color: #F5F5DC;
      border-color: #333;
    }
    .swagger-ui select {
      color: #333;
    }
    .swagger-ui input {
      background: #1A1A1A;
      color: #F5F5DC;
      border: 1px solid #333;
    }
  </style>
</Layout>
