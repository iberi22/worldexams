---
import Layout from '../layouts/Layout.astro';
import App from '../components/App.svelte';

const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL || 'https://worldexams-api.pages.dev/v1';
---

<Layout
  title="Zona de Práctica ICFES | SaberParaTodos"
  description="Accede a la app de práctica de SaberParaTodos para crear simulacros, entrenar por áreas y revisar resultados."
  keywords="practicar icfes, app icfes, simulacro saber 11, preguntas icfes"
  showNavbar={false}
  showFooter={false}
>
  <script is:inline type="application/json" id="api-config" set:html={JSON.stringify({ apiBaseUrl: API_BASE_URL })} />

  <App
    client:only="svelte"
    questions={[]}
    universalPool={null}
  />
</Layout>

<style is:global>
  .katex-display {
    margin: 1em 0;
    padding: 0.75em;
    background: rgba(16, 185, 129, 0.05);
    border-radius: 0.5rem;
    overflow-x: auto;
  }

  .katex {
    font-size: 1.1em;
  }

  .math-content strong {
    color: #10b981;
    font-weight: 600;
  }

  .math-content em {
    font-style: italic;
  }
</style>
