---
import Layout from '../layouts/Layout.astro';
import StatsIcfes from '../components/guia/StatsIcfes.astro';
import TenantRouteNotice from '../components/TenantRouteNotice.astro';
import { resolveRuntimeCountryConfig } from '../config';
import { getTenantRouteAvailability } from '../config/tenant-experience';

const country = resolveRuntimeCountryConfig(Astro.locals.country);
const availability = getTenantRouteAvailability(country, 'resultados2025');
---

<Layout
  title={`Resultados ${country.product.guideYear - 1} | ${country.product.siteName}`}
  description={`Lectura editorial de resultados para ${country.examName}.`}
>
  <div class="min-h-screen bg-[#121212] pt-16 pb-24 px-4">
    <div class="max-w-6xl mx-auto">
      {country.code === 'CO' ? (
        <>
          <section class="mb-16 pt-8 pb-4 text-center">
            <span class="inline-block px-3 py-1 text-xs font-mono bg-white/5 text-white/70 border border-white/10 rounded-full mb-4">
              Guia de interpretacion
            </span>
            <h1 class="text-4xl md:text-5xl font-bold text-[#F5F5DC] mb-6">
              Como interpretar tus resultados
            </h1>
            <p class="text-xl text-white/60 leading-relaxed max-w-[650px] mx-auto">
              Comprende como se distribuyen los puntajes a nivel nacional y que significa cada percentil con base en estadisticas oficiales de referencia.
            </p>
          </section>

          <section class="bg-gradient-to-b from-white/[0.03] to-transparent rounded-3xl p-6 md:p-10 border border-white/5" data-sr="fade-up" data-sr-delay="100">
            <StatsIcfes />
          </section>
        </>
      ) : (
        <TenantRouteNotice country={country} availability={availability} />
      )}
    </div>
  </div>
</Layout>
