---
import Layout from '../layouts/Layout.astro';
import StatsIcfes from '../components/guia/StatsIcfes.astro';
---

<Layout
  title="Resultados Pruebas Saber 11 2024 | SaberParaTodos"
  description="Explicación detallada de los resultados agregados del ICFES 2024: distribución de puntajes, percentiles y estadísticas por áreas."
>
  <div class="min-h-screen bg-[#121212] pt-16 pb-24 px-4">
    <div class="max-w-6xl mx-auto">

      <header class="mb-12 text-center" data-sr="fade-up">
        <span class="inline-block px-3 py-1 text-xs font-mono bg-white/5 text-white/70 border border-white/10 rounded-full mb-4">
          📊 Reporte de Estado 2024
        </span>
        <h1 class="text-4xl md:text-5xl font-bold text-[#F5F5DC] mb-6">
          Explicación de Resultados 2024
        </h1>
        <p class="text-xl text-white/60 max-w-2xl mx-auto">
          Comprende cómo se distribuyeron los puntajes a nivel nacional en las Pruebas Saber 11 de 2024 y qué significa cada percentil.
        </p>
      </header>

      <section class="bg-gradient-to-b from-white/[0.03] to-transparent rounded-3xl p-6 md:p-10 border border-white/5" data-sr="fade-up" data-sr-delay="100">
        <StatsIcfes />
      </section>

      <section class="mt-16 text-center" data-sr="fade-up" data-sr-delay="200">
        <h2 class="text-2xl font-bold text-[#F5F5DC] mb-6">¿Quieres mejorar tus proyecciones?</h2>
        <a href="/" class="inline-block px-8 py-3 bg-[#FCD116] text-black font-semibold rounded-lg hover:bg-yellow-400 transition-colors">
          Empieza a Practicar Ahora
        </a>
      </section>

    </div>
  </div>
</Layout>
