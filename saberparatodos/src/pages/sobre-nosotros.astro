---
import Layout from '../layouts/Layout.astro';
import FeedbackTrigger from '../components/FeedbackTrigger.svelte';
import { countryConfig } from '../config';
import { getSiteShellContent } from '../config/site-shell-content';

const shellContent = getSiteShellContent(countryConfig);
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : countryConfig.product.siteUrl.replace(/\/$/, '');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: countryConfig.product.siteName,
  alternateName: 'World Exams Organization',
  url: siteUrl,
  logo: `${siteUrl}/logo.png`,
  description: shellContent.about.description,
  foundingDate: '2024',
  founders: [
    {
      '@type': 'Organization',
      name: 'World Exams Organization'
    }
  ],
  sameAs: ['https://github.com/world-exams']
};
---

<Layout
  title={`${shellContent.about.title} | ${countryConfig.product.siteName}`}
  description={shellContent.about.description}
>
  <div class="min-h-screen bg-[#121212] text-[#F5F5DC]">
    <section class="py-16 px-4 border-b border-white/10">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-block px-3 py-1 text-xs font-mono bg-white/5 border border-white/10 rounded-full mb-4">
          {countryConfig.flag} World Exams Organization
        </span>
        <h1 class="text-4xl md:text-5xl font-bold mb-6">
          Sobre <span class="text-white/60">{countryConfig.product.siteName}</span>
        </h1>
        <p class="text-lg text-white/70 max-w-2xl mx-auto leading-relaxed">
          {shellContent.about.heroIntro}
        </p>
      </div>
    </section>

    <section class="py-16 px-4">
      <div class="max-w-6xl mx-auto">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-3xl font-bold mb-6">{shellContent.about.missionTitle}</h2>
            {shellContent.about.missionParagraphs.map((paragraph) => (
              <p class="text-white/70 mb-4 leading-relaxed">{paragraph}</p>
            ))}
          </div>

          <div class="bg-gradient-to-tr from-[#1a1a1a] to-[#252525] border border-white/10 rounded-3xl p-8 shadow-2xl relative overflow-hidden group">
            <div class="absolute inset-0 bg-emerald-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
            <svg viewBox="0 0 400 300" class="w-full relative z-10" aria-labelledby="mission-svg-title">
              <title id="mission-svg-title">Arquitectura multi-pais del runtime</title>
              <circle cx="200" cy="150" r="80" fill="none" stroke="#F5F5DC" stroke-width="0.5" opacity="0.2"/>
              <ellipse cx="200" cy="150" rx="80" ry="30" fill="none" stroke="#F5F5DC" stroke-width="0.5" opacity="0.2"/>
              <ellipse cx="200" cy="150" rx="30" ry="80" fill="none" stroke="#F5F5DC" stroke-width="0.5" opacity="0.2"/>
              <circle cx="175" cy="140" r="8" fill={countryConfig.theme.primary} class="animate-pulse"/>
              <circle cx="175" cy="140" r="12" fill="none" stroke={countryConfig.theme.primary} stroke-width="1" opacity="0.5">
                <animate attributeName="r" values="12;25;12" dur="3s" repeatCount="indefinite"/>
                <animate attributeName="opacity" values="0.5;0;0.5" dur="3s" repeatCount="indefinite"/>
              </circle>
              <text x="200" y="260" fill="#F5F5DC" font-size="12" text-anchor="middle" font-family="monospace" font-weight="bold" opacity="0.8">
                {shellContent.about.missionVisualCaption}
              </text>
              <text x="200" y="280" fill={countryConfig.theme.primary} font-size="10" text-anchor="middle" font-family="monospace" font-weight="bold">
                {shellContent.about.missionVisualSubcaption}
              </text>
            </svg>
          </div>
        </div>
      </div>
    </section>

    <section class="py-24 px-4 relative overflow-hidden">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-px bg-gradient-to-r from-transparent via-emerald-500/50 to-transparent"></div>
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-black mb-4 bg-clip-text text-transparent bg-gradient-to-b from-white to-white/60">
            {shellContent.about.ecosystemTitle}
          </h2>
          <p class="text-white/50 max-w-2xl mx-auto text-lg">
            {shellContent.about.ecosystemDescription}
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-[#1a1a1a] border border-amber-500/20 rounded-[2.5rem] p-10 hover:border-amber-500/40 transition-all duration-500 group relative overflow-hidden hover:-translate-y-2 shadow-xl hover:shadow-amber-500/5">
            <div class="absolute -right-20 -top-20 w-64 h-64 bg-amber-500/5 rounded-full blur-[80px] group-hover:bg-amber-500/10 transition-colors"></div>
            <div class="flex items-center gap-4 mb-8">
              <div class="w-16 h-16 bg-amber-500/10 rounded-2xl flex items-center justify-center text-3xl group-hover:scale-110 transition-transform duration-500 ring-1 ring-amber-500/20">
                NL
              </div>
              <div>
                <h3 class="text-2xl font-black text-amber-400 tracking-tight">NotebookLM</h3>
                <span class="text-[10px] bg-amber-500 text-black px-2 py-0.5 rounded font-black uppercase tracking-tighter">Research Layer</span>
              </div>
            </div>
            <p class="text-white/70 leading-relaxed">
              Usamos NotebookLM como apoyo para consolidar fuentes, guias y material de referencia antes de convertirlo en contenido localizado por tenant.
            </p>
          </div>

          <div class="bg-[#1a1a1a] border border-emerald-500/20 rounded-[2.5rem] p-10 hover:border-emerald-500/40 transition-all duration-500 group relative overflow-hidden hover:-translate-y-2 shadow-xl hover:shadow-emerald-500/5">
            <div class="absolute -right-20 -top-20 w-64 h-64 bg-emerald-500/5 rounded-full blur-[80px] group-hover:bg-emerald-500/10 transition-colors"></div>
            <div class="flex items-center gap-4 mb-8">
              <div class="w-16 h-16 bg-emerald-500/10 rounded-2xl flex items-center justify-center text-3xl group-hover:scale-110 transition-transform duration-500 shadow-[0_0_20px_rgba(16,185,129,0.1)] ring-1 ring-emerald-500/20">
                AI
              </div>
              <div>
                <h3 class="text-2xl font-black text-emerald-400 tracking-tight">Tutor Layer</h3>
                <span class="text-[10px] bg-emerald-500 text-black px-2 py-0.5 rounded font-black uppercase tracking-tighter">Prompt Runtime</span>
              </div>
            </div>
            <p class="text-white/70 leading-relaxed">
              La capa de prompts y asistentes convierte ese material en practica accionable, feedback y soporte contextual sin romper la consistencia del producto.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 px-4 border-t border-white/10 bg-white/[0.02]">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-bold mb-12 text-center">{shellContent.about.featureSectionTitle}</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {shellContent.about.features.map((feature) => (
            <div class="p-8 bg-[#1a1a1a] border border-white/5 rounded-2xl hover:border-white/20 transition-all duration-300">
              <h3 class="text-xl font-bold mb-3">{feature.title}</h3>
              <p class="text-white/60 text-sm leading-relaxed">{feature.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 px-4 border-t border-white/10">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-block p-4 bg-white/5 rounded-full mb-6">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor" class="text-[#F5F5DC]">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </div>
        <h2 class="text-3xl font-bold mb-6">100% Open Source</h2>
        <p class="text-lg text-white/70 mb-8 max-w-2xl mx-auto">
          El codigo del producto y la documentacion de arquitectura siguen visibles para auditoria, mejora y expansion hacia nuevos paises.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a
            href="https://github.com/world-exams"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 bg-[#F5F5DC] text-[#121212] font-semibold rounded-lg hover:bg-white transition-colors"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            Ver en GitHub
          </a>
          <FeedbackTrigger
            client:load
            label="Reportar problema"
            userContext="SobreNosotros_Hero"
          />
        </div>
      </div>
    </section>

    <section class="py-16 px-4 border-t border-white/10 bg-white/[0.02]">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-12 text-center">{shellContent.about.statsSectionTitle}</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
          {shellContent.about.stats.map((stat) => (
            <div class="p-6">
              <div class="text-4xl font-bold mb-2" style={`color: ${countryConfig.theme.primary};`}>{stat.value}</div>
              <div class="text-sm text-white/60">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 px-4 border-t border-white/10 bg-gradient-to-b from-transparent to-emerald-500/[0.02]">
      <div class="max-w-4xl mx-auto">
        <div class="grid md:grid-cols-2 gap-8">
          <div data-sr="fade-right">
            <h2 class="text-3xl font-bold mb-6">{shellContent.about.feedbackTitle}</h2>
            <p class="text-white/70 mb-8 leading-relaxed">
              {shellContent.about.feedbackDescription}
            </p>
            <div class="flex flex-wrap gap-4">
              <a
                href="https://github.com/world-exams/saberparatodos#contributing"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block px-6 py-3 bg-[#F5F5DC] text-[#121212] font-semibold rounded-lg hover:bg-white transition-colors"
              >
                {shellContent.about.contributionCta} →
              </a>
              <a
                href="/practica"
                class="inline-block px-6 py-3 border border-white/20 text-[#F5F5DC] font-semibold rounded-lg hover:bg-white/5 transition-colors"
              >
                {shellContent.about.practiceCta}
              </a>
            </div>
          </div>

          <div data-sr="fade-left">
            <FeedbackTrigger
              client:visible
              variant="card"
              label="Buzon de sugerencias"
              description="Envia comentarios directamente al equipo del producto. No necesitas cuenta de GitHub."
              userContext="SobreNosotros_Card"
            />
          </div>
        </div>
      </div>
    </section>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
