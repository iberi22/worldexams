---
import Layout from '../layouts/Layout.astro';
import ExamInfographic from '../components/guia/ExamInfographic.astro';
import GradeCard from '../components/guia/GradeCard.astro';
import CompetencyList from '../components/guia/CompetencyList.astro';
import TipsSection from '../components/guia/TipsSection.astro';
import StatsIcfes from '../components/guia/StatsIcfes.astro';
import { countryConfig } from '../config';
import { getExamGuideContent } from '../config/exam-guide-content';

const guideContent = getExamGuideContent(countryConfig);
const isCO = guideContent.variant === 'co';
const isMX = guideContent.variant === 'mx';
const siteUrl = Astro.site ? Astro.site.toString() : countryConfig.product.siteUrl;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: guideContent.faq.map((entry) => ({
    '@type': 'Question',
    name: entry.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: entry.answer,
    },
  })),
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: `${guideContent.heroTitle} - ${countryConfig.name}`,
      description: guideContent.heroDescription,
      provider: {
        '@type': 'Organization',
        name: 'World Exams',
        url: siteUrl,
      },
      about: {
        '@type': 'EducationalOccupationalCredential',
        name: countryConfig.examName,
        credentialCategory: 'Guia de examen',
      },
    },
    faqSchema,
  ],
};
---

<Layout
  title={`${guideContent.heroTitle} | ${countryConfig.name}`}
  description={guideContent.heroDescription}
  keywords={guideContent.keywords.join(', ')}
>
  <div class="min-h-screen background text-foreground relative overflow-hidden">
    <div class="hero-gradient"></div>

    <section class="py-24 px-4 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-block px-3 py-1 text-[10px] font-mono tracking-widest uppercase bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 rounded-full mb-8 animate-fade-in-up">
          Guia verificada con fuentes {guideContent.badgeSourceLabel}
        </span>
        <h1 class="text-4xl md:text-6xl font-black mb-8 animate-fade-in-up animate-fade-in-up-delay-1 tracking-tight">
          {guideContent.heroTitle} <br />
          <span class="text-white/40 font-bold text-3xl md:text-4xl">{guideContent.heroSubtitle}</span>
        </h1>
        <p class="text-lg md:text-xl text-white/60 max-w-2xl mx-auto animate-fade-in-up animate-fade-in-up-delay-2 leading-relaxed">
          {guideContent.heroDescription}
        </p>
      </div>
    </section>

    {isCO && (
      <>
        <section class="py-16 px-4 relative z-10" data-sr="fade-up">
          <div class="max-w-6xl mx-auto">
            <h2 class="text-3xl font-bold mb-12 text-center">Como se organiza la evaluacion en Colombia</h2>
            <div class="glass p-8 rounded-3xl">
              <ExamInfographic />
            </div>
          </div>
        </section>

        <section class="py-20 px-4 border-t border-white/5 relative z-10">
          <div class="max-w-6xl mx-auto">
            <h2 class="text-3xl font-bold mb-12 text-center" data-sr="fade-up">Que evalua el sistema por grado</h2>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
              <GradeCard
                grade="3°"
                title="Saber 3°"
                description="Seguimiento temprano de aprendizajes base en primaria."
                subjects={["Matematicas", "Lenguaje"]}
                duration="Convocatoria oficial"
                questions="80 a 100 reactivos aproximados"
              />
              <GradeCard
                grade="5°"
                title="Saber 5°"
                description="Control de competencias basicas al cierre de primaria."
                subjects={["Matematicas", "Lenguaje", "Ciencias Naturales"]}
                duration="Sesion unica"
                questions="Segun convocatoria"
              />
              <GradeCard
                grade="7°"
                title="Saber 7°"
                description="Punto de control intermedio para secundaria."
                subjects={["Matematicas", "Lectura Critica", "Habilidades Ciudadanas"]}
                duration="Jornada oficial"
                questions="Estructura variable"
              />
              <GradeCard
                grade="9°"
                title="Saber 9°"
                description="Evaluacion de cierre de basica secundaria."
                subjects={["Matematicas", "Lenguaje", "Ciencias", "Habilidades Ciudadanas"]}
                duration="Convocatoria ICFES"
                questions="Consulta oficial vigente"
              />
              <GradeCard
                grade="11°"
                title="Saber 11°"
                description="Examen de Estado para estudiantes de grado 11 y poblacion habilitada."
                subjects={["Lectura Critica", "Matematicas", "Sociales y Ciudadanas", "Ciencias Naturales", "Ingles"]}
                duration="9 horas en dos sesiones"
                questions="230 calificables / 278 con cuestionario"
                highlight={true}
              />
              {countryConfig.features.preuniversitario && (
                <a href="/?subject=Preuniversitario&grade=11" class="block rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-[#FCD116]">
                  <GradeCard
                    grade="PreU"
                    title="Preuniversitario"
                    description="Ruta adicional para admision universitaria con simulacros y blueprints especificos."
                    subjects={["Diagnostico", "Practica por componente", "Simulacro realista", "Overlay por carrera"]}
                    duration="Modulos de tiempo real"
                    questions="20 a 120 preguntas"
                    highlight={true}
                  />
                </a>
              )}
            </div>
          </div>
        </section>

        <section class="py-20 px-4 border-t border-white/5 bg-gradient-to-b from-transparent to-emerald-500/[0.02] relative z-10">
          <div class="max-w-6xl mx-auto">
            <h2 class="text-3xl font-bold mb-4 text-center" data-sr="fade-up">
              Estadisticas de referencia
            </h2>
            <p class="text-white/40 text-center mb-12 text-sm uppercase tracking-widest" data-sr="fade-up" data-sr-delay="100">
              Resumen basado en la guia de orientacion oficial
            </p>
            <div class="glass p-8 rounded-3xl">
              <StatsIcfes />
            </div>
          </div>
        </section>
      </>
    )}

    {isMX && (
      <>
        <section class="py-20 px-4 relative z-10" data-sr="fade-up">
          <div class="max-w-6xl mx-auto">
            <h2 class="text-3xl font-bold mb-12 text-center text-[#F5F5DC]">Estructura general del examen</h2>
            <div class="grid md:grid-cols-3 gap-8">
              <GradeCard
                grade="A"
                title="Transversales"
                description="Habilidades fundamentales para todos los aspirantes."
                subjects={["Comprension Lectora", "Redaccion Indirecta", "Pensamiento Matematico"]}
                duration="Base del examen"
                questions="90 preguntas"
                highlight={true}
              />
              <GradeCard
                grade="B"
                title="Modulos especificos"
                description="Conocimientos ligados a la carrera o institucion."
                subjects={["Modulo 1", "Modulo 2", "Ejemplos por area"]}
                duration="Varia segun carrera"
                questions="48 preguntas"
              />
              <GradeCard
                grade="C"
                title="Diagnostico"
                description="Informacion adicional fuera del puntaje principal."
                subjects={["Ingles", "Reactivos piloto"]}
                duration="Seccion final"
                questions="30 preguntas"
              />
            </div>
          </div>
        </section>

        <section class="py-20 px-4 border-t border-white/5 bg-white/[0.01] relative z-10">
          <div class="max-w-4xl mx-auto">
            <h2 class="text-3xl font-bold mb-12 text-center" data-sr="fade-up">EXANI-II en detalle</h2>
            <div class="glass p-8 rounded-3xl flex flex-col items-center" data-sr="zoom-in" data-sr-delay="100">
              <div class="w-full max-w-lg space-y-6">
                <div>
                  <div class="flex justify-between text-[10px] uppercase tracking-widest mb-2 text-white/60">
                    <span>Habilidades transversales</span>
                    <span class="font-bold text-emerald-400">54%</span>
                  </div>
                  <div class="w-full bg-white/5 rounded-full h-3 overflow-hidden border border-white/5">
                    <div class="bg-gradient-to-r from-emerald-600 to-emerald-400 h-full rounded-full" style="width: 54%"></div>
                  </div>
                </div>
                <div>
                  <div class="flex justify-between text-[10px] uppercase tracking-widest mb-2 text-white/60">
                    <span>Modulos especificos</span>
                    <span class="font-bold text-blue-400">28%</span>
                  </div>
                  <div class="w-full bg-white/5 rounded-full h-3 overflow-hidden border border-white/5">
                    <div class="bg-gradient-to-r from-blue-600 to-blue-400 h-full rounded-full" style="width: 28%"></div>
                  </div>
                </div>
                <div>
                  <div class="flex justify-between text-[10px] uppercase tracking-widest mb-2 text-white/60">
                    <span>Ingles diagnostico</span>
                    <span class="font-bold text-purple-400">18%</span>
                  </div>
                  <div class="w-full bg-white/5 rounded-full h-3 overflow-hidden border border-white/5">
                    <div class="bg-gradient-to-r from-purple-600 to-purple-400 h-full rounded-full" style="width: 18%"></div>
                  </div>
                </div>
              </div>
              <p class="text-center text-white/40 text-xs mt-10 uppercase tracking-widest">
                Total: <strong class="text-white">168 preguntas</strong> • Duracion: <strong class="text-white">4.5 horas</strong>
              </p>
            </div>
          </div>
        </section>
      </>
    )}

    {!isCO && !isMX && (
      <section class="py-20 px-4 border-t border-white/5 relative z-10">
        <div class="max-w-5xl mx-auto">
          <div class="glass p-8 rounded-3xl">
            <p class="text-xs uppercase tracking-[0.28em] text-white/35 mb-4">Tenant template mode</p>
            <h2 class="text-3xl font-black mb-6">La guia todavia esta en fase de localizacion</h2>
            <p class="text-white/65 leading-relaxed mb-6">
              Este tenant ya usa el runtime compartido de <strong class="text-white">saberparatodos</strong> para layout, SEO, tematizacion y experiencia base.
              Lo que sigue pendiente es completar el contenido institucional y curricular especifico de {countryConfig.name}.
            </p>
            <div class="grid md:grid-cols-3 gap-4">
              <div class="rounded-2xl bg-white/[0.03] p-5 border border-white/8">
                <p class="text-[11px] uppercase tracking-[0.22em] text-white/35 mb-2">Compartido</p>
                <p class="text-sm text-white/70">Runtime, theming, rutas base, widgets y metadata estructural.</p>
              </div>
              <div class="rounded-2xl bg-white/[0.03] p-5 border border-white/8">
                <p class="text-[11px] uppercase tracking-[0.22em] text-white/35 mb-2">Por localizar</p>
                <p class="text-sm text-white/70">Blueprint del examen, copy institucional, calendario y fuentes oficiales por pais.</p>
              </div>
              <div class="rounded-2xl bg-white/[0.03] p-5 border border-white/8">
                <p class="text-[11px] uppercase tracking-[0.22em] text-white/35 mb-2">Siguiente paso</p>
                <p class="text-sm text-white/70">Extender config y contenido, no clonar la aplicacion ni crear un frontend paralelo.</p>
              </div>
            </div>
          </div>
        </div>
      </section>
    )}

    <section class="py-20 px-4 border-t border-white/5 relative z-10">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-bold mb-12 text-center" data-sr="fade-up">Competencias clave</h2>
        <div data-sr="fade-up" data-sr-delay="100">
          <CompetencyList />
        </div>
      </div>
    </section>

    <section class="py-20 px-4 border-t border-white/5 bg-gradient-to-t from-emerald-500/[0.02] to-transparent relative z-10">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-bold mb-12 text-center" data-sr="fade-up">Estrategias y recomendaciones</h2>
        <div data-sr="fade-up" data-sr-delay="100">
          <TipsSection />
        </div>
      </div>
    </section>

    <section class="py-24 px-4 border-t border-white/5 relative z-10 overflow-hidden">
      <div class="absolute inset-0 bg-emerald-500/[0.03] animate-pulse-slow"></div>
      <div class="max-w-2xl mx-auto text-center relative z-10" data-sr="zoom-in">
        <h2 class="text-4xl font-black mb-6 tracking-tight">{guideContent.ctaTitle}</h2>
        <p class="text-white/60 mb-10 text-lg leading-relaxed">
          {guideContent.ctaDescription}
        </p>
        <a
          href="/practica"
          class="inline-block px-10 py-4 bg-emerald-500 text-black font-black uppercase tracking-widest text-sm rounded-xl hover:bg-emerald-400 hover:scale-105 transition-all shadow-xl shadow-emerald-500/20"
        >
          {guideContent.ctaLabel} →
        </a>
      </div>
    </section>

    <section class="py-16 px-4 border-t border-white/5 bg-white/[0.01] relative z-10">
      <div class="max-w-3xl mx-auto">
        <div class="glass p-8 rounded-2xl flex flex-col md:flex-row items-center gap-8 border-dashed border-white/10" data-sr="fade-up">
          <div class="w-24 h-24 rounded-full bg-gradient-to-br from-emerald-500 to-blue-600 flex items-center justify-center text-3xl shrink-0 shadow-lg shadow-emerald-500/20">
            📊
          </div>
          <div class="text-center md:text-left">
            <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-emerald-400 mb-2 block">Autoridad pedagogica</span>
            <h3 class="text-xl font-bold mb-3">Equipo de investigacion World Exams</h3>
            <p class="text-white/50 text-sm leading-relaxed mb-4">
              {guideContent.authoritySummary}
            </p>
            <div class="flex flex-wrap justify-center md:justify-start gap-4">
              <span class="text-[9px] bg-white/5 px-2 py-1 rounded border border-white/10 text-white/40 uppercase">Runtime compartido por tenant</span>
              <span class="text-[9px] bg-white/5 px-2 py-1 rounded border border-white/10 text-white/40 uppercase">{guideContent.authorityUpdatedLabel}</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
