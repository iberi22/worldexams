---
import Layout from '../layouts/Layout.astro';
import ExamInfographic from '../components/guia/ExamInfographic.astro';
import GradeCard from '../components/guia/GradeCard.astro';
import CompetencyList from '../components/guia/CompetencyList.astro';
import TipsSection from '../components/guia/TipsSection.astro';
import StatsIcfes from '../components/guia/StatsIcfes.astro';
import { countryConfig } from '../config';

const isMX = countryConfig.code === 'MX';
const isCO = countryConfig.code === 'CO';

const heroTitle = isMX ? 'Guía Completa EXANI-II' : 'Guía Pruebas Saber';
const heroSubtitle = isMX ? 'Examen Nacional de Ingreso a la Educación Superior' : 'Pruebas de Estado Saber';
const heroDesc = isMX
  ? 'Domina la estructura del CENEVAL EXANI-II. Conoce las áreas transversales, módulos específicos y asegura tu lugar.'
  : 'Conoce la estructura de las pruebas de estado colombianas, las competencias evaluadas y las mejores estrategias.';
const siteUrl = Astro.site ? Astro.site.toString() : 'https://saberparatodos.space';

// Schema.org structured data for SEO
const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": `${heroTitle} - ${countryConfig.name}`,
  "description": heroDesc,
  "provider": {
    "@type": "Organization",
    "name": "World Exams",
    "url": siteUrl
  },
  "about": {
    "@type": "EducationalOccupationalCredential",
    "name": isMX ? "EXANI-II" : "Pruebas Saber",
    "credentialCategory": "Examen de Admisión"
  }
};
---

<Layout
  title={`${heroTitle} | ${countryConfig.name}`}
  description={heroDesc}
>
  <div class="min-h-screen bg-[#121212] text-[#F5F5DC]">
    <!-- Hero Section -->
    <section class="py-16 px-4 border-b border-white/10">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-block px-3 py-1 text-xs font-mono bg-white/5 border border-white/10 rounded-full mb-4 animate-fade-in-up">
          📚 Guía Oficial {new Date().getFullYear()}
        </span>
        <h1 class="text-4xl md:text-5xl font-bold mb-6 animate-fade-in-up animate-fade-in-up-delay-1">
          {heroTitle} <span class="text-white/60">{heroSubtitle}</span>
        </h1>
        <p class="text-lg text-white/70 max-w-2xl mx-auto animate-fade-in-up animate-fade-in-up-delay-2">
          {heroDesc}
        </p>
      </div>
    </section>

    {/* =========================================
        COLOMBIA SPECIFIC CONTENT (Saber 11)
       ========================================= */}
    {isCO && (
      <>
        <!-- Main Infographic -->
        <section class="py-12 px-4" data-sr="fade-up">
          <div class="max-w-6xl mx-auto">
            <h2 class="text-2xl font-bold mb-8 text-center">Estructura del Sistema de Pruebas de Estado</h2>
            <ExamInfographic />
          </div>
        </section>

        <!-- Grade Cards -->
        <section class="py-12 px-4 border-t border-white/10">
          <div class="max-w-6xl mx-auto">
            <h2 class="text-2xl font-bold mb-8 text-center" data-sr="fade-up">Pruebas por Grado</h2>
            <div class="grid md:grid-cols-2 gap-6">
              <div data-sr="fade-up" data-sr-delay="0">
                <GradeCard
                  grade="3°"
                  title="Saber 3°"
                  description="Evaluación diagnóstica para estudiantes de tercer grado de primaria."
                  subjects={["Matemáticas", "Lenguaje"]}
                  duration="2-3 horas"
                  questions="~54 preguntas"
                />
              </div>
              <div data-sr="fade-up" data-sr-delay="100">
                <GradeCard
                  grade="5°"
                  title="Saber 5°"
                  description="Evaluación al finalizar la básica primaria. Incluye competencias ciudadanas."
                  subjects={["Matemáticas", "Lenguaje", "Ciencias Naturales", "Competencias Ciudadanas"]}
                  duration="4-5 horas"
                  questions="~100 preguntas"
                />
              </div>
              <div data-sr="fade-up" data-sr-delay="200">
                <GradeCard
                  grade="9°"
                  title="Saber 9°"
                  description="Evaluación al finalizar la educación básica secundaria."
                  subjects={["Matemáticas", "Lenguaje", "Ciencias Naturales", "Competencias Ciudadanas"]}
                  duration="4-5 horas"
                  questions="~100 preguntas"
                />
              </div>
              <div data-sr="fade-up" data-sr-delay="300">
                <GradeCard
                  grade="11°"
                  title="Saber 11°"
                  description="Examen de Estado obligatorio para acceder a la educación superior."
                  subjects={["Lectura Crítica", "Matemáticas", "Sociales y Ciudadanas", "Ciencias Naturales", "Inglés"]}
                  duration="9 horas (2 sesiones)"
                  questions="~230 preguntas"
                  highlight={true}
                />
              </div>
            </div>
          </div>
        </section>

        <!-- Statistics Section -->
        <section class="py-12 px-4 border-t border-white/10 bg-gradient-to-b from-transparent to-white/[0.02]">
          <div class="max-w-6xl mx-auto">
            <h2 class="text-2xl font-bold mb-2 text-center" data-sr="fade-up">
              📊 Estadísticas Pruebas de Estado
            </h2>
            <p class="text-white/60 text-center mb-8 text-sm" data-sr="fade-up" data-sr-delay="100">
              Datos reales de los resultados nacionales
            </p>
            <StatsIcfes />
          </div>
        </section>
      </>
    )}

    {/* =========================================
        MEXICO SPECIFIC CONTENT (EXANI-II)
       ========================================= */}
    {isMX && (
      <>
        <!-- Structure Overview -->
        <section class="py-12 px-4" data-sr="fade-up">
          <div class="max-w-6xl mx-auto">
            <h2 class="text-2xl font-bold mb-8 text-center text-[#F5F5DC]">Estructura General del Examen</h2>
            <div class="grid md:grid-cols-3 gap-6">
              <GradeCard
                grade="A"
                title="Transversales"
                description="Habilidades fundamentales para todos los aspirantes."
                subjects={["Comprensión Lectora (30)", "Redacción Indirecta (30)", "Pensamiento Matemático (30)"]}
                duration="Base del examen"
                questions="90 preguntas"
                highlight={true}
              />
              <GradeCard
                grade="B"
                title="Módulos Específicos"
                description="Conocimientos relacionados con la carrera de ingreso."
                subjects={["Módulo 1 (24 preguntas)", "Módulo 2 (24 preguntas)", "Ej: Derecho, Salud, Ingenierías"]}
                duration="Varía según carrera"
                questions="48 preguntas"
              />
              <GradeCard
                grade="C"
                title="Diagnóstico"
                description="Información diagnóstica no considerada en el puntaje global."
                subjects={["Inglés (30 preguntas)", "Reactivos Piloto"]}
                duration="Sección final"
                questions="30 preguntas"
              />
            </div>
          </div>
        </section>

        <!-- Detailed Breakdown Charts for MX -->
        <section class="py-12 px-4 border-t border-white/10 bg-white/5">
          <div class="max-w-4xl mx-auto">
            <h2 class="text-2xl font-bold mb-8 text-center" data-sr="fade-up">EL EXANI-II en Detalle</h2>
            <div class="mb-12" data-sr="zoom-in" data-sr-delay="100">
              <h3 class="text-lg font-semibold mb-6 text-center text-white/70">Composición de Reactivos</h3>
              <div class="bg-[#1a1a1a] border border-white/10 rounded-lg p-6 flex flex-col items-center">
                 <div class="w-full max-w-lg space-y-4">
                    <div>
                      <div class="flex justify-between text-xs mb-1">
                        <span>Habilidades Transversales</span>
                        <span class="font-bold">54%</span>
                      </div>
                      <div class="w-full bg-white/10 rounded-full h-4 overflow-hidden">
                        <div class="bg-[#006847] h-full rounded-full" style="width: 54%"></div>
                      </div>
                    </div>
                    <div>
                      <div class="flex justify-between text-xs mb-1">
                        <span>Módulos Específicos</span>
                        <span class="font-bold">28%</span>
                      </div>
                      <div class="w-full bg-white/10 rounded-full h-4 overflow-hidden">
                        <div class="bg-[#CE1126] h-full rounded-full" style="width: 28%"></div>
                      </div>
                    </div>
                    <div>
                      <div class="flex justify-between text-xs mb-1">
                        <span>Inglés (Diagnóstico)</span>
                        <span class="font-bold">18%</span>
                      </div>
                      <div class="w-full bg-white/10 rounded-full h-4 overflow-hidden">
                        <div class="bg-white/60 h-full rounded-full" style="width: 18%"></div>
                      </div>
                    </div>
                 </div>
                 <p class="text-center text-white/60 text-sm mt-8">
                   Total: <strong>168 Preguntas</strong> | Duración: <strong>4.5 Horas</strong> (Sesión Única)
                 </p>
              </div>
            </div>
          </div>
        </section>
      </>
    )}

    {/* =========================================
        SHARED CONTENT (Tips, Competencies, CTA)
       ========================================= */}

    <!-- Competencies (Generic enough) -->
    <section class="py-12 px-4 border-t border-white/10">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-2xl font-bold mb-8 text-center" data-sr="fade-up">Competencias Clave</h2>
        <div data-sr="fade-up" data-sr-delay="100">
          <CompetencyList />
        </div>
      </div>
    </section>

    <!-- Tips Section -->
    <section class="py-12 px-4 border-t border-white/10">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-2xl font-bold mb-8 text-center" data-sr="fade-up">Consejos para el Éxito</h2>
        <div data-sr="fade-up" data-sr-delay="100">
          <TipsSection />
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 px-4 border-t border-white/10">
      <div class="max-w-2xl mx-auto text-center" data-sr="zoom-in">
        <h2 class="text-2xl font-bold mb-4">¿Listo para practicar?</h2>
        <p class="text-white/70 mb-8">
          Accede a nuestro banco de preguntas gratuito y comienza a prepararte hoy.
        </p>
        <a
          href="/"
          class="inline-block px-8 py-3 bg-[#F5F5DC] text-[#121212] font-semibold rounded-lg hover:bg-white transition-colors"
        >
          Comenzar Práctica →
        </a>
      </div>
    </section>
  </div>

  <!-- Schema.org JSON-LD -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
