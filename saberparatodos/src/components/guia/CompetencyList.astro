---
import type { CompetencyData } from '../../config/exam-guide-content';

interface Props {
  data: CompetencyData;
  badgeLabel?: string;
}

const { data, badgeLabel = 'Referencia oficial' } = Astro.props;
---

<div class="space-y-8">
  <section class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
    {data.areas.map((area, index) => (
      <article class="relative overflow-hidden rounded-3xl border border-white/10 bg-[#1a1a1a] p-6 shadow-lg shadow-black/10" data-sr="fade-up" data-sr-delay={String(index * 80)}>
        <div class="mb-4 flex items-center justify-between">
          <span class="text-[10px] uppercase tracking-[0.28em] text-[var(--color-primary)]">{badgeLabel}</span>
          <span class="rounded-full border border-white/10 bg-white/[0.04] px-2 py-1 text-[10px] uppercase tracking-[0.2em] text-white/45">
            Area {index + 1}
          </span>
        </div>
        <h3 class="border-l-2 border-[var(--color-secondary)] pl-3 text-lg font-bold text-white">{area.title}</h3>
        <p class="mt-3 text-sm leading-relaxed text-white/60">{area.description}</p>
        <p class="mt-4 text-xs leading-relaxed text-white/40">{area.meta}</p>
      </article>
    ))}
  </section>

  <section class="rounded-3xl border border-white/10 bg-white/[0.02] p-6">
    <h3 class="text-center text-lg font-bold text-white">{data.reportingTitle}</h3>
    <div class="mt-5 grid gap-4 md:grid-cols-3">
      {data.resultNotes.map((note) => (
        <div class="rounded-2xl border border-white/10 bg-[#1a1a1a] p-4 text-sm leading-relaxed text-white/60">
          {note}
        </div>
      ))}
    </div>
  </section>
</div>
