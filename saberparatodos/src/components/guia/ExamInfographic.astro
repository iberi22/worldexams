---
import type { InfographicData } from '../../config/exam-guide-content';

interface Props {
  data: InfographicData;
}

const { data } = Astro.props;
const { stages, highlightFacts, description, subtitle, title, highlightTitle, operationalTitle, operationalNotes } = data;
---

<div class="space-y-12">
  <header class="flex flex-col items-center text-center">
    <p class="mb-4 text-[11px] uppercase tracking-[0.4em] text-white/35">{subtitle}</p>
    <h3 class="max-w-3xl text-3xl font-black text-white md:text-4xl">{title}</h3>
    <p
      class="mt-6 text-sm leading-relaxed text-white/55"
      style="font-family: 'Inter', sans-serif; text-align: center; display: block; width: 100%; max-width: 500px; margin: 0 auto;"
    >
      {description}
    </p>
  </header>

  <section class="grid gap-6 md:grid-cols-5 md:gap-4 lg:gap-8">
    {stages.map((stage, index) => (
      <article class="relative overflow-hidden rounded-3xl border border-white/10 bg-[#1a1a1a] p-4 text-center">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full border border-white/10 bg-white/[0.04] text-lg font-black text-[#F5F5DC]">
          {stage.grade}
        </div>
        <p class="mt-4 text-[11px] uppercase tracking-[0.24em] text-white/35">{stage.title}</p>
        <h4 class="mt-2 text-base font-bold text-white">{stage.label}</h4>
        <ul class="mt-3 space-y-1 text-xs leading-relaxed text-white/55">
          {stage.subjects.map((subject) => (
            <li>{subject}</li>
          ))}
        </ul>
        {index < stages.length - 1 && (
          <div class="mx-auto mt-4 hidden h-px w-20 bg-gradient-to-r from-[var(--color-primary)] via-[var(--color-secondary)] to-[var(--color-accent)] md:block"></div>
        )}
      </article>
    ))}
  </section>

  <section class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:gap-12">
    <article class="rounded-3xl border border-white/10 bg-[#1a1a1a] p-6">
      <h4 class="text-lg font-bold text-white">{highlightTitle}</h4>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        {highlightFacts.map((fact) => (
          <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-4 text-sm text-white/65">{fact}</div>
        ))}
      </div>
    </article>

    <article class="rounded-3xl border border-white/10 bg-white/[0.02] p-6">
      <h4 class="text-lg font-bold text-white">{operationalTitle}</h4>
      <ul class="mt-4 space-y-3 text-sm leading-relaxed text-white/60">
        {operationalNotes.map((note) => (
          <li>{note}</li>
        ))}
      </ul>
    </article>
  </section>
</div>
