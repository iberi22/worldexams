[{"bloom": "Remember", "icfes": "Pensamiento Social", "stem": "Qué son husos horarios?", "options": [["A", "Zonas climáticas", "Incorrecto."], ["B", "Franjas de 15° para misma hora", "Correcto!"], ["C", "Países", "Incorrecto."], ["D", "Continentes", "Incorrecto."]], "correct": "B", "explanation": "24 husos."}, {"bloom": "Remember", "icfes": "Pensamiento Social", "stem": "Cuántos husos horarios hay?", "options": [["A", "12", "Incorrecto."], ["B", "24", "Correcto!"], ["C", "36", "Incorrecto."], ["D", "48", "Incorrecto."]], "correct": "B", "explanation": "24 husos, uno por hora."}, {"bloom": "Understand", "icfes": "Pensamiento Social", "stem": "Por qué se crearon?", "options": [["A", "Capricho", "Incorrecto."], ["B", "Estandarizar hora para ferrocarriles (1884)", "Correcto!"], ["C", "Religión", "Incorrecto."], ["D", "Astronomía", "Incorrecto."]], "correct": "B", "explanation": "Cada ciudad tenía su hora."}, {"bloom": "Apply", "icfes": "Pensamiento Social", "stem": "Colombia UTC-5. Si 12:00 en Bogotá, hora en Greenwich?", "options": [["A", "7 a.m.", "Incorrecto."], ["B", "5 p.m.", "Correcto!"], ["C", "12 p.m.", "Incorrecto."], ["D", "5 a.m.", "Incorrecto."]], "correct": "B", "explanation": "Londres = 17:00."}, {"bloom": "Understand", "icfes": "Pensamiento Social", "stem": "Línea Internacional de Cambio de Fecha:", "options": [["A", "Frontera", "Incorrecto."], ["B", "Línea en Pacífico (180°), cambia fecha", "Correcto!"], ["C", "Ecuador", "Incorrecto."], ["D", "Trópico", "Incorrecto."]], "correct": "B", "explanation": "Al este, resta un día."}, {"bloom": "Analyze", "icfes": "Pensamiento Social", "stem": "Por qué Colombia no cambia hora estacional?", "options": [["A", "No quiere", "Incorrecto."], ["B", "Cerca del ecuador, duración día constante", "Correcto!"], ["C", "Por ley", "Incorrecto."], ["D", "Por Estados Unidos", "Incorrecto."]], "correct": "B", "explanation": "Variación solar mínima."}, {"bloom": "Remember", "icfes": "Pensamiento Social", "stem": "Siglas UTC significan:", "options": [["A", "Universal Time Central", "Incorrecto."], ["B", "Tiempo Universal Coordinado", "Correcto!"], ["C", "United Time Code", "Incorrecto."], ["D", "Universal Clock", "Incorrecto."]], "correct": "B", "explanation": "Base del tiempo mundial."}, {"bloom": "Apply", "icfes": "Pensamiento Social", "stem": "Si en Greenwich son 0:00, qué hora es en Colombia?", "options": [["A", "5 a.m.", "Incorrecto."], ["B", "7 p.m.", "Correcto!"], ["C", "7 a.m.", "Incorrecto."], ["D", "5 p.m.", "Incorrecto."]], "correct": "B", "explanation": "UTC-5 = 19:00 del día anterior."}, {"bloom": "Evaluate", "icfes": "Pensamiento Social", "stem": "Importancia de los husos horarios:", "options": [["A", "Ninguna", "Incorrecto."], ["B", "Coordinación global de viajes y comunicaciones", "Correcto!"], ["C", "Solo barcos", "Incorrecto."], ["D", "Solo aviones", "Incorrecto."]], "correct": "B", "explanation": "Organizan el tiempo mundial."}, {"bloom": "Understand", "icfes": "Pensamiento Social", "stem": "Qué relación hay entre huso y longitud?", "options": [["A", "Ninguna", "Incorrecto."], ["B", "15° de longitud = 1 hora de diferencia", "Correcto!"], ["C", "30° = 1 hora", "Incorrecto."], ["D", "90° = 1 hora", "Incorrecto."]], "correct": "B", "explanation": "360°/24h = 15°/hora."}]