[{"bloom": "Remember", "icfes": "Pensamiento Social", "stem": "¿Qué significa 'Neolítico'?", "options": [["A", "Piedra antigua", "Incorrecto."], ["B", "Piedra nueva (pulida)", "Correcto!"], ["C", "Edad del metal", "Incorrecto."], ["D", "Nueva era", "Incorrecto."]], "correct": "B", "explanation": "'Neolítico' = 'piedra nueva', por la técnica de pulir la piedra."}, {"bloom": "Remember", "icfes": "Pensamiento Social", "stem": "¿Qué se domesticó primero en el Creciente Fértil?", "options": [["A", "Maíz y papa", "Incorrecto."], ["B", "Trigo, cebada, cabras y ovejas", "Correcto!"], ["C", "Arroz", "Incorrecto."], ["D", "Sorgo", "Incorrecto."]], "correct": "B", "explanation": "En el Creciente Fértil (~9000 a.C.) se domesticaron trigo, cebada, cabras y ovejas."}, {"bloom": "Understand", "icfes": "Pensamiento Social", "stem": "¿Cómo cambió la vida con el sedentarismo neolítico?", "options": [["A", "Volvieron a cuevas", "Incorrecto."], ["B", "Aldeas permanentes, cerámica, crecimiento poblacional", "Correcto!"], ["C", "Siguieron nómadas", "Incorrecto."], ["D", "Sin arte", "Incorrecto."]], "correct": "B", "explanation": "El sedentarismo permitió viviendas estables, aldeas y almacenamiento de excedentes."}, {"bloom": "Apply", "icfes": "Pensamiento Social", "stem": "¿Para qué servía la cerámica neolítica?", "options": [["A", "Decorar", "Incorrecto."], ["B", "Almacenar granos, cocinar, transportar agua", "Correcto!"], ["C", "Escribir", "Incorrecto."], ["D", "Armas", "Incorrecto."]], "correct": "B", "explanation": "Era esencial para almacenar excedentes agrícolas y cocinar."}, {"bloom": "Understand", "icfes": "Pensamiento Social", "stem": "¿Qué animales se domesticaron primero?", "options": [["A", "Caballos", "Incorrecto."], ["B", "Cabras, ovejas y cerdos", "Correcto!"], ["C", "Vacas", "Incorrecto."], ["D", "Perros", "Incorrecto."]], "correct": "B", "explanation": "Proporcionaban carne, leche, lana y cuero."}, {"bloom": "Analyze", "icfes": "Pensamiento Social", "stem": "¿Por qué la agricultura empezó en el Creciente Fértil?", "options": [["A", "Eran más inteligentes", "Incorrecto."], ["B", "Suelos fértiles, buen clima, especies domesticables", "Correcto!"], ["C", "Allí se descubrió el fuego", "Incorrecto."], ["D", "Sin depredadores", "Incorrecto."]], "correct": "B", "explanation": "Tenía suelos aluviales, clima mediterráneo y especies como trigo silvestre."}, {"bloom": "Remember", "icfes": "Pensamiento Social", "stem": "¿Primeras aldeas neolíticas?", "options": [["A", "Roma y Atenas", "Incorrecto."], ["B", "Jericó y Çatalhöyük", "Correcto!"], ["C", "París y Londres", "Incorrecto."], ["D", "Bogotá y Cartagena", "Incorrecto."]], "correct": "B", "explanation": "Jericó (~9000 a.C.) y Çatalhöyük (~7500 a.C.) son de los asentamientos más antiguos."}, {"bloom": "Apply", "icfes": "Pensamiento Social", "stem": "División del trabajo neolítico: ¿qué significa?", "options": [["A", "Todos igual", "Incorrecto."], ["B", "Especialización: agricultores, alfareros, tejedores", "Correcto!"], ["C", "Solo hombres", "Incorrecto."], ["D", "No trabajaban", "Incorrecto."]], "correct": "B", "explanation": "Los excedentes permitieron que algunos se especializaran en otras actividades."}, {"bloom": "Evaluate", "icfes": "Pensamiento Social", "stem": "¿Ventaja y desventaja del Neolítico?", "options": [["A", "Más tiempo libre", "Incorrecto."], ["B", "Estabilidad y población; nuevas enfermedades y desigualdad", "Correcto!"], ["C", "Más igualdad", "Incorrecto."], ["D", "Sin cambios", "Incorrecto."]], "correct": "B", "explanation": "Trajo estabilidad pero también enfermedades (por animales) y jerarquías sociales."}, {"bloom": "Understand", "icfes": "Pensamiento Social", "stem": "¿Importancia de la piedra pulida?", "options": [["A", "Decorativa", "Incorrecto."], ["B", "Herramientas más precisas para agricultura", "Correcto!"], ["C", "Joyas", "Incorrecto."], ["D", "Menos resistente", "Incorrecto."]], "correct": "B", "explanation": "Producía bordes uniformes y herramientas más resistentes para labrar la tierra."}]