uilibrios."}, {"bloom": "Remember", "icfes": "Pensamiento Social", "stem": "El voto en Colombia es:", "options": [["A", "Opcional", "Incorrecto."], ["B", "Un derecho y un deber ciudadano", "Correcto!"], ["C", "Solo para ricos", "Incorrecto."], ["D", "Solo para hombres", "Incorrecto."]], "correct": "B", "explanation": "Sufragio universal."}, {"bloom": "Apply", "icfes": "Pensamiento Social", "stem": "Para ser presidente de Colombia se requiere:", "options": [["A", "Ser colombiano de nacimiento, mayor de 30 años", "Correcto!"], ["B", "Ser mayor de 18", "Incorrecto."], ["C", "Tener dinero", "Incorrecto."], ["D", "Saber inglés", "Incorrecto."]], "correct": "A", "explanation": "Requisitos constitucionales."}, {"bloom": "Evaluate", "icfes": "Pensamiento Social", "stem": "Participación ciudadana en democracia:", "options": [["A", "Solo votar", "Incorrecto."], ["B", "Votar, controlar, proponer, protestar pacíficamente", "Correcto!"], ["C", "No es necesaria", "Incorrecto."], ["D", "Solo políticos", "Incorrecto."]], "correct": "B", "explanation": "Democracia participativa."}, {"bloom": "Understand", "icfes": "Pensamiento Social", "stem": "Qué es un partido político?", "options": [["A", "Empresa", "Incorrecto."], ["B", "Organización que agrupa personas con ideas comunes para acceder al poder", "Correcto!"], ["C", "Club deportivo", "Incorrecto."], ["D", "ONG", "Incorrecto."]], "correct": "B", "explanation": "Mediación política."}]