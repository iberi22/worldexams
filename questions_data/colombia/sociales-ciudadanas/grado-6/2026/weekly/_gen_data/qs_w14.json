[{"bloom": "Remember", "icfes": "Pensamiento Social", "stem": "Qué era la Ley de las XII Tablas?", "options": [["A", "Poema épico", "Incorrecto."], ["B", "Primer código legal romano escrito (~450 a.C.)", "Correcto!"], ["C", "Tratado de guerra", "Incorrecto."], ["D", "Libro de historia", "Incorrecto."]], "correct": "B", "explanation": "Primera compilación escrita del derecho romano."}, {"bloom": "Remember", "icfes": "Pensamiento Social", "stem": "Qué idioma hablaban los romanos?", "options": [["A", "Griego", "Incorrecto."], ["B", "Latín", "Correcto!"], ["C", "Español", "Incorrecto."], ["D", "Italiano", "Incorrecto."]], "correct": "B", "explanation": "El latín. De él derivan lenguas romances."}, {"bloom": "Understand", "icfes": "Pensamiento Social", "stem": "Innovación arquitectónica romana:", "options": [["A", "Columnas griegas", "Incorrecto."], ["B", "Arco, bóveda y hormigón", "Correcto!"], ["C", "Madera", "Incorrecto."], ["D", "Piedra tallada", "Incorrecto."]], "correct": "B", "explanation": "Usaron arcos, bóvedas y hormigón para edificios monumentales."}, {"bloom": "Apply", "icfes": "Pensamiento Social", "stem": "Cómo funcionaban los acueductos romanos?", "options": [["A", "Bombas eléctricas", "Incorrecto."], ["B", "Gravedad con pendiente suave", "Correcto!"], ["C", "Tuberías plástico", "Incorrecto."], ["D", "Caballos", "Incorrecto."]], "correct": "B", "explanation": "Usaban gravedad con pendiente constante."}, {"bloom": "Understand", "icfes": "Pensamiento Social", "stem": "Qué eran las Termas Romanas?", "options": [["A", "Templos", "Incorrecto."], ["B", "Baños públicos con calefacción y gimnasio", "Correcto!"], ["C", "Mercados", "Incorrecto."], ["D", "Fortalezas", "Incorrecto."]], "correct": "B", "explanation": "Complejos con hipocausto (calefacción subterránea)."}, {"bloom": "Analyze", "icfes": "Pensamiento Social", "stem": "Por qué el derecho romano sigue siendo importante?", "options": [["A", "Solo en Italia", "Incorrecto."], ["B", "Base del sistema jurídico d