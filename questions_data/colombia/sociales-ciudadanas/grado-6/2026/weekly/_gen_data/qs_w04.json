[{"bloom": "Remember", "icfes": "Pensamiento Social", "stem": "¿Entre qué ríos se desarrolló Mesopotamia?", "options": [["A", "Nilo y Jordán", "Incorrecto."], ["B", "Tigris y Éufrates", "Correcto!"], ["C", "Danubio y Rin", "Incorrecto."], ["D", "Indo y Ganges", "Incorrecto."]], "correct": "B", "explanation": "Mesopotamia ('tierra entre ríos') se desarrolló entre el Tigris y el Éufrates."}, {"bloom": "Remember", "icfes": "Pensamiento Social", "stem": "¿Qué inventaron los sumerios ~3500 a.C.?", "options": [["A", "Alfabeto", "Incorrecto."], ["B", "Escritura cuneiforme", "Correcto!"], ["C", "Jeroglíficos", "Incorrecto."], ["D", "Alfabeto latino", "Incorrecto."]], "correct": "B", "explanation": "Los sumerios inventaron la escritura cuneiforme sobre tablillas de arcilla."}, {"bloom": "Understand", "icfes": "Pensamiento Social", "stem": "¿Por qué es importante el Código de Hammurabi?", "options": [["A", "Primera obra literaria", "Incorrecto."], ["B", "Primer código de leyes escrito (282 leyes)", "Correcto!"], ["C", "Construcción de zigurats", "Incorrecto."], ["D", "Creación del mundo", "Incorrecto."]], "correct": "B", "explanation": "El Código de Hammurabi (1754 a.C.) regulaba la sociedad babilónica."}, {"bloom": "Apply", "icfes": "Pensamiento Social", "stem": "¿Para qué servían los zigurats?", "options": [["A", "Tumbas", "Incorrecto."], ["B", "Templos religiosos escalonados", "Correcto!"], ["C", "Mercados", "Incorrecto."], ["D", "Fortalezas", "Incorrecto."]], "correct": "B", "explanation": "Eran torres escalonadas que funcionaban como templos para los dioses protectores."}, {"bloom": "Understand", "icfes": "Pensamiento Social", "stem": "Sociedad mesopotámica:", "options": [["A", "Igualitaria", "Incorrecto."], ["B", "Jerárquica: rey, sacerdotes, escribas, comerciantes, campesinos, esclavos", "Correcto!"], ["C", "Solo libres y esclavos", "Incorrecto."], ["D", "Democrática", "Incorrecto."]], "correct": "B", "explanation": "Pirámide social con el rey en la cima y esclavos en la base."}, {"bloom": "Analyze", "icfes": "Pensamiento Social", "stem": "¿Por qué Mesopotamia es 'cuna de la civilización'?", "options": [["A", "Primer humano", "Incorrecto."], ["B", "Primeras ciudades, escritura, Estado, leyes", "Correcto!"], ["C", "Primeras pirámides", "Incorrecto."], ["D", "Descubrimiento del fuego", "Incorrecto."]], "correct": "B", "explanation": "Allí surgieron ciudades, escritura, Estado, leyes, rueda y agricultura de regadío."}, {"bloom": "Remember", "icfes": "Pensamiento Social", "stem": "Dios principal de Babilonia:", "options": [["A", "Zeus", "Incorrecto."], ["B", "Marduk", "Correcto!"], ["C", "Ra", "Incorrecto."], ["D", "Quetzalcóatl", "Incorrecto."]], "correct": "B", "explanation": "Marduk era el dios patrono de Babilonia."}, {"bloom": "Apply", "icfes": "Pensamiento Social", "stem": "¿Propósito de los canales de riego?", "options": [["A", "Navegar", "Incorrecto."], ["B", "Llevar agua a cultivos", "Correcto!"], ["C", "Agua potable", "Incorrecto."], ["D", "Defensa", "Incorrecto."]], "correct": "B", "explanation": "Controlaban inundaciones y llevaban agua del Tigris y Éufrates a los cultivos."}, {"bloom": "Evaluate", "icfes": "Pensamiento Social", "stem": "Comparando escritura cuneiforme con comunicación digital:", "options": [["A", "Cuneiforme más rápida", "Incorrecto."], ["B", "Física y local vs. virtual e instantánea global", "Correcto!"], ["C", "Mismo alfabeto", "Incorrecto."], ["D", "No tenían escritura", "Incorrecto."]], "correct": "B", "explanation": "La cuneiforme requería tablillas físicas; hoy la información viaja en segundos."}, {"bloom": "Understand", "icfes": "Pensamiento Social", "stem": "¿Qué compartían acadios, babilonios y asirios?", "options": [["A", "Imperios marítimos", "Incorrecto."], ["B", "Unificaron territorios en Mesopotamia", "Correcto!"], ["C", "Misma capital", "Incorrecto."], ["D", "Derrotados por Egipto", "Incorrecto."]], "correct": "B", "explanation": "Controlaron la región mesopotámica en distintos períodos."}