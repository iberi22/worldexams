[{"bloom": "Remember", "icfes": "Pensamiento Social", "stem": "¿Por qué son famosos los fenicios?", "options": [["A", "Pirámides", "Incorrecto."], ["B", "Comercio marítimo y creación del alfabeto", "Correcto!"], ["C", "Imperio militar", "Incorrecto."], ["D", "Democracia", "Incorrecto."]], "correct": "B", "explanation": "Grandes navegantes y comerciantes. Crearon el primer alfabeto fonético de 22 signos."}, {"bloom": "Remember", "icfes": "Pensamiento Social", "stem": "Aporte cultural fenicio:", "options": [["A", "Cuneiforme", "Incorrecto."], ["B", "Alfabeto fonético de 22 signos", "Correcto!"], ["C", "Jeroglíficos", "Incorrecto."], ["D", "Rueda", "Incorrecto."]], "correct": "B", "explanation": "Base de los alfabetos griego, latino y el nuestro."}, {"bloom": "Understand", "icfes": "Pensamiento Social", "stem": "Creencia distintiva de los hebreos:", "options": [["A", "Politeísmo", "Incorrecto."], ["B", "Monoteísmo (Yahvé)", "Correcto!"], ["C", "Ateísmo", "Incorrecto."], ["D", "Sol", "Incorrecto."]], "correct": "B", "explanation": "Fueron pioneros en el monoteísmo. Base del judaísmo, cristianismo e islam."}, {"bloom": "Apply", "icfes": "Pensamiento Social", "stem": "El Éxodo describe:", "options": [["A", "Construcción del templo", "Incorrecto."], ["B", "Salida de hebreos de Egipto con Moisés", "Correcto!"], ["C", "Conquista de Jericó", "Incorrecto."], ["D", "Creación de Israel", "Incorrecto."]], "correct": "B", "explanation": "Liberación de la esclavitud en Egipto hacia la Tierra Prometida."}, {"bloom": "Understand", "icfes": "Pensamiento Social", "stem": "¿Cómo administraban los persas su imperio?", "options": [["A", "Guerras", "Incorrecto."], ["B", "Satrapías con gobernadores y respeto cultural", "Correcto!"], ["C", "Democracia", "Incorrecto."], ["D", "Esclavitud", "Incorrecto."]], "correct": "B", "explanation": "Dividido en provincias (satrapías). Ciro respetaba costumbres locales."}, {"bloom": "Analyze", "icfes": "Pensamiento Social", "stem": "Éxito del Imperio Persa:", "options": [["A", "Ejército poderoso", "Incorrecto."], ["B", "Tolerancia cultural y eficiente administración", "Correcto!"], ["C", "Eliminaban pueblos", "Incorrecto."], ["D", "Imponían religión", "Incorrecto."]], "correct": "B", "explanation": "Respetaban culturas locales y construyeron caminos para administrar."}, {"bloom": "Remember", "icfes": "Pensamiento Social", "stem": "Rey persa que conquistó Babilonia:", "options": [["A", "Darío I", "Incorrecto."], ["B", "Ciro el Grande", "Correcto!"], ["C", "Jerjes", "Incorrecto."], ["D", "Artajerjes", "Incorrecto."]], "correct": "B", "explanation": "Ciro conquistó Babilonia en 539 a.C. y liberó a los hebreos."}, {"bloom": "Apply", "icfes": "Pensamiento Social", "stem": "¿Qué heredamos del alfabeto fenicio?", "options": [["A", "Números", "Incorrecto."], ["B", "Nuestras letras (vía griegos y romanos)", "Correcto!"], ["C", "Cuneiforme", "Incorrecto."], ["D", "Jeroglíficos", "Incorrecto."]], "correct": "B", "explanation": "El alfabeto latino deriva del griego, que adaptó el fenicio."}, {"bloom": "Evaluate", "icfes": "Pensamiento Social", "stem": "Persas vs asirios: diferencia principal:", "options": [["A", "Persas más violentos", "Incorrecto."], ["B", "Persas respetaban culturas; asirios deportaban pueblos", "Correcto!"], ["C", "Iguales", "Incorrecto."], ["D", "Persas sin religión", "Incorrecto."]], "correct": "B", "explanation": "Asirios deportaban pueblos; persas solo exigían tributo."}, {"bloom": "Understand", "icfes": "Pensamiento Social", "stem": "Religión fundada por Zoroastro:", "options": [["A", "Hinduismo", "Incorrecto."], ["B", "Zoroastrismo (bien vs mal)", "Correcto!"], ["C", "Budismo", "Incorrecto."], ["D", "Judaísmo", "Incorrecto."]], "correct": "B", "explanation": "Enseñaba la lucha entre Ahura Mazda (bien) y Angra Mainyu (mal)."}]