# ============================================
# WorldExams .gitignore (SWAL node, Linux base)
# ============================================

# --- Python generated files (legacy) ---
__pycache__/
*.pyc
*.pyo
_gen_*/
_generated/
temp/
temp_*
*.log
*.txt

# --- Windows scripts (migrated to Linux) ---
*.ps1
*.bat
*.cmd

# --- Build output ---
saberparatodos/public/api/
saberparatodos/.astro/
saberparatodos/.wrangler/
saberparatodos/dist/
apps/*/dist/
apps/*/.astro/
apps/*/.wrangler/
.astro/
dist/


# --- Node ---
node_modules/

# --- pnpm lockfiles in root (sub-projects keep theirs) ---
pnpm-lock.yaml
pnpm-workspace.yaml

# --- Workspace node_modules ---
apps/*/node_modules/

# --- OS files ---
.DS_Store
Thumbs.db

# --- Editor/IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- Environment ---
.env.local
.env.production
.env*.local

# --- Test results ---
test-results/
coverage/

# --- Agent artifacts ---
.worldexams/
.hermes/
scratch/

# --- Security Hardening: Sensitive Files & Secrets ---
# Private Keys and Certificates
*.key
*.pem
*.pub
*.crt

# Environment variables & local configuration secrets
.env
.env.local
.env.development
.env.test
.env.production
.env*.local
*_secret
*secret*
*password*
*api_key*
*token*
**/secrets/
credentials.json

# Exceptions to allow security scripts and static txt files
!scripts/pre-commit-secret-scan.sh
!scripts/validate-secrets.sh
!saberparatodos/public/robots.txt
!robots.txt
!saberparatodos/src/components/cuentos/arte/tokens.css

# --- Backend Infrastructure, Standalone Rust Services & Institutional Logic (Managed in dedicated apps) ---
# Allow supabase/migrations/ to be tracked
!supabase/migrations/
services/
**/services/
target/
**/target/
Cargo.lock
**/Cargo.lock
*institutional*
*instituciones*
# Allowlist: GitCore issue plans and Svelte components for NeuroGym institutional features must be tracked
!.gitcore/issues/**/issue-*institutional*.md
!saberparatodos/src/components/neurogym/*Institutional*.svelte

# Local cache artefacts (regenerated by skill-registry-refresh.sh)
.atl/.skill-registry.cache.json
.skill-registry.cache.json
.gitcore/.skill-registry.cache.json



# >>> GITCORE PUBLIC REPO HARDENING >>>
# ─────────────────────────────────────────────────────────────────────────────
# GitCore — fragmento para repos PÚBLICOS
# Añadir al .gitignore del repo público. Bloquea el estado interno del
# laboratorio que el protocolo GitCore crea en TODOS los repos.
#
# IMPORTANTE: ignorar un archivo ya trackeado NO lo despublica.
# Para archivos ya commiteados hay que ejecutar:
#   git rm -r --cached <ruta>
#   git commit -m "chore: stop publishing internal lab state"
# y, si ya se publicó, purgar el historial.
# ─────────────────────────────────────────────────────────────────────────────

# Planificación y estado de sesión (interno)
.gitcore/planning/
.gitcore/chronicles/
.gitcore/waves/
.gitcore/sdd/
.gitcore/issues/
.gitcore/features.details/
.gitcore/CONTEXT_LOG.md
.gitcore/STATE.md
.gitcore/TODO.md
.gitcore/features-status.md
.gitcore/implementation-score.json
.gitcore/AGENT_INDEX.md
.gitcore/ARCHITECTURE.md
.gitcore/SRC.md
.gitcore/skill-registry.json
.gitcore/.skill-registry.cache.json
.gitcore/_tmp_*

# Estado del harness y agentes
.hermes/
.atl/
.gestalt/
.jules/
.xavier/
.xavier-backups/
.skill-registry.cache.json

# Planificación suelta en la raíz o en docs/
PLANNING.md
TASK.md
tasks.json

# Configuración local con rutas absolutas
.mcp.json

# Runtime y artefactos
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
*.profraw
# <<< GITCORE PUBLIC REPO HARDENING <<<

# Internal lab state (GitCore hardening)
docs/plans/
SESSION_HANDOFF*.md

# Nested harness state
**/.jules/
**/.hermes/
**/.atl/
**/.gestalt/
**/.worktrees/
