# ============================================
# WorldExams .gitignore (SWAL node, Linux base)
# ============================================

# --- Python generated files (legacy) ---
__pycache__/
*.pyc
*.pyo
_gen_*/
_generated/
temp/
temp_*
*.log
*.txt

# --- Windows scripts (migrated to Linux) ---
*.ps1
*.bat
*.cmd

# --- Build output ---
saberparatodos/public/api/
saberparatodos/.astro/
saberparatodos/.wrangler/
saberparatodos/dist/
apps/*/dist/
apps/*/.astro/
.astro/
dist/


# --- Node ---
node_modules/

# --- pnpm lockfiles in root (sub-projects keep theirs) ---
pnpm-lock.yaml
pnpm-workspace.yaml

# --- Workspace node_modules ---
apps/*/node_modules/

# --- OS files ---
.DS_Store
Thumbs.db

# --- Editor/IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- Environment ---
.env.local
.env.production
.env*.local

# --- Test results ---
test-results/
coverage/

# --- Agent artifacts ---
.worldexams/
.hermes/
scratch/

# --- Security Hardening: Sensitive Files & Secrets ---
# Private Keys and Certificates
*.key
*.pem
*.pub
*.crt

# Environment variables & local configuration secrets
.env
.env.local
.env.development
.env.test
.env.production
.env*.local
*_secret
*secret*
*password*
*api_key*
*token*
**/secrets/
credentials.json

# Exceptions to allow security scripts and static txt files
!scripts/pre-commit-secret-scan.sh
!scripts/validate-secrets.sh
!saberparatodos/public/robots.txt
!robots.txt

# --- Backend Infrastructure & Standalone Services (Managed in dedicated apps) ---
supabase/
saberparatodos/supabase/
services/

