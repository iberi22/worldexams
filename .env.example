# Variables de Entorno — WorldExamns / SaberParaTodos
# Copiar a .env y completar con valores reales.
# NUNCA commitees .env con valores reales.
#
# Validado automáticamente por scripts/validate-secrets.sh antes de commitear.

# =============================================================================
# API KEYS — Servicios de IA
# =============================================================================

# Gemini API (generación de preguntas)
GEMINI_API_KEY=your_gemini_api_key_here

# Claude API (code review, generación alternativa)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API (fallback)
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# SUPABASE — Base de datos y autenticación
# =============================================================================

# URL del proyecto Supabase
SUPABASE_URL=https://tzmrgvtptdtsjcugwqyq.supabase.co

# Anon key (cliente público, segura para frontend)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role key (SOLO para servidor/Edge Functions — NUNCA en frontend)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# JWT Secret para tokens personalizados
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# =============================================================================
# CLOUDFLARE — Workers y Pages
# =============================================================================

# Cloudflare API Token (para wrangler deploy)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Cloudflare Account ID
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# =============================================================================
# TELEGRAM — Bot de notificaciones
# =============================================================================

# Token del bot de Telegram (de @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Chat ID donde el bot envía mensajes
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# =============================================================================
# DISCORD — Notificaciones (opcional)
# =============================================================================

# Token del bot de Discord
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Webhook URL para integración
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url

# =============================================================================
# TWITTER / X — Distribución social (opcional)
# =============================================================================

TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# =============================================================================
# GITHUB — Integración y automatización
# =============================================================================

# Personal Access Token con permisos de repo
GITHUB_TOKEN=your_github_personal_access_token

# =============================================================================
# CORTEX — Memoria de agente (local)
# =============================================================================

# URL del servicio Cortex
CORTEX_URL=http://localhost:8003

# =============================================================================
# APLICACIÓN — Configuración general
# =============================================================================

# Entorno: development | staging | production
NODE_ENV=development

# Puerto para desarrollo local
PORT=3000

# URL base de la aplicación
PUBLIC_URL=http://localhost:3000

# =============================================================================
# SABERPARATODOS — Configuración del producto
# =============================================================================

# Habilitar modo mantenimiento
SABERPARATODOS_MAINTENANCE_MODE=false

# API Key para webhooks internos
SABERPARATODOS_WEBHOOK_SECRET=your_webhook_secret_here

# =============================================================================
# ESTRIP — Pagos (futuro)
# =============================================================================

STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
