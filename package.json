{
  "name": "worldexams",
  "private": true,
  "type": "module",
  "version": "0.15.1",
  "description": "WorldExams private prelaunch monorepo",
  "workspaces": [
    "apps/landing-worldexams",
    "saberparatodos",
    "apps/worldexams-api",
    "tests"
  ],
  "scripts": {
    "validate": "node scripts/validate-bundles-v52.mjs",
    "dev": "npm run dev:landing-worldexams",
    "dev:landing-worldexams": "npm run dev -w @worldexams/landing-worldexams",
    "dev:saberparatodos": "npm run dev -w saberparatodos",
    "dev:worldexams-api": "npm run dev -w @worldexams/worldexams-api",
    "start": "npm run dev:landing-worldexams",
    "build": "npm run build:landing-worldexams",
    "build:landing-worldexams": "npm run build -w @worldexams/landing-worldexams",
    "build:saberparatodos": "npm run build -w saberparatodos",
    "build:worldexams-api": "npm run build -w @worldexams/worldexams-api",
    "build:workspaces": "npm run build:landing-worldexams && npm run build:saberparatodos && npm run build:worldexams-api",
    "generate-api": "powershell -File scripts/generate-questions-api.ps1",
    "audit:supabase:functions": "powershell -File scripts/audit-supabase-functions.ps1",
    "preview": "npm run preview -w @worldexams/landing-worldexams",
    "test:e2e": "npm run test -w worldexams-e2e-tests",
    "astro": "npm run astro -w @worldexams/landing-worldexams",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.0.2",
    "rollup": "^4.59.0",
    "svelte": "^5.55.7",
    "typescript": "^5.9.3",
    "undici": "^7.25.0"
  },
  "overrides": {
    "rollup": "^4.59.0",
    "protobufjs": "^7.5.5",
    "jspdf": "^4.2.1",
    "vite": "^7.3.2",
    "undici": "^7.25.0",
    "lodash": "^4.18.1",
    "defu": "^6.1.7",
    "picomatch": "^4.0.4",
    "brace-expansion": "^5.0.5",
    "yaml": "^2.8.3",
    "dompurify": "^3.4.0",
    "hono": "^4.12.14",
    "miniflare": {
      "undici": "^7.25.0"
    },
    "yaml-language-server": {
      "yaml": "^2.8.3"
    },
    "smol-toml": "^1.6.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  }
}
